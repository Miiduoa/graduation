diff --git a/apps/api/src/accounts/platform-persona-mapping.test.ts b/apps/api/src/accounts/platform-persona-mapping.test.ts
new file mode 100644
index 0000000..c8f2e35
--- /dev/null
+++ b/apps/api/src/accounts/platform-persona-mapping.test.ts
@@ -0,0 +1,96 @@
+import { createHash, randomUUID } from "node:crypto";
+import { afterEach, beforeEach, describe, expect, it } from "vitest";
+import { createDatabase, type CampusDatabase } from "../database";
+import { PlatformAccountService, type PlatformActor } from "./platform-account-service";
+
+describe("persisted public persona identity", () => {
+  let db: CampusDatabase;
+  let service: PlatformAccountService;
+  let actor: PlatformActor;
+  let other: PlatformActor;
+  const tenantId = "persona-school";
+  const secondTenantId = "other-persona-school";
+  const verifier = { verify: async () => { throw new Error("unused"); } };
+
+  async function account(): Promise<PlatformActor> {
+    const platformAccountId = `pa_${randomUUID()}`;
+    const credentialId = `pac_${randomUUID()}`;
+    await db.query(`INSERT INTO platform_accounts (id,display_name) VALUES ($1,'一般帳號')`, [platformAccountId]);
+    await db.query(`INSERT INTO platform_account_credentials
+      (id,platform_account_id,method,provider_issuer,provider_subject,verified_at,last_authenticated_at)
+      VALUES ($1,$2,'google','https://accounts.google.com',$3,now(),now())`, [credentialId, platformAccountId, randomUUID()]);
+    await db.query(`INSERT INTO platform_operator_assignments (platform_account_id,role_key,state)
+      VALUES ($1,'platform-operator','active')`, [platformAccountId]);
+    return { platformAccountId, credentialId, expiresAt: Date.now() + 3_600_000 };
+  }
+
+  async function mapping(owner: PlatformActor, school: string, person: string, status = "active") {
+    await db.query(`INSERT INTO people
+      (tenant_id,id,student_number,display_name,program,curriculum_version,study_year,campus,credential_status)
+      VALUES ($1,$2,$2,'既有一般使用者','一般使用者','platform',1,'公開社群',$3)`, [school, person, status]);
+    await db.query(`INSERT INTO platform_tenant_personas (platform_account_id,tenant_id,person_id)
+      VALUES ($1,$2,$3)`, [owner.platformAccountId, school, person]);
+  }
+
+  const resolve = (owner = actor, school = tenantId, instance = service) =>
+    instance.resolvePublicRealmActor(owner, school, { forCommunityCreation: true });
+
+  beforeEach(async () => {
+    db = await createDatabase({ seedDemo: false, attendanceCodeSecret: "persona-test-secret-over-thirty-two-characters" });
+    for (const school of [tenantId, secondTenantId]) {
+      await db.query(`INSERT INTO tenants (id,display_name,state,directory_source) VALUES ($1,'公開社群校','open','manual')`, [school]);
+    }
+    service = new PlatformAccountService(db, verifier);
+    actor = await account();
+    other = await account();
+  }, 60_000);
+
+  afterEach(async () => { await db?.close(); });
+
+  it("reuses older persona IDs without borrowing another account or tenant mapping or granting campus roles", async () => {
+    await mapping(actor, tenantId, "older-public-person");
+    await mapping(actor, secondTenantId, "other-school-person");
+    await mapping(other, tenantId, "other-account-person");
+    const resolved = await resolve();
+    expect(resolved).toEqual({ tenantId, personId: "older-public-person", roles: ["platform-user"],
+      sessionKind: "platform-account", credentialId: actor.credentialId });
+    expect((await resolve(actor, secondTenantId)).personId).toBe("other-school-person");
+    expect((await resolve(other)).personId).toBe("other-account-person");
+    expect((await db.query(`SELECT id FROM people WHERE tenant_id IN ($1,$2)`, [tenantId, secondTenantId])).rows).toHaveLength(3);
+    expect((await db.query(`SELECT id FROM identity_subjects WHERE tenant_id IN ($1,$2)`, [tenantId, secondTenantId])).rows).toEqual([]);
+    expect((await db.query(`SELECT person_id FROM platform_role_admin_assignments WHERE tenant_id IN ($1,$2)`, [tenantId, secondTenantId])).rows).toEqual([]);
+  });
+
+  it("returns one persisted mapping to concurrent first-time callers from separate services", async () => {
+    const results = await Promise.all([
+      resolve(), resolve(actor, tenantId, new PlatformAccountService(db, verifier)), resolve(),
+    ]);
+    expect(new Set(results.map(result => result.personId)).size).toBe(1);
+    const stored = (await db.query<{ person_id: string }>(`SELECT person_id FROM platform_tenant_personas
+      WHERE platform_account_id=$1 AND tenant_id=$2`, [actor.platformAccountId, tenantId])).rows;
+    expect(stored).toEqual([{ person_id: results[0]!.personId }]);
+    expect((await db.query(`SELECT id FROM people WHERE tenant_id=$1`, [tenantId])).rows).toHaveLength(1);
+    expect(results.every(result => result.roles.length === 1 && result.roles[0] === "platform-user")).toBe(true);
+  });
+
+  it("does not reactivate a suspended existing persona or create a replacement", async () => {
+    await mapping(actor, tenantId, "suspended-public-person", "suspended");
+    await expect(resolve()).rejects.toMatchObject({ statusCode: 404 });
+    expect((await db.query(`SELECT id,credential_status FROM people WHERE tenant_id=$1`, [tenantId])).rows)
+      .toEqual([{ id: "suspended-public-person", credential_status: "suspended" }]);
+    expect((await db.query(`SELECT person_id FROM platform_tenant_personas WHERE platform_account_id=$1 AND tenant_id=$2`,
+      [actor.platformAccountId, tenantId])).rows).toEqual([{ person_id: "suspended-public-person" }]);
+  });
+
+  it("does not adopt or rename an occupied generated ID belonging to another account", async () => {
+    const generatedId = `platform-user-${createHash("sha256").update(`${actor.platformAccountId}\u0000${tenantId}`).digest("hex").slice(0, 32)}`;
+    await mapping(other, tenantId, generatedId);
+    await expect(resolve()).rejects.toMatchObject({ statusCode: 404 });
+    expect((await db.query(`SELECT display_name FROM people WHERE tenant_id=$1 AND id=$2`, [tenantId, generatedId])).rows)
+      .toEqual([{ display_name: "既有一般使用者" }]);
+    expect((await db.query(`SELECT platform_account_id FROM platform_tenant_personas WHERE tenant_id=$1 AND person_id=$2`,
+      [tenantId, generatedId])).rows).toEqual([{ platform_account_id: other.platformAccountId }]);
+    expect((await db.query(`SELECT person_id FROM platform_tenant_personas WHERE platform_account_id=$1 AND tenant_id=$2`,
+      [actor.platformAccountId, tenantId])).rows).toEqual([]);
+  });
+});
