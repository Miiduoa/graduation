# ============================================
# Firebase Functions Configuration
# ============================================

# Firebase project configuration (auto-configured in most cases)
GCLOUD_PROJECT=your-project-id
FIREBASE_CONFIG={"projectId":"your-project-id"}

# ============================================
# Push Notifications
# ============================================
# FCM Server Key (for legacy HTTP v1 API)
FCM_SERVER_KEY=your-fcm-server-key

# ============================================
# External APIs
# ============================================
# Backend-managed AI agent. Keep all model keys server-side; never expose them via EXPO_PUBLIC_*.
# Free-first default for production: Groq free tier, then Gemini free tier.
ASSISTANT_MODEL_PROVIDERS=groq,gemini
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3-32b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
ASSISTANT_MODEL_MAX_TOKENS=900
ASSISTANT_MODEL_TEMPERATURE=0.4

# ============================================
# SSO Configuration
# ============================================
# AES-256 key for encrypting SSO secret config (32-byte raw key, base64 or hex)
SSO_CONFIG_ENCRYPTION_KEY=

# Comma-separated trusted web origins for SSO/admin HTTP endpoints
ALLOWED_WEB_ORIGINS=https://your-app.web.app,https://your-app.firebaseapp.com

# Preview-only shared test accounts. Production ignores these accounts.
UNIVERSAL_DEV_ACCOUNTS_ENABLED=false
UNIVERSAL_DEV_ACCOUNT_PASSWORD=
UNIVERSAL_DEV_ALLOWED_SCHOOLS=pu

# Local development only. Allows signInPuStudentId skipFirebase mock responses.
ALLOW_LOCAL_MOCK_AUTH=false

# ============================================
# Payment Webhooks
# ============================================
# Stripe Webhook Secret
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

# Line Pay webhook / channel secrets
LINE_PAY_CHANNEL_ID=
LINE_PAY_CHANNEL_SECRET=

# ============================================
# Email Service (Optional)
# ============================================
# SendGrid API Key for email notifications
SENDGRID_API_KEY=SG.your-sendgrid-api-key
SENDGRID_FROM_EMAIL=noreply@your-domain.com
