+      operationTtlMs: policy.operationTtlMs ?? 30_000,
+    });
+  }
+
+  private actorInput(value: PlatformTaskActor): PlatformTaskActor {
+    const actor = exactRecord(value, [
+      'platformAccountId',
+      'credentialId',
+      'expiresAt',
+      'sessionHash',
