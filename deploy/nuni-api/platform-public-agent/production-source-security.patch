+      const updated = (
+        await tx.query<{ id: string }>(
+          `UPDATE platform_public_agent_operations SET status='unknown',updated_at=clock_timestamp()
+        WHERE id=$1 AND platform_account_id=$2 AND session_hash=$3 AND payload_hash=$4
