# ============================================
# Firebase Configuration
# ============================================
# Get these values from Firebase Console > Project Settings > General
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:abcdef123456
NEXT_PUBLIC_CLOUD_FUNCTION_REGION=asia-east1
# 未設定時，網頁端不會呼叫 Cloud Functions（正式 Spark 專案沒有 asia-east1 HTTPS 端點）。
# 部署 nuni-functions 到 Fly 後再設定，例如：
# NEXT_PUBLIC_FUNCTIONS_BASE_URL=https://nuni-functions.fly.dev

# 請假站內送出／撤回／核閱。伺服器 runtime 讀這個開關，同時控制畫面與寫入。
# 未設定或 false 時，請假頁／核閱頁顯示「尚未開放」，API 回 503。
# LEAVE_WEB_API_ENABLED=true

# ============================================
# Server-side Firebase Admin (for API routes)
# ============================================
# Service account JSON (base64 encoded)
FIREBASE_SERVICE_ACCOUNT_BASE64=your-base64-encoded-service-account-json

# ============================================
# Feature Flags
# ============================================
# Default school ID for demo
NEXT_PUBLIC_DEFAULT_SCHOOL_ID=demo-school

# Enable PWA features
NEXT_PUBLIC_PWA_ENABLED=true

# Enable analytics
NEXT_PUBLIC_ANALYTICS_ENABLED=true

# ============================================
# TDX 公車即時到站與靜宜轉乘建議（伺服器端）
# ============================================
# 正式站要啟用即時到站與「去哪裡」轉乘，請設定這兩個既有變數。留空則只顯示直達／靜態名錄與 Google 地圖。
TDX_CLIENT_ID=
TDX_CLIENT_SECRET=
