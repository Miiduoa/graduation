# Server/operator only. This file does not enable login, payments or migration.
# Run: node scripts/verify-nuni-integration.mjs (from the repository root).
NUNI_API_ORIGIN=https://api.nuni.tw
NUNI_IDENTITY_BINDINGS_FILE=
NUNI_EXPECTED_FIREBASE_PROJECT_ID=
NUNI_EXPECTED_FIREBASE_UID=
NUNI_EXPECTED_SCHOOL_ID=
# Secret: inject a current Nuni "Bearer ..." or server-held "Session ..." value.
# Never put this in NEXT_PUBLIC_*/EXPO_PUBLIC_*, commit it, or pass it as a CLI argument.
NUNI_SESSION_AUTHORIZATION=
