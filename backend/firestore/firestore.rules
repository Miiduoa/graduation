rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null
        && (!exists(/databases/$(database)/documents/users/$(request.auth.uid))
          || (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('accountDeletionInProgress', false) != true
            && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('status', '') != 'deleted'));
    }

    function isSelf(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isSchoolMember(schoolId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/schools/$(schoolId)/members/$(request.auth.uid))
        && get(/databases/$(database)/documents/schools/$(schoolId)/members/$(request.auth.uid)).data.status == 'active';
    }

    function hasAnyServiceRole(schoolId, uid) {
      return exists(/databases/$(database)/documents/schools/$(schoolId)/serviceRoles/$(uid))
        && get(/databases/$(database)/documents/schools/$(schoolId)/serviceRoles/$(uid)).data.status == 'active'
        && (
          get(/databases/$(database)/documents/schools/$(schoolId)/serviceRoles/$(uid)).data.get('orders', false) == true
          || get(/databases/$(database)/documents/schools/$(schoolId)/serviceRoles/$(uid)).data.get('repairs', false) == true
          || get(/databases/$(database)/documents/schools/$(schoolId)/serviceRoles/$(uid)).data.get('packages', false) == true
          || get(/databases/$(database)/documents/schools/$(schoolId)/serviceRoles/$(uid)).data.get('printing', false) == true
          || get(/databases/$(database)/documents/schools/$(schoolId)/serviceRoles/$(uid)).data.get('health', false) == true
        );
    }

    function hasServiceRoleDomain(schoolId, uid, domain) {
      return exists(/databases/$(database)/documents/schools/$(schoolId)/serviceRoles/$(uid))
        && get(/databases/$(database)/documents/schools/$(schoolId)/serviceRoles/$(uid)).data.status == 'active'
        && get(/databases/$(database)/documents/schools/$(schoolId)/serviceRoles/$(uid)).data.get(domain, false) == true;
    }

    function isCafeteriaOperator(schoolId, cafeteriaId, uid) {
      return cafeteriaId is string
        && exists(/databases/$(database)/documents/schools/$(schoolId)/cafeterias/$(cafeteriaId)/operators/$(uid))
        && get(/databases/$(database)/documents/schools/$(schoolId)/cafeterias/$(cafeteriaId)/operators/$(uid)).data.status != 'inactive';
    }

    function hasRole(schoolId, role) {
      return isSchoolMember(schoolId)
        && get(/databases/$(database)/documents/schools/$(schoolId)/members/$(request.auth.uid)).data.role == role;
    }

    function hasEditorRole(schoolId) {
      return hasRole(schoolId, 'admin') || hasRole(schoolId, 'editor');
    }

    function requesterHasAnyServiceRole(schoolId) {
      return isSchoolMember(schoolId) && hasAnyServiceRole(schoolId, request.auth.uid);
    }

    function requesterHasServiceRoleDomain(schoolId, domain) {
      return isSchoolMember(schoolId) && hasServiceRoleDomain(schoolId, request.auth.uid, domain);
    }

    function requesterIsCafeteriaOperator(schoolId, cafeteriaId) {
      return isSignedIn() && isCafeteriaOperator(schoolId, cafeteriaId, request.auth.uid);
    }

    function isHttpsStorefrontUrl(value) {
      return value is string
        && value.size() > 0
        && value.size() <= 2048
        && value.matches('^[Hh][Tt][Tt][Pp][Ss]://[^\\s]+$')
        && !value.matches('^[Hh][Tt][Tt][Pp][Ss]://[^/]*@.*')
        && !value.matches('.*\\p{Cc}.*');
    }

    function isOptionalStorefrontUrl(value) {
      return value is string && (value == '' || isHttpsStorefrontUrl(value));
    }

    function cafeteriaStorefrontUrlsAllowed() {
      return (!('websiteUrl' in request.resource.data) || isOptionalStorefrontUrl(request.resource.data.websiteUrl))
        && (!('orderingUrl' in request.resource.data) || isOptionalStorefrontUrl(request.resource.data.orderingUrl));
    }

    function isActiveGroupMember(groupId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid))
        && get(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)).data.status == 'active'
        && isSchoolMember(get(/databases/$(database)/documents/groups/$(groupId)).data.schoolId);
    }

    function canManageGroup(groupId) {
      return isActiveGroupMember(groupId)
        && (
          get(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)).data.role == 'admin'
          || get(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)).data.role == 'owner'
          || get(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)).data.role == 'instructor'
          || get(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)).data.role == 'moderator'
        );
    }

    function isConversationMember(conversationId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/conversations/$(conversationId))
        && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.memberIds;
    }

    // 使用者自己個人資料上的名字；邀請和找人代號顯示的名字只能用這個，不能自己填
    function profileName(uid) {
      return exists(/databases/$(database)/documents/users/$(uid))
        ? get(/databases/$(database)/documents/users/$(uid)).data.get('displayName', '')
        : '';
    }

    function friendshipInvolves(authUid) {
      return resource.data.fromUid == authUid || resource.data.toUid == authUid;
    }

    function acceptedFriendsWith(otherUid, schoolId) {
      let forwardId = 'req_' + schoolId + '_' + request.auth.uid + '_' + otherUid;
      let reverseId = 'req_' + schoolId + '_' + otherUid + '_' + request.auth.uid;
      return isSignedIn()
        && schoolId is string
        && (
          (
            exists(/databases/$(database)/documents/friendships/$(forwardId))
            && get(/databases/$(database)/documents/friendships/$(forwardId)).data.status == 'accepted'
          )
          || (
            exists(/databases/$(database)/documents/friendships/$(reverseId))
            && get(/databases/$(database)/documents/friendships/$(reverseId)).data.status == 'accepted'
          )
        );
    }

    function isSchoolBoardModerator(schoolId, boardId) {
      return isSchoolMember(schoolId)
        && exists(/databases/$(database)/documents/schools/$(schoolId)/boards/$(boardId))
        && (
          (
            'mods' in get(/databases/$(database)/documents/schools/$(schoolId)/boards/$(boardId)).data
            && request.auth.uid in get(/databases/$(database)/documents/schools/$(schoolId)/boards/$(boardId)).data.mods
          )
          || hasRole(schoolId, 'admin')
          || hasRole(schoolId, 'editor')
        );
    }

    /* Campus anonymous: public doc must omit authorUid */
    function campusPostCreatesOk(schoolId) {
      let post = request.resource.data;
      return post.schoolId == schoolId
        && post.boardId is string
        && post.createdAt != null
        && post.title is string
        && (
          (post.anonymous == true && !('authorUid' in post) && post.aliasSnapshot is string)
          || (
            post.anonymous == false
            && post.authorUid == request.auth.uid
          )
        );
    }

    function campusPostLikesNumeric(d) {
      return (d.keys().hasAll(['likes']) && d.likes is int) ? d.likes : 0;
    }

    function campusPostLikedByLen(d) {
      return (d.keys().hasAll(['likedBy']) && d.likedBy is list) ? d.likedBy.size() : 0;
    }

    function campusPostViewerHasLiked(d) {
      return d.keys().hasAll(['likedBy'])
        && d.likedBy is list
        && request.auth.uid in d.likedBy;
    }

    function campusPostCommentCountNum(d) {
      return (d.keys().hasAll(['commentCount']) && d.commentCount is int) ? d.commentCount : 0;
    }

    /**
     * 一般成員僅可加減自己的 heart：likes／likedBy／updatedAt 三欄，且愛心數與陣列長度同步變動。
     */
    function campusPostLikeReactionOk() {
      let before = resource.data;
      let after = request.resource.data;
      // affectedKeys covers add/remove/change; changedKeys alone misses field insert/delete.
      let diff = after.diff(before).affectedKeys();
      return diff.hasOnly(['likes', 'likedBy', 'updatedAt'])
        && after.likedBy is list
        && campusPostLikesNumeric(after) >= 0
        && (
          (
            campusPostViewerHasLiked(after)
            && !campusPostViewerHasLiked(before)
            && campusPostLikesNumeric(after) == campusPostLikesNumeric(before) + 1
            && campusPostLikedByLen(after) == campusPostLikedByLen(before) + 1
          )
          || (
            !campusPostViewerHasLiked(after)
            && campusPostViewerHasLiked(before)
            && campusPostLikesNumeric(after) == campusPostLikesNumeric(before) - 1
            && campusPostLikedByLen(after) == campusPostLikedByLen(before) - 1
          )
        );
    }

    /**
     * 新增留言時遞增 commentCount（無法綁死與 replies 同一筆，僅限制單步 +1，降低濫刷成本）。
     */
    function campusPostCommentBumpOk() {
      let before = resource.data;
      let after = request.resource.data;
      let diff = after.diff(before).affectedKeys();
      return diff.hasOnly(['commentCount', 'updatedAt'])
        && campusPostCommentCountNum(after) == campusPostCommentCountNum(before) + 1;
    }

    function canReadGroupPost(postId) {
      return exists(/databases/$(database)/documents/groupPosts/$(postId))
        && isActiveGroupMember(get(/databases/$(database)/documents/groupPosts/$(postId)).data.groupId);
    }

    function canReadAssignment(assignmentId) {
      return exists(/databases/$(database)/documents/assignments/$(assignmentId))
        && isActiveGroupMember(get(/databases/$(database)/documents/assignments/$(assignmentId)).data.groupId);
    }

    function canManageAssignment(assignmentId) {
      return exists(/databases/$(database)/documents/assignments/$(assignmentId))
        && canManageGroup(get(/databases/$(database)/documents/assignments/$(assignmentId)).data.groupId);
    }

    function submissionOwnerId(data, submissionId) {
      return data.get('userId', data.get('uid', data.get('studentId', submissionId)));
    }

    function isSubmissionOwner(data, submissionId) {
      return isSignedIn() && request.auth.uid == submissionOwnerId(data, submissionId);
    }

    function acceptsStudentSubmission(groupId, assignmentId) {
      let assignment = get(/databases/$(database)/documents/groups/$(groupId)/assignments/$(assignmentId)).data;
      let due = assignment.get('dueAt', null);
      return assignment.get('published', true) != false
        && !(assignment.get('status', '') in ['draft', 'closed'])
        && (due == null || assignment.get('allowLateSubmission', false) == true
          || (due is timestamp && request.time <= due)
          || (due is string && request.time <= timestamp.value(due)));
    }

    function validStudentSubmission(groupId, assignmentId, submissionId) {
      let data = request.resource.data;
      return isActiveGroupMember(groupId)
        && submissionId == request.auth.uid
        && data.userId == request.auth.uid
        && data.groupId == groupId
        && data.assignmentId == assignmentId
        && data.status == 'submitted'
        && data.content is string && data.content.size() <= 20000
        && (data.content.size() > 0 || data.get('attachments', []).size() > 0 || data.get('answers', {}).size() > 0)
        && data.get('answers', {}) is map
        && data.get('answers', {}).size() <= 100
        && data.get('attachments', []) is list
        && data.get('attachments', []).size() <= 20
        && data.submittedAt == request.time
        && data.updatedAt == request.time
        && acceptsStudentSubmission(groupId, assignmentId);
    }

    function isAssignedReviewer(groupId, assignmentId, submissionId, data) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/groups/$(groupId)/assignments/$(assignmentId)/peerReviews/$(request.auth.uid))
        && get(/databases/$(database)/documents/groups/$(groupId)/assignments/$(assignmentId)/peerReviews/$(request.auth.uid)).data.submissionOwnerId
          == submissionOwnerId(data, submissionId);
    }

    function canReadSubmissionDoc(groupId, assignmentId, submissionId, data) {
      return canManageGroup(groupId)
        || isSubmissionOwner(data, submissionId)
        || isAssignedReviewer(groupId, assignmentId, submissionId, data);
    }


    // Course answers remain immutable after submission. Teachers may change grades,
    // but never a student's response, owner, or submission timestamp.
    function validFirstPublishedGrade(groupId, assignmentId, studentId) {
      let group = get(/databases/$(database)/documents/groups/$(groupId)).data;
      let assignment = get(/databases/$(database)/documents/groups/$(groupId)/assignments/$(assignmentId)).data;
      let before = resource.data;
      let after = request.resource.data;
      return group.get('type', '') == 'course'
        && isSchoolMember(group.get('schoolId', ''))
        && assignment.get('type', '') == 'assignment'
        && assignment.get('points', 0) is number
        && assignment.get('points', 0) > 0
        && before.get('userId', '') == studentId
        && before.get('submittedAt', null) != null
        && before.get('gradePublished', false) != true
        && after.diff(before).affectedKeys().hasOnly([
          'gradeScore', 'gradeFeedback', 'gradePublished',
          'gradePublishedBy', 'gradePublishedAt'
        ])
        && after.get('gradePublished', false) == true
        && after.get('gradeScore', -1) is number
        && after.gradeScore >= 0
        && after.gradeScore <= assignment.points
        && after.get('gradeFeedback', '') is string
        && after.get('gradeFeedback', '').size() <= 4000
        && after.get('gradePublishedBy', '') == request.auth.uid
        && after.get('gradePublishedAt', null) == request.time;
    }

    // Earlier clients write a provisional grade/feedback pair. Keep the first
    // write compatible while disallowing silent revisions and answer edits.
    function validFirstLegacyGrade(groupId, assignmentId, studentId) {
      let group = get(/databases/$(database)/documents/groups/$(groupId)).data;
      let assignment = get(/databases/$(database)/documents/groups/$(groupId)/assignments/$(assignmentId)).data;
      let before = resource.data;
      let after = request.resource.data;
      return (group.get('type', '') != 'course'
          || isSchoolMember(group.get('schoolId', '')))
        && before.get('userId', '') == studentId
        && before.get('submittedAt', null) != null
        && before.get('gradePublished', false) != true
        && before.get('grade', null) == null
        && after.diff(before).affectedKeys().hasOnly(['grade', 'feedback'])
        && after.get('grade', -1) is number
        && after.grade >= 0
        && after.grade <= 1000
        && (assignment.get('points', null) == null
          || (assignment.get('points', null) is number && after.grade <= assignment.points))
        && after.get('feedback', '') is string
        && after.get('feedback', '').size() <= 4000;
    }

    function changesPublishedGrade() {
      return resource.data.get('gradePublished', false) == true
        && request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'gradeScore', 'gradeFeedback', 'gradePublished', 'gradePublishedBy',
          'gradePublishedAt', 'gradeRevisionId', 'gradeRevisionCount',
          'gradeRevisedAt', 'gradeRevisionReason'
        ]);
    }

    function validGradeCorrection(groupId, assignmentId, studentId) {
      let group = get(/databases/$(database)/documents/groups/$(groupId)).data;
      let before = resource.data;
      let after = request.resource.data;
      let revisionId = after.get('gradeRevisionId', '');
      let revisionPath = /databases/$(database)/documents/groups/$(groupId)/assignments/$(assignmentId)/submissions/$(studentId)/gradeRevisions/$(revisionId);
      return group.get('type', '') == 'course'
        && isSchoolMember(group.get('schoolId', ''))
        && revisionId is string && revisionId.size() >= 10 && revisionId.size() <= 150
        && revisionId != before.get('gradeRevisionId', '')
        && after.diff(before).affectedKeys().hasOnly([
          'gradeScore', 'gradeFeedback', 'gradePublishedBy', 'gradePublishedAt',
          'gradeRevisionId', 'gradeRevisionCount', 'gradeRevisedAt', 'gradeRevisionReason'
        ])
        && after.gradePublished == true
        && after.gradeScore is number && after.gradeScore >= 0
        && after.gradeFeedback is string && after.gradeFeedback.size() <= 4000
        && after.gradePublishedBy == request.auth.uid
        && after.gradePublishedAt == request.time
        && after.gradeRevisedAt == request.time
        && after.gradeRevisionCount == before.get('gradeRevisionCount', 0) + 1
        && after.gradeRevisionReason is string
        && after.gradeRevisionReason.size() >= 5
        && after.gradeRevisionReason.size() <= 500
        && (after.gradeScore != before.get('gradeScore', null)
          || after.gradeFeedback != before.get('gradeFeedback', ''))
        && existsAfter(revisionPath)
        && getAfter(revisionPath).data.changedBy == request.auth.uid
        && getAfter(revisionPath).data.changedAt == request.time
        && getAfter(revisionPath).data.beforeScore == before.get('gradeScore', null)
        && getAfter(revisionPath).data.afterScore == after.gradeScore
        && getAfter(revisionPath).data.beforeFeedback == before.get('gradeFeedback', '')
        && getAfter(revisionPath).data.afterFeedback == after.gradeFeedback
        && getAfter(revisionPath).data.reason == after.gradeRevisionReason
        && getAfter(revisionPath).data.revision == after.gradeRevisionCount;
    }

    function validGradeRevisionLog(groupId, assignmentId, studentId, revisionId) {
      let group = get(/databases/$(database)/documents/groups/$(groupId)).data;
      let previous = get(/databases/$(database)/documents/groups/$(groupId)/assignments/$(assignmentId)/submissions/$(studentId)).data;
      let after = getAfter(/databases/$(database)/documents/groups/$(groupId)/assignments/$(assignmentId)/submissions/$(studentId)).data;
      let change = request.resource.data;
      return group.get('type', '') == 'course'
        && isSchoolMember(group.get('schoolId', ''))
        && previous.get('gradePublished', false) == true
        && after.get('gradePublished', false) == true
        && change.keys().hasAll([
          'beforeScore', 'afterScore', 'beforeFeedback', 'afterFeedback',
          'reason', 'changedBy', 'changedAt', 'revision'
        ])
        && change.keys().hasOnly([
          'beforeScore', 'afterScore', 'beforeFeedback', 'afterFeedback',
          'reason', 'changedBy', 'changedAt', 'revision'
        ])
        && change.changedBy == request.auth.uid
        && change.changedAt == request.time
        && change.reason is string && change.reason.size() >= 5
        && change.reason.size() <= 500
        && change.beforeScore == previous.get('gradeScore', null)
        && change.afterScore == after.get('gradeScore', null)
        && change.beforeFeedback == previous.get('gradeFeedback', '')
        && change.afterFeedback == after.get('gradeFeedback', '')
        && after.get('gradeRevisionId', '') == revisionId
        && after.get('gradeRevisionReason', '') == change.reason
        && after.get('gradeRevisedAt', null) == request.time
        && after.get('gradePublishedAt', null) == request.time
        && after.get('gradePublishedBy', '') == request.auth.uid
        && after.get('gradeRevisionCount', 0) == change.revision
        && change.revision == previous.get('gradeRevisionCount', 0) + 1;
    }

    function canReadPeerReviewDoc(groupId, assignmentId, reviewerId, data) {
      return canManageGroup(groupId)
        || (isSignedIn() && reviewerId == request.auth.uid)
        || (isSignedIn() && data.submissionOwnerId == request.auth.uid && data.submittedAt != null);
    }

    // AI server-side metadata logs are written by Admin SDK only.
    match /aiLogs/{logId} {
      allow read, write: if false;
    }

    // School directory (public readable)
    match /schools/{schoolId} {
      allow read: if true;
      allow write: if false; // managed by admins via functions later

      match /directory/{uid} {
        allow read: if isSchoolMember(schoolId);
        allow write: if false;
      }

      match /members/{uid} {
        allow read: if isSelf(uid) || hasRole(schoolId, 'admin') || requesterHasAnyServiceRole(schoolId);
        allow write: if false;
      }

      // courseRosters：僅以已知 rosterId（例如 tron_{courseId}）讀單一 doc。前端禁止對此 collection 做全量 list / 無篩選 query。
      match /courseRosters/{rosterId} {
        allow read: if isSchoolMember(schoolId)
          && (
            hasRole(schoolId, 'admin')
            || (
              'accessUids' in resource.data
              && request.auth.uid in resource.data.accessUids
            )
          );
        allow write: if false;
      }

      match /serviceRoles/{uid} {
        allow read: if isSelf(uid) || hasRole(schoolId, 'admin');
        allow write: if false;
      }

      match /cafeterias/{cafeteriaId} {
        allow read: if true;
        // Governance changes use the audited callables; merchants edit only their storefront.
        allow create, delete: if false;
        allow update: if cafeteriaStorefrontUrlsAllowed()
          && requesterIsCafeteriaOperator(schoolId, cafeteriaId)
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly([
              'openingHours', 'updatedAt', 'sourceLabel', 'intro', 'coverUrl',
              'location', 'websiteUrl', 'orderingUrl', 'merchantMode', 'menuSource',
              'menuSyncedAt'
            ])
          && request.resource.data.orderingEnabled == resource.data.orderingEnabled
          && request.resource.data.pilotStatus == resource.data.pilotStatus
          && (
            !('merchantMode' in request.resource.data)
            || request.resource.data.merchantMode in ['showcase_link', 'info_only']
            || (
              request.resource.data.merchantMode == 'native_order'
              && resource.data.get('merchantMode', 'native_order') == 'native_order'
            )
          );

        match /operators/{uid} {
          allow read: if isSelf(uid) || hasRole(schoolId, 'admin');
          allow create, update, delete: if false;
        }

        match /posts/{postId} {
          allow read: if true;
          allow create, update, delete: if hasRole(schoolId, 'admin')
            || requesterIsCafeteriaOperator(schoolId, cafeteriaId);

          match /likes/{uid} {
            allow read: if isSignedIn();
            allow create, delete: if isSelf(uid);
            allow update: if false;
          }

          match /comments/{commentId} {
            allow read: if isSignedIn();
            allow create: if isSignedIn()
              && request.resource.data.authorId == request.auth.uid
              && request.resource.data.text is string
              && request.resource.data.text.size() >= 1
              && request.resource.data.text.size() <= 2000;
            allow update, delete: if isSignedIn() && resource.data.authorId == request.auth.uid;
          }
        }

        match /followers/{uid} {
          allow read: if isSignedIn();
          allow create, delete: if isSelf(uid);
          allow update: if false;
        }
      }

      match /announcement-sources/{sourceId} {
        allow read: if true;
        allow write: if false;
      }

      match /announcements/{docId} {
        allow read: if true;
        allow create, update, delete: if false;
      }

      match /pois/{docId} {
        allow read: if true;
        allow create, update, delete: if hasEditorRole(schoolId);

        match /reviews/{reviewId} {
          allow read: if isSignedIn();
          allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
          allow update, delete: if hasEditorRole(schoolId)
            || (isSignedIn() && resource.data.uid == request.auth.uid);
        }

        match /crowdReports/{reportId} {
          allow read: if true;
          allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
          allow update, delete: if false;
        }

        match /reports/{reportId} {
          allow read: if hasRole(schoolId, 'admin') || hasRole(schoolId, 'editor');
          allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
          allow update: if hasRole(schoolId, 'admin') || hasRole(schoolId, 'editor');
          allow delete: if false;
        }
      }

      match /events/{docId} {
        allow read: if true;
        allow create, update, delete: if false;

        match /registrations/{registrationId} {
          allow read: if hasEditorRole(schoolId)
            || (isSignedIn() && (
              registrationId == request.auth.uid
              || resource.data.userId == request.auth.uid
            ));
          allow create, update, delete: if false;
        }

        match /reviews/{reviewId} {
          allow read: if isSignedIn();
          allow create: if isSignedIn()
            && reviewId == request.auth.uid
            && request.resource.data.uid == request.auth.uid;
          allow update, delete: if hasEditorRole(schoolId)
            || (isSignedIn() && resource.data.uid == request.auth.uid);
        }
      }

      match /clubEvents/{docId} {
        allow read: if true;
        allow create, update, delete: if false;
        match /registrations/{uid} {
          allow read: if hasEditorRole(schoolId) || (isSchoolMember(schoolId) && isSelf(uid));
          allow create, update, delete: if false;
        }
      }

      match /menus/{docId} {
        allow read: if true;
        allow create: if hasRole(schoolId, 'admin') || (
          request.resource.data.schoolId == schoolId
          && request.resource.data.cafeteriaId is string
          && requesterIsCafeteriaOperator(schoolId, request.resource.data.cafeteriaId)
          && request.resource.data.name is string
        );
        allow update: if hasRole(schoolId, 'admin') || (
          resource.data.cafeteriaId is string
          && requesterIsCafeteriaOperator(schoolId, resource.data.cafeteriaId)
          && request.resource.data.cafeteriaId == resource.data.cafeteriaId
        );
        allow delete: if hasRole(schoolId, 'admin') || (
          resource.data.cafeteriaId is string
          && requesterIsCafeteriaOperator(schoolId, resource.data.cafeteriaId)
        );

        match /reviews/{reviewId} {
          allow read: if isSignedIn();
          allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
          allow update, delete: if hasRole(schoolId, 'admin')
            || (isSignedIn() && resource.data.uid == request.auth.uid);
        }
      }

      match /cafeteriaMenus/{docId} {
        allow read: if true;
        allow create: if hasRole(schoolId, 'admin') || (
          request.resource.data.schoolId == schoolId
          && request.resource.data.cafeteriaId is string
          && requesterIsCafeteriaOperator(schoolId, request.resource.data.cafeteriaId)
          && request.resource.data.name is string
        );
        allow update: if hasRole(schoolId, 'admin') || (
          resource.data.cafeteriaId is string
          && requesterIsCafeteriaOperator(schoolId, resource.data.cafeteriaId)
          && request.resource.data.cafeteriaId == resource.data.cafeteriaId
        );
        allow delete: if hasRole(schoolId, 'admin') || (
          resource.data.cafeteriaId is string
          && requesterIsCafeteriaOperator(schoolId, resource.data.cafeteriaId)
        );
      }

      match /busRoutes/{docId} {
        allow read: if true;
        allow create, update, delete: if hasRole(schoolId, 'admin');
      }

      match /busArrivals/{docId} {
        allow read: if true;
        allow write: if false;
      }

      match /libraryBooks/{docId} {
        allow read: if true;
        allow create, update, delete: if hasRole(schoolId, 'admin');
      }

      match /librarySeats/{docId} {
        allow read: if true;
        allow create, update, delete: if hasRole(schoolId, 'admin');
      }

      match /libraryLoans/{loanId} {
        allow read: if hasRole(schoolId, 'admin') || (isSignedIn() && resource.data.userId == request.auth.uid);
        allow write: if false;
      }

      match /seatReservations/{reservationId} {
        allow read: if hasRole(schoolId, 'admin') || (isSignedIn() && resource.data.userId == request.auth.uid);
        allow write: if false;
      }

      match /lostFound/{docId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
        allow update, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
      }

      match /orders/{orderId} {
        allow read: if hasRole(schoolId, 'admin')
          || requesterIsCafeteriaOperator(schoolId, resource.data.cafeteriaId)
          || (isSignedIn() && resource.data.userId == request.auth.uid);
        // Order creation and status changes use authenticated callables so the
        // canonical receipt and user mirror cannot diverge through client writes.
        allow create, update, delete: if false;
      }

      match /settings/{docId} {
        allow read: if hasRole(schoolId, 'admin');
        allow write: if false;
      }

      match /leaderboard/{docId} {
        allow read: if isSignedIn();
        allow write: if false;
      }

      match /repairRequests/{requestId} {
        allow read: if hasRole(schoolId, 'admin')
          || requesterHasServiceRoleDomain(schoolId, 'repairs')
          || (isSignedIn() && resource.data.userId == request.auth.uid);
        allow write: if false;
      }

      match /packages/{packageId} {
        allow read: if hasRole(schoolId, 'admin')
          || requesterHasServiceRoleDomain(schoolId, 'packages')
          || (isSignedIn() && resource.data.recipientId == request.auth.uid);
        allow write: if false;
      }

      match /washingMachines/{machineId} {
        allow read: if true;
        allow create, update, delete: if hasRole(schoolId, 'admin');
      }

      match /washingReservations/{reservationId} {
        allow read: if hasRole(schoolId, 'admin') || (isSignedIn() && resource.data.userId == request.auth.uid);
        allow write: if false;
      }

      match /printers/{printerId} {
        allow read: if true;
        allow create, update, delete: if hasRole(schoolId, 'admin');
      }

      match /printJobs/{jobId} {
        allow read: if hasRole(schoolId, 'admin')
          || requesterHasServiceRoleDomain(schoolId, 'printing')
          || (isSignedIn() && resource.data.userId == request.auth.uid);
        allow write: if false;
      }

      match /healthAppointments/{appointmentId} {
        allow read: if hasRole(schoolId, 'admin')
          || requesterHasServiceRoleDomain(schoolId, 'health')
          || (isSignedIn() && resource.data.userId == request.auth.uid);
        allow write: if false;
      }

      match /healthRecords/{recordId} {
        allow read: if hasRole(schoolId, 'admin')
          || requesterHasServiceRoleDomain(schoolId, 'health')
          || (isSignedIn() && resource.data.userId == request.auth.uid);
        allow write: if false;
      }

      match /healthTimeSlots/{slotId} {
        allow read: if true;
        allow create, update, delete: if hasRole(schoolId, 'admin');
      }

      match /adminLogs/{docId} {
        allow read: if hasRole(schoolId, 'admin');
        allow write: if false;
      }

      match /pulseAggregates/{aggregateId} {
        allow read: if isSignedIn();
        allow write: if false;
      }

      match /pulseReports/{reportId} {
        allow read, write: if false;
      }

      match /aiKnowledge/{chunkId} {
        allow read: if resource.data.visibility == 'public'
          || (resource.data.visibility == 'school' && isSchoolMember(schoolId))
          || hasEditorRole(schoolId);
        allow write: if false;
      }

      match /boards/{boardId} {
        allow read: if isSchoolMember(schoolId);
        allow create, update: if hasEditorRole(schoolId);
        allow delete: if hasRole(schoolId, 'admin');
      }

      match /boardSubs/{subscriptionId} {
        allow read: if isSchoolMember(schoolId) && resource.data.userId == request.auth.uid;
        allow create: if isSchoolMember(schoolId)
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.schoolId == schoolId;
        allow delete: if isSchoolMember(schoolId) && resource.data.userId == request.auth.uid;
        allow update: if false;
      }

      match /campusPosts/{postId} {
        allow read: if isSchoolMember(schoolId);
        allow create: if isSchoolMember(schoolId) && campusPostCreatesOk(schoolId);
        allow update: if isSchoolMember(schoolId)
          && (
            campusPostLikeReactionOk()
            || campusPostCommentBumpOk()
            || (
              (
                (resource.data.anonymous != true && resource.data.authorUid == request.auth.uid)
                || (
                  resource.data.boardId is string
                  && isSchoolBoardModerator(schoolId, resource.data.boardId)
                )
              )
              && request.resource.data.boardId == resource.data.boardId
              && (
                !(resource.data.anonymous == true)
                || request.resource.data.authorUid == null
              )
            )
          );
        allow delete: if isSchoolMember(schoolId)
          && (
            (resource.data.anonymous != true && resource.data.authorUid == request.auth.uid)
            || (resource.data.boardId is string && isSchoolBoardModerator(schoolId, resource.data.boardId))
          );

        match /replies/{replyId} {
          allow read: if isSchoolMember(schoolId);
          allow create: if isSchoolMember(schoolId)
            && get(/databases/$(database)/documents/schools/$(schoolId)/campusPosts/$(postId)).data.boardId is string
            && (
              (
                request.resource.data.anonymous == true
                && !('authorUid' in request.resource.data)
                && request.resource.data.aliasSnapshot is string
              )
              || (
                request.resource.data.anonymous != true
                && request.resource.data.authorUid == request.auth.uid
              )
            );
          allow update, delete: if isSchoolMember(schoolId)
            && (
              (resource.data.anonymous != true && resource.data.authorUid == request.auth.uid)
              || isSchoolBoardModerator(schoolId, get(/databases/$(database)/documents/schools/$(schoolId)/campusPosts/$(postId)).data.boardId)
            );
        }
      }

      match /campusPostAudit/{postId} {
        allow read, write: if false;
      }

      match /lbsPresence/{sessionId} {
        allow read: if isSchoolMember(schoolId);
        allow create: if isSchoolMember(schoolId)
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.schoolId == schoolId;
        allow delete: if isSchoolMember(schoolId) && resource.data.uid == request.auth.uid;
        allow update: if isSchoolMember(schoolId)
          && resource.data.uid == request.auth.uid
          && request.resource.data.uid == resource.data.uid;
      }
    }

    // Conversations (DMs and group chats)
    match /conversations/{conversationId} {
      allow read: if isSignedIn() && request.auth.uid in resource.data.memberIds;
      allow create: if isSignedIn()
        && request.auth.uid in request.resource.data.memberIds
        && request.resource.data.schoolId != null
        && isSchoolMember(request.resource.data.schoolId);
      allow update: if isSignedIn()
        && request.auth.uid in resource.data.memberIds
        && request.resource.data.schoolId == resource.data.schoolId
        && request.resource.data.memberIds == resource.data.memberIds;
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isSignedIn()
          && exists(/databases/$(database)/documents/conversations/$(conversationId))
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.memberIds;
        allow create: if isSignedIn()
          && exists(/databases/$(database)/documents/conversations/$(conversationId))
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.memberIds
          && request.resource.data.senderId == request.auth.uid;
        allow update: if isSignedIn()
          && exists(/databases/$(database)/documents/conversations/$(conversationId))
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.memberIds
          && request.resource.data.senderId == resource.data.senderId
          && (
            (
              request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy'])
              && request.auth.uid in request.resource.data.readBy
            )
            || (
              resource.data.senderId == request.auth.uid
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['recalledAt', 'updatedAt'])
            )
            || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions', 'updatedAt'])
          );
        allow delete: if false;
      }
    }

    // Groups
    match /groups/{groupId} {
      allow read: if isActiveGroupMember(groupId);
      allow create: if isSignedIn()
        && request.resource.data.schoolId != null
        && isSchoolMember(request.resource.data.schoolId)
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.get('verification', {'status': 'unverified'}) == {'status': 'unverified'};
      allow update: if canManageGroup(groupId)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['schoolId', 'createdBy', 'verification', 'type']);
      allow delete: if canManageGroup(groupId);

      match /members/{uid} {
        allow read: if isActiveGroupMember(groupId)
          && (get(/databases/$(database)/documents/groups/$(groupId)).data.type != 'club'
            || request.auth.uid == uid
            || get(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)).data.role in ['owner', 'admin']);
        allow create: if false;
        // Client may not change role (including promoting to owner). Ownership transfer is server-only.
        allow update: if canManageGroup(groupId)
          && (get(/databases/$(database)/documents/groups/$(groupId)).data.type != 'club'
            || get(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)).data.role in ['owner', 'admin'])
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['uid', 'role', 'joinedAt']);
        allow delete: if canManageGroup(groupId)
          && (get(/databases/$(database)/documents/groups/$(groupId)).data.type != 'club'
            || get(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)).data.role in ['owner', 'admin']);
      }

      // Private transfer receipts; Admin SDK / privileged callables only.
      match /ownershipTransfers/{operationId} {
        allow read, write: if false;
      }

      match /posts/{postId} {
        allow read: if isActiveGroupMember(groupId);
        // 助理回覆的狀態（assistantReply）只由伺服器寫
        allow create: if isActiveGroupMember(groupId)
          && request.resource.data.authorId == request.auth.uid
          && !('assistantReply' in request.resource.data)
          && (request.resource.data.kind != 'announcement' || canManageGroup(groupId));
        allow update: if (canManageGroup(groupId) || (isSignedIn() && resource.data.authorId == request.auth.uid))
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['assistantReply']);
        allow delete: if canManageGroup(groupId) || (isSignedIn() && resource.data.authorId == request.auth.uid);

        match /comments/{commentId} {
          allow read: if isActiveGroupMember(groupId);
          // 助理回覆只由伺服器（Cloud Functions）寫入；用戶端不能寫、不能改、不能冒用助理的名字
          allow create: if isActiveGroupMember(groupId)
            && commentId != 'assistant'
            && request.resource.data.authorId == request.auth.uid
            && request.resource.data.get('isAI', false) != true
            && !('generatedBy' in request.resource.data)
            && request.resource.data.get('authorName', '') != '助理回覆';
          allow update: if commentId != 'assistant'
            && resource.data.authorId != 'campus-assistant'
            && resource.data.get('isAI', false) != true
            && request.resource.data.get('isAI', false) != true
            && request.resource.data.get('generatedBy', null) == resource.data.get('generatedBy', null)
            && request.resource.data.get('authorName', '') != '助理回覆'
            && (
              canManageGroup(groupId)
              || (isSignedIn() && resource.data.authorId == request.auth.uid
                && request.resource.data.authorId == resource.data.authorId)
            );
          allow delete: if commentId != 'assistant' && (
            canManageGroup(groupId)
            || (isSignedIn() && resource.data.authorId == request.auth.uid)
          );
        }
      }

      match /knowledgeBase/{entryId} {
        allow read: if isActiveGroupMember(groupId);
        allow create: if canManageGroup(groupId);
        allow delete: if false;
        allow update: if canManageGroup(groupId) && (
          resource.data.get('type', '') != 'assignment'
          || (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'title', 'description', 'dueAt', 'allowLateSubmission', 'updatedAt', 'lastEditedBy'
            ])
            && resource.data.get('createdBy', '') == request.auth.uid
            && resource.data.get('published', false) == true
            && resource.data.get('status', '') != 'closed'
            && request.resource.data.title is string
            && request.resource.data.title.size() >= 1
            && request.resource.data.title.size() <= 120
            && request.resource.data.description is string
            && request.resource.data.description.size() <= 10000
            && (request.resource.data.dueAt == null || request.resource.data.dueAt is string)
            && request.resource.data.allowLateSubmission is bool
            && request.resource.data.lastEditedBy == request.auth.uid
            && request.resource.data.updatedAt == request.time
          )
        );
      }

      match /aiKnowledge/{chunkId} {
        allow read: if isActiveGroupMember(groupId);
        allow write: if false;
      }

      match /modules/{moduleId} {
        allow read: if isActiveGroupMember(groupId);
        allow create, update, delete: if canManageGroup(groupId);

        match /materials/{materialId} {
          allow read: if isActiveGroupMember(groupId);
          allow create, update, delete: if canManageGroup(groupId);
        }
      }

      match /quizzes/{quizId} {
        allow read: if isActiveGroupMember(groupId);
        allow create, update, delete: if canManageGroup(groupId);
      }

      match /assignments/{assignmentId} {
        allow read: if isActiveGroupMember(groupId);
        allow create: if canManageGroup(groupId);
        // Published text assignments can only be edited by their author.
        // Another course manager must not alter points, identity, or publication state.
        allow update: if canManageGroup(groupId)
          && (
            (
              resource.data.get('type', '') != 'assignment'
              && request.resource.data.get('type', '') != 'assignment'
            ) || (
              resource.data.get('type', '') == 'assignment'
              && resource.data.get('createdBy', '') == request.auth.uid
              && resource.data.get('published', false) == true
              && resource.data.get('status', '') == 'published'
              && get(/databases/$(database)/documents/groups/$(groupId)).data.get('type', '') == 'course'
              && isSchoolMember(get(/databases/$(database)/documents/groups/$(groupId)).data.get('schoolId', ''))
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'title', 'description', 'dueAt', 'allowLateSubmission', 'updatedAt', 'lastEditedBy'
              ])
              && request.resource.data.get('title', '') is string
              && request.resource.data.get('title', '').size() > 0
              && request.resource.data.get('title', '').size() <= 120
              && request.resource.data.get('description', '') is string
              && request.resource.data.get('description', '').size() <= 10000
              && request.resource.data.get('allowLateSubmission', false) is bool
              && (
                request.resource.data.get('dueAt', null) == null
                || (request.resource.data.get('dueAt', null) is string
                    && request.resource.data.get('dueAt', '').size() <= 35)
              )
              && request.resource.data.get('lastEditedBy', '') == request.auth.uid
              && request.resource.data.get('updatedAt', null) == request.time
            )
          );
        allow delete: if canManageGroup(groupId)
          && resource.data.get('type', '') != 'assignment';

        match /submissions/{submissionId} {
          allow read: if isActiveGroupMember(groupId)
            && (submissionId == request.auth.uid
              || canReadSubmissionDoc(groupId, assignmentId, submissionId, resource.data));
          allow create: if validStudentSubmission(groupId, assignmentId, submissionId)
            && request.resource.data.keys().hasOnly([
              'userId', 'groupId', 'assignmentId', 'content', 'attachments', 'answers', 'status', 'submittedAt', 'updatedAt'
            ]);
          allow update: if (
            canManageGroup(groupId)
            && (
              validFirstPublishedGrade(groupId, assignmentId, submissionId)
              || validFirstLegacyGrade(groupId, assignmentId, submissionId)
              || (changesPublishedGrade()
                && validGradeCorrection(groupId, assignmentId, submissionId))
            )
          ) || (
            validStudentSubmission(groupId, assignmentId, submissionId)
            && isSubmissionOwner(resource.data, submissionId)
            && resource.data.get('submittedAt', null) == null
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'userId', 'groupId', 'assignmentId', 'content', 'attachments', 'answers', 'status', 'submittedAt', 'updatedAt'
            ])
          );
          allow delete: if false;

          match /gradeRevisions/{revisionId} {
            allow read: if canManageGroup(groupId);
            allow create: if canManageGroup(groupId)
              && validGradeRevisionLog(groupId, assignmentId, submissionId, revisionId);
            allow update, delete: if false;
          }
        }

        match /peerReviews/{reviewerId} {
          allow read: if canReadPeerReviewDoc(groupId, assignmentId, reviewerId, resource.data);
          allow create: if canManageGroup(groupId)
            && request.resource.data.reviewerId == reviewerId;
          allow update: if canManageGroup(groupId)
            || (
              isSignedIn()
              && reviewerId == request.auth.uid
              && request.resource.data.reviewerId == resource.data.reviewerId
              && request.resource.data.submissionOwnerId == resource.data.submissionOwnerId
            );
          allow delete: if canManageGroup(groupId);
        }
      }

      match /gradebook/{entryId} {
        allow read: if canManageGroup(groupId)
          || (isSignedIn() && (
            entryId == request.auth.uid
            || resource.data.userId == request.auth.uid
          ));
        allow create, update, delete: if canManageGroup(groupId);
      }

      match /milestones/{milestoneId} {
        allow read: if isActiveGroupMember(groupId);
        allow create, update, delete: if canManageGroup(groupId);
      }

      match /liveSessions/{sessionId} {
        // Version 1 documents contain public QR secrets and attendance rosters.
        // Clients must query schemaVersion == 2; legacy sessions require migration.
        allow read: if isActiveGroupMember(groupId) && resource.data.schemaVersion == 2;
        allow write: if false;

        match /questions/{questionId} {
          allow read: if isActiveGroupMember(groupId);
          allow create: if isActiveGroupMember(groupId)
            && request.resource.data.authorId == request.auth.uid;
          allow update: if canManageGroup(groupId)
            || (
              isActiveGroupMember(groupId)
              && request.resource.data.text == resource.data.text
              && request.resource.data.createdAt == resource.data.createdAt
              && request.resource.data.answered == resource.data.answered
            );
          allow delete: if canManageGroup(groupId);
        }

        match /polls/{pollId} {
          allow read: if isActiveGroupMember(groupId);
          allow create, update, delete: if canManageGroup(groupId);
        }
      }

      match /liveSessionSecrets/{sessionId} {
        allow read: if isActiveGroupMember(groupId)
          && get(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)).data.role in ['owner', 'instructor'];
        allow write: if false;
      }

      match /attendanceSessions/{sessionId} {
        allow read: if isActiveGroupMember(groupId) && resource.data.schemaVersion == 2;
        allow write: if false;

        match /attendanceRecords/{recordId} {
          allow read: if canManageGroup(groupId)
            || (isActiveGroupMember(groupId) && recordId == request.auth.uid);
          allow write: if false;
        }
        // 僅伺服器可寫、寫入後不可改的教師更正紀錄。學生不能列舉稽核明細。
        match /attendanceCorrections/{correctionId} {
          allow read: if isActiveGroupMember(groupId)
            && get(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)).data.role in ['owner', 'instructor'];
          allow write: if false;
        }
      }
    }

    // User profiles
    match /users/{uid} {
      allow read: if isSelf(uid);
      // Create: student-only role; reject client-supplied role authority / security flags.
      // Use get() defaults so missing optional keys do not evaluation-error.
      allow create: if isSelf(uid)
        && request.resource.data.get('role', 'student') == 'student'
        && request.resource.data.get('balance', null) == null
        && !request.resource.data.keys().hasAny([
          'primaryRole',
          'postLoginRoles',
          'teachingRoles',
          'orgRoles',
          'lastPostLoginResolvedAt'
        ]);
      // Update: denylist authority/security keys via affectedKeys so insert/change/remove
      // are all blocked even when the existing doc lacks those optional fields.
      allow update: if isSelf(uid)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'role',
          'primaryRole',
          'postLoginRoles',
          'teachingRoles',
          'orgRoles',
          'lastPostLoginResolvedAt',
          'balance',
          'schoolId',
          'primarySchoolId',
          'notificationDeliveryDisabled',
          'accountDeletionInProgress',
          'createdAt'
        ]);
      allow delete: if false;

      match /postLoginRuns/{runId} {
        allow read: if isSelf(uid);
        allow write: if false;
      }

      match /pushTokens/{tokenId} {
        allow read, write: if isSelf(uid);
      }

      match /settings/{settingId} {
        allow read, write: if isSelf(uid);
      }

      // Whole-document writes from older clients cannot erase dated arrangements.
      function validClassExceptionsWrite(before) {
        let after = request.resource.data;
        let savedSchool = before.get('schoolId', '') == 'tw-pu' ? 'pu' : before.get('schoolId', '');
        return (
          before.keys().hasAny(['classExceptions'])
          && !after.keys().hasAny(['classExceptions', 'classExceptionsRevision'])
          && getAfter(/databases/$(database)/documents/users/$(uid)/schools/$(savedSchool)/personalTimetable/exceptions).data.classExceptionsRevision >= before.get('classExceptionsRevision', 0)
          && (getAfter(/databases/$(database)/documents/users/$(uid)/schools/$(savedSchool)/personalTimetable/exceptions).data.classExceptionsRevision > before.get('classExceptionsRevision', 0)
            || getAfter(/databases/$(database)/documents/users/$(uid)/schools/$(savedSchool)/personalTimetable/exceptions).data.classExceptions == before.classExceptions)
        ) || (
          (!before.keys().hasAny(['classExceptions']) || after.keys().hasAll(['classExceptions']))
          && after.get('classExceptions', []) == before.get('classExceptions', [])
          && after.get('classExceptionsRevision', 0) == before.get('classExceptionsRevision', 0)
        ) || (
          after.keys().hasAll(['classExceptions', 'classExceptionsRevision'])
          && after.classExceptions is list
          && after.classExceptions.size() <= 200
          && after.classExceptionsRevision is int
          && after.classExceptionsRevision == before.get('classExceptionsRevision', 0) + 1
        );
      }

      match /personalTimetable/{docId} {
        allow read: if isSelf(uid) || (
          docId == 'current'
          && resource.data.shareWithFriends == true
          && resource.data.schoolId is string
          && isSchoolMember(resource.data.schoolId)
          && acceptedFriendsWith(uid, resource.data.schoolId)
        );
        allow create, update: if isSelf(uid)
          && request.resource.data.courses is list
          && request.resource.data.courses.size() <= 80
            && validClassExceptionsWrite(resource == null ? {} : resource.data);
        allow delete: if isSelf(uid) && !resource.data.keys().hasAny(['classExceptions']);
      }

      match /schools/{schoolId} {
        allow read: if isSelf(uid);
        allow write: if false;

        match /favorites/{favoriteId} {
          allow read, create, delete: if isSelf(uid);
          allow update: if false;
        }

        match /achievements/{achievementId} {
          allow read, write: if isSelf(uid);
        }

        match /enrollments/{enrollmentId} {
          allow read, write: if isSelf(uid);
        }

        match /grades/{gradeId} {
          allow read: if isSelf(uid);
          allow write: if isSelf(uid);
        }

        match /creditAudit/{docId} {
          allow read: if isSelf(uid);
          allow write: if isSelf(uid);
        }

        match /courses/{courseId} {
          allow read: if isSelf(uid);
          allow write: if isSelf(uid);
        }

        match /calendarEvents/{eventId} {
          allow read, write: if isSelf(uid);
        }

        match /libraryLoans/{loanId} {
          allow read, write: if isSelf(uid);
        }

        match /seatReservations/{reservationId} {
          allow read, write: if isSelf(uid);
        }

        match /orders/{orderId} {
          allow read: if isSelf(uid);
          allow write: if false;
        }

        match /externalOrders/{orderId} {
          allow read: if isSelf(uid);
          allow create: if isSelf(uid)
            && request.resource.data.fulfillment == 'external'
            && request.resource.data.schoolId == schoolId
            && request.resource.data.cafeteriaId is string
            && isHttpsStorefrontUrl(request.resource.data.orderingUrl)
            && !('queueNumber' in request.resource.data)
            && !('paymentStatus' in request.resource.data);
          allow update, delete: if false;
        }

        match /transactions/{transactionId} {
          allow read: if isSelf(uid);
          allow write: if false;
        }

        match /wallet/{walletDocId} {
          allow read: if isSelf(uid);
          allow write: if false;
        }

        match /weeklyReports/{reportId} {
          allow read: if isSelf(uid);
          allow write: if false;
        }

        match /dailyBriefs/{briefId} {
          allow read: if isSelf(uid);
          allow write: if false;
        }

        match /nextBestActions/{actionId} {
          allow read: if isSelf(uid);
          allow write: if false;
        }

        match /riskSnapshots/{snapshotId} {
          allow read: if isSelf(uid);
          allow write: if false;
        }

        function sharesArrangements() {
          let current = /databases/$(database)/documents/users/$(uid)/schools/$(schoolId)/personalTimetable/current;
          let legacy = /databases/$(database)/documents/users/$(uid)/personalTimetable/current;
          let base = exists(current) ? get(current).data : get(legacy).data;
          return base.get('shareWithFriends', false) == true && base.get('schoolId', '') == schoolId;
        }

        function embeddedExceptions() {
          let current = /databases/$(database)/documents/users/$(uid)/schools/$(schoolId)/personalTimetable/current;
          let legacy = /databases/$(database)/documents/users/$(uid)/personalTimetable/current;
          return exists(current) && get(current).data.keys().hasAny(['classExceptions'])
            ? get(current).data
            : (exists(legacy) && (get(legacy).data.get('schoolId', '') == schoolId || (schoolId == 'pu' && get(legacy).data.get('schoolId', '') == 'tw-pu')) ? get(legacy).data : {});
        }

        // Canonical per-school personal timetable (legacy users/{uid}/personalTimetable retained)
        match /personalTimetable/{docId} {
          // Missing current: allow same-school accepted friends to GET (empty) so clients can fall back to legacy.
          // Existing current: still require shareWithFriends + exact schoolId.
          allow get: if isSelf(uid) || (
            docId == 'exceptions'
            && isSchoolMember(schoolId)
            && acceptedFriendsWith(uid, schoolId)
            && sharesArrangements()
          ) || (
            docId == 'current'
            && isSchoolMember(schoolId)
            && acceptedFriendsWith(uid, schoolId)
            && (
              !exists(/databases/$(database)/documents/users/$(uid)/schools/$(schoolId)/personalTimetable/current)
              || (
                resource.data.shareWithFriends == true
                && resource.data.schoolId == schoolId
              )
            )
          );
          allow list: if isSelf(uid);
          allow create, update: if docId == 'exceptions' && isSelf(uid)
            && request.resource.data.schoolId == schoolId
            && request.resource.data.keys().hasOnly(['schoolId', 'classExceptions', 'classExceptionsRevision'])
            && request.resource.data.classExceptions is list
            && request.resource.data.classExceptions.size() <= 200
            && request.resource.data.classExceptionsRevision is int
            && validClassExceptionsWrite(resource == null ? embeddedExceptions() : resource.data);
          allow create, update: if docId != 'exceptions' && isSelf(uid)
            && request.resource.data.schoolId == schoolId
            && request.resource.data.courses is list
            && request.resource.data.courses.size() <= 80
            && validClassExceptionsWrite(resource == null ? {} : resource.data);
          allow delete: if docId != 'exceptions' && isSelf(uid) && !resource.data.keys().hasAny(['classExceptions']);
        }

        match /{document=**} {
          allow read: if isSelf(uid);
          allow write: if false;
        }
      }

      // Separate from users/{uid}/schools/{schoolId}/**: that legacy subtree has
      // a broad owner-read rule, which would bypass school-membership revocation.
      match /campusPostBookmarks/{schoolId}/posts/{postId} {
        allow read: if isSelf(uid) && isSchoolMember(schoolId);
        allow create: if isSelf(uid)
          && isSchoolMember(schoolId)
          && request.resource.data.keys().hasOnly(['schoolId', 'postId', 'createdAt'])
          && request.resource.data.keys().hasAll(['schoolId', 'postId', 'createdAt'])
          && request.resource.data.schoolId == schoolId
          && request.resource.data.postId == postId
          && request.resource.data.createdAt == request.time
          && exists(/databases/$(database)/documents/schools/$(schoolId)/campusPosts/$(postId));
        allow delete: if isSelf(uid) && isSchoolMember(schoolId);
        allow update: if false;
      }

      match /groups/{groupRef} {
        allow read: if isSelf(uid);
        allow write: if false;
      }

      match /milestones/{milestoneId} {
        allow read: if isSignedIn() && (
          request.auth.uid == uid
          || (resource.data.groupId != null && canManageGroup(resource.data.groupId))
        );
        allow create: if isSignedIn() && (
          request.auth.uid == uid
          || (request.resource.data.groupId != null && canManageGroup(request.resource.data.groupId))
        );
        allow update: if isSignedIn() && (
          request.auth.uid == uid
          || (request.resource.data.groupId != null && canManageGroup(request.resource.data.groupId))
          || (resource.data.groupId != null && canManageGroup(resource.data.groupId))
        );
        allow delete: if false;
      }

      // 學分試算：使用者自己的修課紀錄（子集合）
      match /enrollments/{enrollmentId} {
        allow read: if isSelf(uid);
        allow write: if false;
      }

      match /achievements/{achievementId} {
        allow read: if isSelf(uid);
        allow write: if false;
      }

      match /notifications/{notificationId} {
        allow read, update, delete: if isSelf(uid);
        allow create: if false;
      }

      match /blockedUsers/{blockedUid} {
        allow read, write: if isSelf(uid);
      }

      match /keeps/{keepId} {
        allow read, create, delete: if isSelf(uid);
        allow update: if false;
      }

      match /campusBoardAliases/{boardId} {
        allow read, write: if isSelf(uid);
      }

      match /weeklyReports/{reportId} {
        allow read: if isSelf(uid);
        allow write: if false;
      }

      match /dailyBriefs/{briefId} {
        allow read: if isSelf(uid);
        allow write: if false;
      }

      match /aiSessions/{sessionId} {
        allow read, create, update, delete: if isSelf(uid);

        match /messages/{messageId} {
          allow read, create, update, delete: if isSelf(uid);
        }
      }

      match /agentRuns/{runId} {
        allow read: if isSelf(uid);
        allow write: if false;
      }

      match /actionQueue/{actionId} {
        allow read: if isSelf(uid);
        allow create: if isSelf(uid)
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.requiresConfirmation == true
          && request.resource.data.status in ['draft', 'pending_confirmation']
          && request.resource.data.actorRole in ['student', 'teacher', 'staff', 'department', 'admin', 'school']
          && request.resource.data.permissionScope in ['public', 'school_public', 'user_private', 'academic_private'];
        allow update: if isSelf(uid)
          && resource.data.userId == request.auth.uid
          && request.resource.data.userId == resource.data.userId
          && request.resource.data.action == resource.data.action
          && request.resource.data.status in ['draft', 'pending_confirmation', 'confirmed', 'dismissed']
          && request.resource.data.actorRole == resource.data.actorRole
          && request.resource.data.permissionScope == resource.data.permissionScope;
        allow delete: if false;
      }

      match /nextBestActions/{actionId} {
        allow read: if isSelf(uid);
        allow write: if false;
      }

      match /riskSnapshots/{snapshotId} {
        allow read: if isSelf(uid);
        allow write: if false;
      }

      match /grades/{gradeId} {
        allow read: if isSelf(uid);
        allow write: if false;
      }
    }

    // Campus social graph (friends / follows)
    // 封鎖：一人一筆，只有封鎖的人自己看得到、能解除；不會動到原本的好友邀請
    match /friendBlocks/{blockId} {
      allow get, delete: if isSignedIn() && resource.data.blockerUid == request.auth.uid;
      allow list: if false;
      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly(['schoolId', 'blockerUid', 'blockedUid', 'createdAt'])
        && request.resource.data.blockerUid == request.auth.uid
        && request.resource.data.blockedUid is string
        && request.resource.data.blockedUid != request.auth.uid
        && request.resource.data.schoolId is string
        && isSchoolMember(request.resource.data.schoolId)
        && blockId == request.auth.uid + '_' + request.resource.data.blockedUid;
      allow update: if false;
    }

    match /friendships/{friendshipId} {
      allow read: if isSignedIn()
        && friendshipInvolves(request.auth.uid)
        && isSchoolMember(resource.data.schoolId);
      allow create: if isSignedIn()
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.toUid != request.auth.uid
        && request.resource.data.toUid is string
        && request.resource.data.schoolId is string
        && friendshipId == 'req_' + request.resource.data.schoolId + '_' + request.auth.uid + '_' + request.resource.data.toUid
        && request.resource.data.status == 'pending'
        && request.resource.data.schoolId != null
        && request.resource.data.get('fromName', profileName(request.auth.uid)) == profileName(request.auth.uid)
        && request.resource.data.get('toName', '') in ['', profileName(request.resource.data.toUid)]
        && !exists(/databases/$(database)/documents/friendBlocks/$(request.resource.data.toUid + '_' + request.auth.uid))
        && isSchoolMember(request.resource.data.schoolId);
      // 只有被邀請的人能接受或婉拒；送出邀請的人不能自己改成 accepted。
      // 封鎖另外記在 friendBlocks，不改這筆的狀態；其他欄位（名字以外）不能動。
      allow update: if isSignedIn()
        && friendshipInvolves(request.auth.uid)
        && resource.data.schoolId == request.resource.data.schoolId
        && resource.data.fromUid == request.resource.data.fromUid
        && resource.data.toUid == request.resource.data.toUid
        && request.resource.data.get('fromName', null) == resource.data.get('fromName', null)
        && (
          (
            request.auth.uid == resource.data.toUid
            && resource.data.status == 'pending'
            && request.resource.data.status == 'accepted'
            && request.resource.data.get('toName', '') in [resource.data.get('toName', ''), profileName(request.auth.uid)]
          )
          || (
            // 婉拒時記下時間，送出邀請的人七天內不能再送
            request.auth.uid == resource.data.toUid
            && resource.data.status == 'pending'
            && request.resource.data.status == 'declined'
            && request.resource.data.declinedAt == request.time
            && request.resource.data.get('toName', '') == resource.data.get('toName', '')
          )
        );
      // 婉拒過的邀請（包含舊版改成 blocked 的）七天內誰都不能刪，送出的人才不會靠對方刪掉就馬上重送；
      // 婉拒的人要擋對方，另外記封鎖（friendBlocks）
      allow delete: if isSignedIn()
        && friendshipInvolves(request.auth.uid)
        && isSchoolMember(resource.data.schoolId)
        && (
          resource.data.status in ['pending', 'accepted']
          || !(resource.data.get('declinedAt', null) is timestamp)
          || request.time > resource.data.declinedAt + duration.value(7, 'd')
        );
    }

    // 找人代號：同學自己開放的代號，只能用完整代號查一筆，不能列出整份名單。
    match /schools/{schoolId}/handles/{handle} {
      allow get: if isSchoolMember(schoolId);
      allow list: if false;
      allow create: if isSchoolMember(schoolId)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'name', 'handle', 'updatedAt'])
        && request.resource.data.handle == handle
        && request.resource.data.name == profileName(request.auth.uid)
        && handle.matches('^[a-z0-9_.-]{3,32}$');
      allow update: if isSchoolMember(schoolId)
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'name', 'handle', 'updatedAt'])
        && request.resource.data.handle == handle
        && request.resource.data.name == profileName(request.auth.uid);
      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;
    }

    match /timetableShares/{token} {
      allow get: if resource.data.revoked != true
        && resource.data.expiresAt is timestamp
        && resource.data.expiresAt > request.time;
      allow list, write: if false;
    }

    // 分享連結的擁有者只給伺服器用
    match /timetableShareOwners/{token} {
      allow read, write: if false;
    }

    match /meetups/{meetupId} {
      allow read: if isSignedIn()
        && (resource.data.creatorUid == request.auth.uid || resource.data.inviteeUid == request.auth.uid)
        && isSchoolMember(resource.data.schoolId);
      allow create: if isSignedIn()
        && request.resource.data.creatorUid == request.auth.uid
        && request.resource.data.inviteeUid != request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.kind in ['meal', 'study']
        && request.resource.data.day is int
        && request.resource.data.day >= 1
        && request.resource.data.day <= 5
        && isSchoolMember(request.resource.data.schoolId)
        && acceptedFriendsWith(request.resource.data.inviteeUid, request.resource.data.schoolId);
      allow update: if isSignedIn()
        && resource.data.inviteeUid == request.auth.uid
        && resource.data.schoolId == request.resource.data.schoolId
        && resource.data.creatorUid == request.resource.data.creatorUid
        && resource.data.status == 'pending'
        && request.resource.data.status in ['accepted', 'declined'];
      allow delete: if isSignedIn()
        && resource.data.creatorUid == request.auth.uid
        && resource.data.status == 'pending';
    }

    // 哪位老師教哪一門開課（代號＝課名｜老師）：學校管理者設定，老師只看得到自己有教的那幾筆
    match /schools/{schoolId}/courseTeachers/{offeringId} {
      allow get: if isSchoolMember(schoolId) && (
        request.auth.uid in resource.data.get('teacherUids', [])
        || hasRole(schoolId, 'admin')
      );
      allow list: if hasRole(schoolId, 'admin') || (isSchoolMember(schoolId) && request.auth.uid in resource.data.teacherUids);
      allow write: if hasRole(schoolId, 'admin');
    }

    // 申訴的那門課，這位老師有沒有教
    function teachesAppealCourse(appeal) {
      return isSchoolMember(appeal.schoolId)
        && appeal.get('offeringId', '') is string
        && appeal.get('offeringId', '').size() > 0
        && exists(/databases/$(database)/documents/schools/$(appeal.schoolId)/courseTeachers/$(appeal.offeringId))
        && request.auth.uid in get(/databases/$(database)/documents/schools/$(appeal.schoolId)/courseTeachers/$(appeal.offeringId)).data.get('teacherUids', []);
    }

    // 送申訴的課一定要在該校課表裡：優先看 school-scoped 文件；僅在 canonical 不存在時才讀 legacy，且 schoolId 必須完全一致
    function appealCourseInOwnTimetable(appeal) {
      let scopedPath = /databases/$(database)/documents/users/$(request.auth.uid)/schools/$(appeal.schoolId)/personalTimetable/current;
      let legacyPath = /databases/$(database)/documents/users/$(request.auth.uid)/personalTimetable/current;
      return (
        (
          exists(scopedPath)
          && get(scopedPath).data.get('schoolId', '') == appeal.schoolId
          && appeal.courseId in get(scopedPath).data.get('courseIds', [])
          && appeal.offeringId in get(scopedPath).data.get('offeringIds', [])
        )
        || (
          !exists(scopedPath)
          && exists(legacyPath)
          && get(legacyPath).data.get('schoolId', '') == appeal.schoolId
          && appeal.courseId in get(legacyPath).data.get('courseIds', [])
          && appeal.offeringId in get(legacyPath).data.get('offeringIds', [])
        )
      );
    }

    match /courseAppeals/{appealId} {
      allow read: if isSignedIn() && (
        resource.data.studentUid == request.auth.uid
        || teachesAppealCourse(resource.data)
        || hasRole(resource.data.schoolId, 'admin')
      );
      allow create: if isSignedIn()
        && request.resource.data.studentUid == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.courseId is string
        && request.resource.data.courseId.size() > 0
        && request.resource.data.courseName is string
        && request.resource.data.courseName.size() > 0
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 4
        && request.resource.data.body is string
        && request.resource.data.body.size() >= 8
        && request.resource.data.offeringId is string
        && request.resource.data.offeringId.size() > 0
        && appealCourseInOwnTimetable(request.resource.data)
        && isSchoolMember(request.resource.data.schoolId);
      // 學生只能撤回自己的；老師只能改狀態和回覆，課名、主旨、說明都不能動
      allow update: if isSignedIn() && (
        (
          resource.data.studentUid == request.auth.uid
          && resource.data.status == 'pending'
          && request.resource.data.status == 'withdrawn'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
        )
        || (
          (teachesAppealCourse(resource.data) || hasRole(resource.data.schoolId, 'admin'))
          && request.resource.data.status in ['reviewing', 'approved', 'rejected']
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'teacherNote', 'decidedAt', 'decidedBy', 'updatedAt'])
          && request.resource.data.get('teacherNote', '') is string
          && request.resource.data.get('teacherNote', '').size() <= 500
        )
      );
      allow delete: if false;
    }

    match /follows/{followId} {
      allow read: if isSignedIn()
        && (resource.data.followerUid == request.auth.uid || resource.data.targetUid == request.auth.uid)
        && isSchoolMember(resource.data.schoolId);
      allow create: if isSignedIn()
        && request.resource.data.keys().hasAll(['schoolId', 'followerUid', 'targetUid', 'createdAt'])
        && request.resource.data.keys().hasOnly(['schoolId', 'followerUid', 'targetUid', 'createdAt'])
        && request.resource.data.schoolId is string
        && request.resource.data.followerUid == request.auth.uid
        && request.resource.data.targetUid is string
        && request.resource.data.targetUid.size() > 0
        && request.resource.data.targetUid.size() <= 128
        && request.resource.data.followerUid != request.resource.data.targetUid
        && followId == 'fol_' + request.resource.data.schoolId + '_' + request.auth.uid + '_' + request.resource.data.targetUid
        && request.resource.data.createdAt == request.time
        && isSchoolMember(request.resource.data.schoolId)
        && exists(/databases/$(database)/documents/schools/$(request.resource.data.schoolId)/members/$(request.resource.data.targetUid))
        && get(/databases/$(database)/documents/schools/$(request.resource.data.schoolId)/members/$(request.resource.data.targetUid)).data.status == 'active';
      // Allow owners to remove their own follow even after membership is revoked.
      allow delete: if isSignedIn() && resource.data.followerUid == request.auth.uid;
      allow update: if false;
    }

    match /campusStories/{storyId} {
      allow read: if isSignedIn() && isSchoolMember(resource.data.schoolId);
      allow create: if isSignedIn()
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.schoolId != null
        && isSchoolMember(request.resource.data.schoolId)
        && request.resource.data.expiresAt != null;
      allow delete: if isSignedIn() && resource.data.authorUid == request.auth.uid;
      allow update: if false;

      match /storyViews/{viewerUid} {
        allow read: if isSignedIn()
          && isSchoolMember(get(/databases/$(database)/documents/campusStories/$(storyId)).data.schoolId);
        allow create: if isSignedIn()
          && viewerUid == request.auth.uid
          && isSchoolMember(get(/databases/$(database)/documents/campusStories/$(storyId)).data.schoolId);
        allow delete, update: if false;
      }
    }

    match /stickers/{path=**} {
      allow read: if true;
      allow write: if false;
    }

    match /campusReports/{reportId} {
      allow create: if isSignedIn()
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.schoolId != null
        && isSchoolMember(request.resource.data.schoolId);
      allow read: if false;
      allow update, delete: if false;
    }

    // SSO Links (internal, no client access)
    match /ssoLinks/{linkId} {
      allow read, write: if false;
    }

    // Admins collection
    match /admins/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // Global announcements, events, pois, menus (multi-tenant at root level)
    match /announcements/{docId} {
      allow read: if true;
      allow write: if false;
    }

    match /events/{docId} {
      allow read: if true;
      allow write: if false;
    }

    match /eventRegistrations/{docId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    match /pois/{docId} {
      allow read: if true;
      allow write: if false;
    }

    match /menus/{docId} {
      allow read: if true;
      allow write: if false;
    }

    match /menuRatings/{docId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.menuItemId == resource.data.menuItemId;
      allow delete: if false;
    }

    // Courses
    match /courses/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // Enrollments
    match /enrollments/{docId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow write: if false;
      allow delete: if false;
    }

    // Grades
    match /grades/{docId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    // Group Posts (global collection for simplicity)
    match /groupPosts/{docId} {
      allow read: if canReadGroupPost(docId);
      allow write: if false;
    }

    match /postLikes/{docId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && canReadGroupPost(request.resource.data.postId);
      allow delete: if isSignedIn()
        && resource.data.userId == request.auth.uid
        && canReadGroupPost(resource.data.postId);
      allow update: if false;
    }

    // Comments
    match /comments/{docId} {
      allow read: if canReadGroupPost(resource.data.postId);
      allow write: if false;
    }

    // Assignments (global collection)
    match /assignments/{docId} {
      allow read: if isActiveGroupMember(resource.data.groupId);
      allow write: if false;
    }

    // Submissions
    match /submissions/{docId} {
      allow read: if isSubmissionOwner(resource.data, docId)
        || (
          resource.data.groupId != null
          && canManageGroup(resource.data.groupId)
        )
        || (
          resource.data.groupId != null
          && resource.data.assignmentId != null
          && isAssignedReviewer(resource.data.groupId, resource.data.assignmentId, docId, resource.data)
        );
      allow write: if false;
    }

    // Group Members (global collection)
    match /groupMembers/{docId} {
      allow read: if isSignedIn() && (
        resource.data.userId == request.auth.uid
        || isActiveGroupMember(resource.data.groupId)
      );
      allow create: if false;
      allow update: if canManageGroup(resource.data.groupId)
        && request.resource.data.groupId == resource.data.groupId
        && request.resource.data.userId == resource.data.userId;
      allow delete: if false;
    }

    // Messages
    match /messages/{docId} {
      allow read: if isConversationMember(resource.data.conversationId);
      allow create: if isSignedIn()
        && request.resource.data.senderId == request.auth.uid
        && isConversationMember(request.resource.data.conversationId);
      allow update: if isConversationMember(resource.data.conversationId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy', 'updatedAt'])
        && request.auth.uid in request.resource.data.readBy;
      allow delete: if false;
    }

    // Lost & Found (global)
    match /lostFoundItems/{docId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // Library
    match /libraryBooks/{docId} {
      allow read: if true;
      allow write: if false;
    }

    match /libraryLoans/{docId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow write: if false;
      allow delete: if false;
    }

    match /librarySeats/{docId} {
      allow read: if true;
      allow write: if false;
    }

    match /seatReservations/{docId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    // Bus Routes
    match /busRoutes/{docId} {
      allow read: if true;
      allow write: if false;
    }

    match /busArrivals/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // Notifications
    match /notifications/{docId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if false;
      allow update: if isSignedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readAt', 'isRead', 'updatedAt']);
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // Calendar Events
    match /calendarEvents/{docId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    // Orders
    match /orders/{docId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    // Transactions
    match /transactions/{docId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    // Achievements
    match /achievements/{docId} {
      allow read: if true;
      allow write: if false;
    }

    match /userAchievements/{docId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    // Favorites
    match /favorites/{docId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    match /_puTronClassLmsCache/{uid} {
      allow read, write: if false;
    }

    // Leave requests（由 Cloud Functions Admin 建立；客戶端僅可讀自己的資料）
    match /leaveRequests/{requestId} {
      allow read: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow create, update, delete: if false;
    }
  }
}
