+export const PERSONAL_IMPORT_UNDO_LABEL = '撤銷上次匯入';
+export const PERSONAL_IMPORT_UNDO_TITLE = '撤銷上次匯入？';
+export const PERSONAL_IMPORT_UNDO_CONFIRM = '撤銷';
+export const PERSONAL_IMPORT_UNDO_KEEP = '先不要';
+
+export const PERSONAL_IMPORT_IMAGE_UNREADABLE =
+  '這張圖片打不開，可能檔案壞了或格式不支援，請換一張截圖再試。';
+
+export const PERSONAL_IMPORT_SYNCING = '正在同步到你的帳號…';
+export const PERSONAL_IMPORT_SYNCED = '已同步到你的帳號，換裝置登入同一個帳號並開啟同步就能看到。';
+export const PERSONAL_IMPORT_SYNC_NETWORK_FAILURE = '還沒同步到你的帳號，請確認網路後再試。';
+export const PERSONAL_IMPORT_SYNC_CONFLICT = '另一台裝置剛更新資料，請重新同步。';
+export const PERSONAL_IMPORT_SYNC_SESSION_EXPIRED =
+  '登入狀態已變更，請重新登入後同步；這台裝置的資料仍保留。';
+
+export const PERSONAL_IMPORT_OCR_LANGUAGES = 'chi_tra+eng';
+export const PERSONAL_IMPORT_OCR_PUBLIC_DIR = '/ocr';
+export const PERSONAL_IMPORT_OCR_SCRIPT = '/ocr/tesseract.min.js';
+export const PERSONAL_IMPORT_OCR_WORKER = '/ocr/worker.min.js';
+export const PERSONAL_IMPORT_OCR_CORE = '/ocr/tesseract-core-simd-lstm.wasm.js';
+export const PERSONAL_IMPORT_OCR_LANG = '/ocr/lang';
+
+export function personalImportUndoBody(count: number): string {
+  return `上次匯入的 ${count} 筆會從這台裝置刪掉，你原本的資料不會動。刪掉後沒辦法復原。`;
+}
+
+export function personalImportPreviewNotice(count: number): string {
+  return `整理出 ${count} 筆，請逐筆核對再匯入。`;
+}
+
+export function personalImportSavedNotice(added: number, syncEnabled = false): string {
+  return syncEnabled
+    ? `已在這台裝置新增 ${added} 筆，原有資料保留。`
+    : `已在這台裝置新增 ${added} 筆，原有資料保留。資料只存在這台裝置，換手機或清除資料就會不見。`;
+}
+
+export function personalImportUndoneNotice(removed: number): string {
+  return `已撤銷上次匯入的 ${removed} 筆，原本的資料都還在。`;
+}
+
+export function isUnreadablePersonalImportImage(error: unknown): boolean {
+  const message = error instanceof Error ? error.message : String(error ?? '');
+  return /decod|encodingerror|invalidstateerror|corrupt|unrecognized image|imagebitmap|failed to load image|source image|could not be read|invalid image|image format|unsupported image/i.test(
+    message,
+  );
+}
+
+export function personalImportErrorMessage(error: unknown, fallback: string): string {
+  if (isUnreadablePersonalImportImage(error)) return PERSONAL_IMPORT_IMAGE_UNREADABLE;
+  const message = error instanceof Error ? error.message.trim() : '';
+  if (message && /[\u4e00-\u9fff]/.test(message)) return message;
+  return fallback;
+}
diff --git a/apps/api/src/personal-import-sync/imports/records.ts b/apps/api/src/personal-import-sync/imports/records.ts
new file mode 100644
index 0000000..c8917b0
--- /dev/null
+++ b/apps/api/src/personal-import-sync/imports/records.ts
@@ -0,0 +1,197 @@
+import type {
+  ImportIssue,
+  PersonalImportCatalogCourse,
+  PersonalImportOptions,
+  PersonalImportRecord,
+  PersonalImportRow,
+} from './types';
+import {
+  isPersonalImportDate,
+  mapPersonalImportPeriods,
+  normalizePersonalImportText,
+  validatePersonalImportRow,
+} from './validation';
+
+let nextImportId = 0;
+export function createPersonalImportId(): string {
+  // Works in browsers and React Native without requiring a crypto polyfill.
+  nextImportId += 1;
+  return `import-${Date.now().toString(36)}-${nextImportId.toString(36)}-${Math.random().toString(36).slice(2, 10)}`;
+}
+const normalized = (value: unknown) =>
+  typeof value === 'string'
+    ? normalizePersonalImportText(value).replace(/\s+/g, ' ').toLowerCase()
+    : (value ?? '');
+
+/** Canonical personal identity: source name, random IDs and OCR formatting do not create duplicates. */
+export function personalImportKey(row: PersonalImportRow): string {
+  const common = [
+    row.kind,
+    row.schoolId,
+    row.academicYear,
+    row.semester,
+    row.courseCode || row.title,
+    row.teacher,
+    row.className,
+  ].map(normalized);
+  let eventEnd = row.endDate || row.date;
+  if (row.allDay && !row.endDate && row.date && isPersonalImportDate(row.date)) {
+    const nextDay = new Date(`${row.date}T00:00:00.000Z`);
+    nextDay.setUTCDate(nextDay.getUTCDate() + 1);
+    eventEnd = nextDay.toISOString().slice(0, 10);
+  }
+  const specific =
+    row.kind === 'timetable'
+      ? [
+          row.dayOfWeek,
+          row.startPeriod,
+          row.endPeriod,
+          row.periodLabel,
+          row.startPeriod ? '' : row.startTime,
+          row.endPeriod ? '' : row.endTime,
+        ]
+      : row.kind === 'events'
+        ? [row.date, row.startTime, eventEnd, row.endTime, !!row.allDay]
+        : [];
+  return JSON.stringify([...common, ...specific.map(normalized)]);
+}
+
+export function planPersonalImport(
+  existing: readonly PersonalImportRecord[],
+  incoming: readonly PersonalImportRow[],
+  options: {
+    batchId: string;
+    importedAt: string;
+    periodProfile?: NonNullable<PersonalImportOptions['periodProfile']>;
+  },
+): {
+  records: PersonalImportRecord[];
+  added: PersonalImportRecord[];
+  duplicates: PersonalImportRow[];
+  issues: ImportIssue[];
+} {
+  const issues: ImportIssue[] = [];
+  const duplicates: PersonalImportRow[] = [];
+  const added: PersonalImportRecord[] = [];
+  const byKey = new Map(existing.map((row) => [personalImportKey(row), row]));
+  const ids = new Set(existing.map((row) => row.id));
+  if (!options.batchId.trim() || !Number.isFinite(Date.parse(options.importedAt)))
+    issues.push({
+      code: 'invalid-batch',
+      severity: 'error',
+      message: '匯入批次資訊無效，請重新匯入。',
+    });
+  if (existing.some((row) => row.batchId === options.batchId))
+    issues.push({
+      code: 'reused-batch',
+      severity: 'error',
+      message: '這個匯入批次已使用，請重新建立批次。',
+    });
+  for (const incomingRow of incoming) {
+    const row = mapPersonalImportPeriods(incomingRow, options);
+    issues.push(...validatePersonalImportRow(row, options));
+    const key = personalImportKey(row);
+    const previous = byKey.get(key);
+    if (previous) {
+      if (
+        row.kind === 'grades' &&
+        (normalized(previous.grade) !== normalized(row.grade) || previous.credits !== row.credits)
+      )
+        issues.push({
+          code: 'grade-conflict',
+          severity: 'error',
+          rowId: row.id,
+          field: 'grade',
+          message: '同一學期已有這門課，但成績或學分不同。請先核對原有資料，這次不會覆蓋。',
+        });
+      else {
+        duplicates.push(row);
+        const metadataChanged =
+          normalized(previous.location) !== normalized(row.location) ||
+          normalized(previous.title) !== normalized(row.title) ||
+          normalized(previous.linkedCourseId) !== normalized(row.linkedCourseId);
+        issues.push({
+          code: metadataChanged ? 'duplicate-metadata-conflict' : 'duplicate-row',
+          severity: 'warning',
+          rowId: row.id,
+          message: metadataChanged
+            ? '已有相同課程或活動，但名稱、地點或課班連結不同；已保留原有資料，請另外核對這些差異。'
+            : '已有相同資料，這筆不會重複加入。',
+        });
+      }
+      continue;
+    }
+    if (ids.has(row.id)) {
+      issues.push({
+        code: 'duplicate-id',
+        severity: 'error',
+        rowId: row.id,
+        message: '資料識別碼重複，請重新建立草稿。',
+      });
+      continue;
+    }
+    const record: PersonalImportRecord = {
+      ...row,
+      source: { ...row.source },
+      batchId: options.batchId,
+      importedAt: options.importedAt,
+    };
+    byKey.set(key, record);
+    ids.add(row.id);
+    added.push(record);
+  }
+  if (issues.some((issue) => issue.severity === 'error'))
+    return { records: [...existing], added: [], duplicates, issues };
+  return { records: [...existing, ...added], added, duplicates, issues };
+}
+
+/** Imported records are immutable. Undo removes only records owned by the selected batch. */
+export function undoPersonalImportBatch(
+  existing: readonly PersonalImportRecord[],
+  batchId: string,
+): PersonalImportRecord[] {
+  return existing.filter((row) => row.batchId !== batchId);
+}
+
+export function resolvePersonalImportCourse(
+  row: PersonalImportRow,
+  catalog: readonly PersonalImportCatalogCourse[],
+): {
+  status: 'linked' | 'suggestions' | 'unmatched';
+  linkedCourseId?: string;
+  suggestions: PersonalImportCatalogCourse[];
+} {
+  if (
+    ![row.schoolId, row.academicYear, row.semester].every(
+      (value) => typeof value === 'string' && value.trim(),
+    )
+  )
+    return { status: 'unmatched', suggestions: [] };
+  const scoped = catalog.filter(
+    (course) =>
+      course.verified &&
+      normalized(course.schoolId) === normalized(row.schoolId) &&
+      normalized(course.academicYear) === normalized(row.academicYear) &&
+      normalized(course.semester) === normalized(row.semester),
+  );
+  const exact = row.courseCode?.trim()
+    ? scoped.filter((course) => normalized(course.courseCode) === normalized(row.courseCode))
+    : [];
+  const exactMatch = exact.length === 1 ? exact[0] : undefined;
+  if (exactMatch) {
+    const contradictory =
+      (row.teacher?.trim() && normalized(row.teacher) !== normalized(exactMatch.teacher)) ||
+      (row.className?.trim() && normalized(row.className) !== normalized(exactMatch.className));
+    if (!contradictory) return { status: 'linked', linkedCourseId: exactMatch.id, suggestions: [] };
+  }
+  // A shared course code can describe multiple sections. Even teacher/name matches require confirmation.
+  const suggestions = exact.length
+    ? exact
+    : scoped.filter(
+        (course) =>
+          normalized(course.title) === normalized(row.title) &&
+          !!row.teacher?.trim() &&
+          normalized(course.teacher) === normalized(row.teacher),
+      );
+  return { status: suggestions.length ? 'suggestions' : 'unmatched', suggestions };
+}
diff --git a/apps/api/src/personal-import-sync/imports/sync.ts b/apps/api/src/personal-import-sync/imports/sync.ts
new file mode 100644
index 0000000..c55fec7
--- /dev/null
+++ b/apps/api/src/personal-import-sync/imports/sync.ts
@@ -0,0 +1,245 @@
+import { validatePersonalImportBackupRecords } from './backup';
+import {
+  PERSONAL_IMPORT_SYNC_CONFLICT,
+  PERSONAL_IMPORT_SYNC_NETWORK_FAILURE,
+  PERSONAL_IMPORT_SYNC_SESSION_EXPIRED,
+} from './copy';
+import { personalImportKey } from './records';
+import type { PersonalImportRecord } from './types';
+
+export const PERSONAL_IMPORT_SYNC_BODY_LIMIT = 8 * 1024 * 1024 + 16 * 1024;
+export type PersonalImportSnapshot = {
+  schoolId: string;
+  revision: number;
+  records: PersonalImportRecord[];
+  updatedAt: string | null;
+  detachedCourseLinks?: string[];
+};
+export type PersonalImportPendingMutation = {
+  mutationId: string;
+  expectedRevision: number;
+  records: PersonalImportRecord[];
+};
+export type PersonalImportSyncState = {
+  enabled: boolean;
+  base: PersonalImportSnapshot | null;
+  pending?: PersonalImportPendingMutation;
+};
+export type PersonalImportSyncConflict = {
+  key: string;
+  reason: 'changed' | 'duplicate' | 'unconfirmed';
+  title: string;
+  local: PersonalImportRecord[];
+  remote: PersonalImportRecord[];
+};
+export type PersonalImportSyncChoices = Record<string, 'local' | 'remote'>;
+
+export function validatePersonalImportSyncRecords(
+  raw: unknown,
+  schoolId: string,
+): PersonalImportRecord[] {
+  const records = validatePersonalImportBackupRecords(raw, schoolId);
+  const keys = new Set<string>();
+  for (const record of records) {
+    const key = personalImportKey(record);
+    if (keys.has(key)) throw new Error('有重複的個人紀錄，請先核對後再同步。');
+    keys.add(key);
+  }
+  return records;
+}
+
+export function parsePersonalImportSnapshot(
+  raw: unknown,
+  schoolId: string,
+): PersonalImportSnapshot {
+  if (!raw || typeof raw !== 'object' || Array.isArray(raw))
+    throw new Error('同步回應格式不正確，裝置資料仍保留。');
+  const value = raw as Record<string, unknown>;
+  if (
+    value.schoolId !== schoolId ||
+    !Number.isSafeInteger(value.revision) ||
+    (value.revision as number) < 0 ||
+    (value.updatedAt !== null &&
+      (typeof value.updatedAt !== 'string' || !Number.isFinite(Date.parse(value.updatedAt)))) ||
+    (value.detachedCourseLinks !== undefined &&
+      (!Array.isArray(value.detachedCourseLinks) ||
+        value.detachedCourseLinks.length > 2000 ||
+        value.detachedCourseLinks.some((id) => typeof id !== 'string' || id.length > 300)))
+  ) {
+    throw new Error('同步資料的校園或版本不正確，裝置資料仍保留。');
+  }
+  const records = validatePersonalImportSyncRecords(value.records, schoolId);
+  if (value.revision === 0 && (records.length || value.updatedAt !== null))
+    throw new Error('同步版本不正確。');
+  return {
+    schoolId,
+    revision: value.revision as number,
+    records,
+    updatedAt: value.updatedAt as string | null,
+    ...(value.detachedCourseLinks
+      ? { detachedCourseLinks: value.detachedCourseLinks as string[] }
+      : {}),
+  };
+}
+
+/** The pending payload is kept verbatim until the same mutation is acknowledged. */
+export function parsePersonalImportSyncState(
+  raw: unknown,
+  schoolId: string,
+): PersonalImportSyncState {
+  if (!raw || typeof raw !== 'object' || Array.isArray(raw))
+    throw new Error('同步紀錄無法讀取，原有資料仍保留，請先匯出備份。');
+  const value = raw as Record<string, unknown>;
+  if (typeof value.enabled !== 'boolean' || !Object.hasOwn(value, 'base'))
+    throw new Error('同步紀錄無法讀取，原有資料仍保留，請先匯出備份。');
+  const base = value.base === null ? null : parsePersonalImportSnapshot(value.base, schoolId);
+  let pending: PersonalImportPendingMutation | undefined;
+  if (value.pending !== undefined) {
+    if (!value.pending || typeof value.pending !== 'object' || Array.isArray(value.pending))
+      throw new Error('待確認的同步紀錄無法讀取，原有資料仍保留。');
+    const candidate = value.pending as Record<string, unknown>;
+    if (
+      Object.keys(candidate).some(
+        (key) => !['mutationId', 'expectedRevision', 'records'].includes(key),
+      ) ||
+      typeof candidate.mutationId !== 'string' ||
+      !/^[A-Za-z0-9_-]{8,100}$/u.test(candidate.mutationId) ||
+      !Number.isSafeInteger(candidate.expectedRevision) ||
+      (candidate.expectedRevision as number) < 0 ||
+      (candidate.expectedRevision as number) >= 2_147_483_647 ||
+      (base && (candidate.expectedRevision as number) < base.revision)
+    )
+      throw new Error('待確認的同步紀錄無法讀取，原有資料仍保留。');
+    pending = {
+      mutationId: candidate.mutationId,
+      expectedRevision: candidate.expectedRevision as number,
+      records: validatePersonalImportSyncRecords(candidate.records, schoolId),
+    };
+  }
+  return { enabled: value.enabled, base, ...(pending ? { pending } : {}) };
+}
+
+function canonical(value: unknown): string {
+  if (Array.isArray(value)) return `[${value.map(canonical).join(',')}]`;
+  if (value && typeof value === 'object') {
+    return `{${Object.keys(value)
+      .sort()
+      .filter((key) => (value as Record<string, unknown>)[key] !== undefined)
+      .map((key) => `${JSON.stringify(key)}:${canonical((value as Record<string, unknown>)[key])}`)
+      .join(',')}}`;
+  }
+  return JSON.stringify(value) ?? 'undefined';
+}
+export function personalImportRecordsEqual(
+  left: readonly PersonalImportRecord[],
+  right: readonly PersonalImportRecord[],
+): boolean {
+  return (
+    canonical([...left].sort((a, b) => a.id.localeCompare(b.id))) ===
+    canonical([...right].sort((a, b) => a.id.localeCompare(b.id)))
+  );
+}
+function same(
+  left: PersonalImportRecord | undefined,
+  right: PersonalImportRecord | undefined,
+): boolean {
+  return canonical(left) === canonical(right);
+}
+function content(record: PersonalImportRecord): string {
+  const { id, batchId, importedAt, source, ...fields } = record;
+  void id;
+  void batchId;
+  void importedAt;
+  void source;
+  return canonical(fields);
+}
+
+/** Three-way merge: deletion is represented by absence relative to the acknowledged base. */
+export function mergePersonalImportRecords(
+  base: readonly PersonalImportRecord[],
+  local: readonly PersonalImportRecord[],
+  remote: readonly PersonalImportRecord[],
+  choices: PersonalImportSyncChoices = {},
+): { records: PersonalImportRecord[]; conflicts: PersonalImportSyncConflict[] } {
+  const previous = new Map(base.map((row) => [row.id, row]));
+  const here = new Map(local.map((row) => [row.id, row]));
+  const there = new Map(remote.map((row) => [row.id, row]));
+  const merged: PersonalImportRecord[] = [];
+  const conflicts: PersonalImportSyncConflict[] = [];
+  for (const id of new Set([...previous.keys(), ...here.keys(), ...there.keys()])) {
+    const b = previous.get(id),
+      l = here.get(id),
+      r = there.get(id);
+    let selected: PersonalImportRecord | undefined;
+    if (same(l, r)) selected = r;
+    else if (same(l, b)) selected = r;
+    else if (same(r, b)) selected = l;
+    else {
+      const key = `record:${id}`;
+      if (choices[key]) selected = choices[key] === 'local' ? l : r;
+      else
+        conflicts.push({
+          key,
+          reason: 'changed',
+          title: (l || r || b)!.title,
+          local: l ? [l] : [],
+          remote: r ? [r] : [],
+        });
+    }
+    if (selected) merged.push(selected);
+  }
+  const groups = new Map<string, PersonalImportRecord[]>();
+  for (const row of merged) {
+    const key = personalImportKey(row);
+    groups.set(key, [...(groups.get(key) || []), row]);
+  }
+  const records: PersonalImportRecord[] = [];
+  for (const [identity, group] of groups) {
+    const first = group[0];
+    if (!first) continue;
+    if (group.length === 1) {
+      records.push(first);
+      continue;
+    }
+    if (group.every((row) => content(row) === content(first))) {
+      // Acknowledged server identity wins when two devices independently import the same row.
+      records.push(group.find((row) => there.has(row.id)) || first);
+      continue;
+    }
+    const key = `duplicate:${identity}`;
+    const l = local.filter((row) => personalImportKey(row) === identity);
+    const r = remote.filter((row) => personalImportKey(row) === identity);
+    if (choices[key]) records.push(...(choices[key] === 'local' ? l : r));
+    else
+      conflicts.push({
+        key,
+        reason: 'duplicate',
+        title: first.title,
+        local: [...l],
+        remote: [...r],
+      });
+  }
+  return { records, conflicts };
+}
+
+export function personalImportSyncErrorMessage(error: unknown): string {
+  const code = error && typeof error === 'object' && 'code' in error ? String(error.code) : '';
+  if (code === 'PERSONAL_IMPORT_REVISION_CONFLICT') return PERSONAL_IMPORT_SYNC_CONFLICT;
+  if (
+    [
+      'SIGN_IN_REQUIRED',
+      'SESSION_CHANGED',
+      'PLATFORM_SESSION_INVALID',
+      'UNAUTHORIZED',
+      'PERSONAL_IMPORT_SESSION_EXPIRED',
+    ].includes(code)
+  )
+    return PERSONAL_IMPORT_SYNC_SESSION_EXPIRED;
+  if (code === 'PERSONAL_IMPORT_SCHOOL_LIMIT')
+    return '已達帳號可同步的校園數量上限，這份資料仍保留在裝置。';
+  if (['NOT_FOUND', 'IMPORT_SYNC_DISABLED'].includes(code))
+    return '帳號同步暫時無法使用，資料已保留在這台裝置。';
+  if (error instanceof Error && !code && /[\u4e00-\u9fff]/.test(error.message))
+    return error.message;
+  return PERSONAL_IMPORT_SYNC_NETWORK_FAILURE;
+}
diff --git a/apps/api/src/personal-import-sync/imports/types.ts b/apps/api/src/personal-import-sync/imports/types.ts
new file mode 100644
index 0000000..cba9ccd
--- /dev/null
+++ b/apps/api/src/personal-import-sync/imports/types.ts
@@ -0,0 +1,81 @@
+import type { PeriodProfileId } from '../timetable/schoolPeriods';
+
+export type PersonalImportKind = 'timetable' | 'grades' | 'events';
+
+export type PersonalImportSource = {
+  type: 'paste' | 'file' | 'screenshot';
+  name?: string;
+  /** One-based source line. Source images themselves are not retained. */
+  line: number;
+  rawText: string;
+};
+
+/** An editable personal draft. Missing values stay missing until the user supplies them. */
+export type PersonalImportRow = {
+  id: string;
+  kind: PersonalImportKind;
+  title: string;
+  schoolId: string;
+  academicYear: string;
+  semester: string;
+  courseCode?: string;
+  teacher?: string;
+  className?: string;
+  location?: string;
+  dayOfWeek?: number;
+  startPeriod?: number;
+  endPeriod?: number;
+  /** Original school period notation when it is not a mapped grid slot. */
+  periodLabel?: string;
+  startTime?: string;
+  endTime?: string;
+  credits?: number;
+  /** Preserves numeric, letter, and pass/fail grades without estimating earned credits. */
+  grade?: string;
+  date?: string;
+  /** For all-day events, endDate is exclusive, matching iCalendar semantics. */
+  endDate?: string;
+  allDay?: boolean;
+  /** Personal reference only. Never constitutes membership or instructor authority. */
+  linkedCourseId?: string;
+  source: PersonalImportSource;
+};
+
+export type ImportIssue = {
+  code: string;
+  severity: 'error' | 'warning';
+  message: string;
+  rowId?: string;
+  field?: keyof PersonalImportRow;
+};
+
+export type PersonalImportOptions = {
+  kind: PersonalImportKind;
+  schoolId: string;
+  academicYear: string;
+  semester: string;
+  source?: Pick<PersonalImportSource, 'type' | 'name'>;
+  /** School weekday/period grid used to map paste/screenshot text into slots. */
+  periodProfile?: PeriodProfileId;
+};
+
+export type PersonalImportRecord = PersonalImportRow & {
+  batchId: string;
+  importedAt: string;
+};
+
+export type PersonalImportCatalogCourse = {
+  id: string;
+  title: string;
+  schoolId: string;
+  academicYear: string;
+  semester: string;
+  courseCode?: string;
+  teacher?: string;
+  className?: string;
+  /** Set only from a trusted catalog, never from uploaded/OCR data. */
+  verified: boolean;
+};
+
+export const PERSONAL_IMPORT_MAX_ROWS = 500;
+export const PERSONAL_IMPORT_MAX_TEXT_LENGTH = 200_000;
diff --git a/apps/api/src/personal-import-sync/imports/validation.ts b/apps/api/src/personal-import-sync/imports/validation.ts
new file mode 100644
index 0000000..b5d35cc
--- /dev/null
+++ b/apps/api/src/personal-import-sync/imports/validation.ts
@@ -0,0 +1,237 @@
+import {
+  PERIOD_PROFILE_TITLES,
+  isPeriodProfileId,
+  mapClockToPeriodSlots,
+  periodCount,
+  periodLabelAt,
+  periodSlots,
+  periodTimes,
+  type PeriodProfileId,
+} from '../timetable/periods';
+import type { ImportIssue, PersonalImportOptions, PersonalImportRow } from './types';
+
+export function normalizePersonalImportText(value: string): string {
+  return String(value ?? '')
+    .normalize('NFKC')
+    .replace(/\uFEFF/g, '')
+    .trim();
+}
+
+export function isPersonalImportDate(value: string): boolean {
+  const match = /^(\d{4})-(\d{2})-(\d{2})$/.exec(value);
+  if (!match) return false;
+  const year = Number(match[1]);
+  const month = Number(match[2]);
+  const day = Number(match[3]);
+  if (year < 1900 || year > 2200 || month < 1 || month > 12 || day < 1) return false;
+  const days = new Date(Date.UTC(year, month, 0)).getUTCDate();
+  return day <= days;
+}
+
+export function isPersonalImportTime(value: string): boolean {
+  return /^(?:[01]\d|2[0-3]):[0-5]\d$/.test(value);
+}
+
+function profileOf(
+  options: Pick<PersonalImportOptions, 'periodProfile'> = {},
+): PeriodProfileId | undefined {
+  return isPeriodProfileId(options.periodProfile) ? options.periodProfile : undefined;
+}
+
+function periodGuide(profile: PeriodProfileId): string {
+  const labels = periodSlots(profile).map((slot) => slot.label).join('、');
+  return `${PERIOD_PROFILE_TITLES[profile]}節次 ${labels}`;
+}
+
+/** Only exact period boundaries are converted; a nearby clock time is not evidence of a period. */
+export function mapPersonalImportPeriods(
+  row: PersonalImportRow,
+  options: Pick<PersonalImportOptions, 'periodProfile'> = {},
+): PersonalImportRow {
+  const profile = profileOf(options);
+  if (row.kind !== 'timetable' || !profile) return row;
+  const mapped = mapClockToPeriodSlots(row.startTime, row.endTime, profile);
+  return {
+    ...row,
+    ...(row.startPeriod === undefined && mapped.start ? { startPeriod: mapped.start } : {}),
+    ...(row.endPeriod === undefined && mapped.end ? { endPeriod: mapped.end } : {}),
+  };
+}
+
+export function validatePersonalImportRow(
+  row: PersonalImportRow,
+  options: Pick<PersonalImportOptions, 'periodProfile'> = {},
+): ImportIssue[] {
+  const issues: ImportIssue[] = [];
+  const error = (code: string, field: keyof PersonalImportRow, message: string) =>
+    issues.push({ code, field, message, severity: 'error', rowId: row.id });
+  if (!row || typeof row !== 'object')
+    return [
+      { code: 'invalid-row', severity: 'error', message: '資料格式不完整，請重新建立草稿。' },
+    ];
+  for (const field of ['id', 'title', 'schoolId', 'academicYear', 'semester'] as const) {
+    if (typeof row[field] !== 'string')
+      error('invalid-field-type', field, '欄位格式不正確，請重新確認資料。');
+  }
+  for (const field of [
+    'courseCode',
+    'teacher',
+    'className',
+    'location',
+    'linkedCourseId',
+    'startTime',
+    'endTime',
+    'grade',
+    'date',
+    'endDate',
+    'periodLabel',
+  ] as const) {
+    if (row[field] !== undefined && typeof row[field] !== 'string')
+      error('invalid-field-type', field, '欄位格式不正確，請重新確認資料。');
+  }
+  if (row.allDay !== undefined && typeof row.allDay !== 'boolean')
+    error('invalid-field-type', 'allDay', '請確認是否為全天活動。');
+  if (issues.length) return issues;
+  if (!['timetable', 'grades', 'events'].includes(row.kind))
+    error('invalid-kind', 'kind', '請選擇資料種類。');
+  if (!row.id?.trim()) error('missing-id', 'id', '這筆資料缺少識別碼，請重新建立草稿。');
+  if (!row.title?.trim()) error('missing-title', 'title', '請填寫課程或活動名稱。');
+  if (row.title?.length > 200) error('long-title', 'title', '名稱請縮短至 200 個字以內。');
+  if (!row.schoolId?.trim()) error('missing-school', 'schoolId', '請選擇這份資料所屬的學校。');
+  if (row.kind !== 'events') {
+    if (!/^\d{2,4}$/.test(row.academicYear))
+      error('invalid-year', 'academicYear', '請填寫學年度，例如 115 或 2026。');
+    if (!row.semester?.trim() || row.semester.length > 30)
+      error('invalid-semester', 'semester', '請填寫學期。');
+  }
+  for (const field of [
+    'courseCode',
+    'teacher',
+    'className',
+    'location',
+    'linkedCourseId',
+    'periodLabel',
+  ] as const) {
+    if (row[field] && row[field]!.length > 300)
+      error('long-field', field, '欄位內容請縮短至 300 個字以內。');
+  }
+  if (row.kind === 'timetable') {
+    const mapped = mapPersonalImportPeriods(row, options);
+    const profile = profileOf(options);
+    const slots = profile ? periodCount(profile) : undefined;
+    const weekdays = profile ? 5 : 7;
+    if (!Number.isInteger(row.dayOfWeek) || row.dayOfWeek! < 1 || row.dayOfWeek! > weekdays)
+      error(
+        'invalid-weekday',
+        'dayOfWeek',
+        profile
+          ? `${PERIOD_PROFILE_TITLES[profile]}課表目前支援星期一至五，請確認上課日。`
+          : '請確認上課日（星期一至日）。',
+      );
+    const hasPeriods = mapped.startPeriod !== undefined || mapped.endPeriod !== undefined;
+    if (profile || hasPeriods || (!row.startTime && !row.endTime && !row.periodLabel?.trim())) {
+      for (const field of ['startPeriod', 'endPeriod'] as const) {
+        if (
+          !Number.isInteger(mapped[field]) ||
+          mapped[field]! < 1 ||
+          mapped[field]! > (slots ?? 99)
+        )
+          error(
+            'invalid-period',
+            field,
+            profile
+              ? `請確認${periodGuide(profile)}；時間不符節次時需要手動修正。`
+              : '請確認學校原始節次，或改填完整上課時間。',
+          );
+      }
+    }
+    if (
+      mapped.startPeriod !== undefined &&
+      mapped.endPeriod !== undefined &&
+      mapped.startPeriod > mapped.endPeriod
+    )
+      error('reversed-periods', 'endPeriod', '結束節次不能早於開始節次。');
+    for (const field of ['startTime', 'endTime'] as const) {
+      if (row[field] && !isPersonalImportTime(row[field]!))
+        error('invalid-time', field, '時間格式請使用 24 小時制，例如 09:10。');
+      if (!profile && !hasPeriods && !row.periodLabel?.trim() && !row[field])
+        error('missing-time', field, '請填寫完整的開始與結束時間。');
+    }
+    if (row.startTime && row.endTime && row.endTime <= row.startTime)
+      error('reversed-times', 'endTime', '結束時間必須晚於開始時間。');
+    if (profile) {
+      const times = periodTimes(profile);
+      if (
+        row.startTime &&
+        mapped.startPeriod &&
+        times[mapped.startPeriod - 1]?.[0] !== row.startTime
+      )
+        error(
+          'period-time-conflict',
+          'startTime',
+          `開始時間與所選節次（${periodLabelAt(mapped.startPeriod, profile)}）不一致，請確認。`,
+        );
+      if (
+        row.endTime &&
+        mapped.endPeriod &&
+        times[mapped.endPeriod - 1]?.[1] !== row.endTime
+      )
+        error(
+          'period-time-conflict',
+          'endTime',
+          `結束時間與所選節次（${periodLabelAt(mapped.endPeriod, profile)}）不一致，請確認。`,
+        );
+    } else {
+      issues.push({
+        code: 'personal-timetable-only',
+        severity: 'warning',
+        rowId: row.id,
+        message: '已保留原始時間與節次；這所學校尚未設定課表格線，不會換算成節次格子。',
+      });
+    }
+  }
+  if (row.kind === 'grades') {
+    if (!Number.isFinite(row.credits) || row.credits! < 0 || row.credits! > 40)
+      error('invalid-credits', 'credits', '請填寫原始成績單上的學分數（0 至 40）。');
+    if (!row.grade?.trim()) error('missing-grade', 'grade', '請填寫原始成績，例如 85、A 或通過。');
+    else if (row.grade.length > 40) error('invalid-grade', 'grade', '成績內容過長，請確認欄位。');
+    else if (
+      /^-?\d+(?:\.\d+)?$/.test(row.grade) &&
+      (Number(row.grade) < 0 || Number(row.grade) > 100)
+    )
+      error('invalid-grade', 'grade', '數字成績應介於 0 至 100；其他計分制請保留原始文字並確認。');
+  }
+  if (row.kind === 'events') {
+    if (!row.date || !isPersonalImportDate(row.date))
+      error('invalid-date', 'date', '請填寫完整且有效的日期，例如 2026-10-20。');
+    if (row.endDate && !isPersonalImportDate(row.endDate))
+      error('invalid-date', 'endDate', '請確認活動結束日期。');
+    if (!row.allDay) {
+      for (const field of ['startTime', 'endTime'] as const) {
+        if (!row[field] || !isPersonalImportTime(row[field]!))
+          error('invalid-time', field, '請填寫 24 小時制時間，例如 18:00。');
+      }
+      if (
+        row.date &&
+        row.startTime &&
+        row.endTime &&
+        `${row.endDate || row.date}T${row.endTime}` <= `${row.date}T${row.startTime}`
+      )
+        error('reversed-event', 'endTime', '結束時間必須晚於開始時間；跨日活動請補上結束日期。');
+    } else {
+      if (row.startTime || row.endTime)
+        error('all-day-time-conflict', 'allDay', '全天活動不需要時間；請清除時間或取消全天。');
+      if (row.endDate && row.date && row.endDate <= row.date)
+        error('reversed-event', 'endDate', '全天活動的結束日期不包含當天，必須晚於開始日期。');
+    }
+  }
+  if (row.kind !== 'events' && !row.courseCode?.trim())
+    issues.push({
+      code: 'missing-course-code',
+      severity: 'warning',
+      field: 'courseCode',
+      rowId: row.id,
+      message: '沒有課號，先保留為個人資料；不會自動連結到同名課程。',
+    });
+  return issues;
+}
diff --git a/apps/api/src/personal-import-sync/routes.ts b/apps/api/src/personal-import-sync/routes.ts
new file mode 100644
index 0000000..9f74667
--- /dev/null
+++ b/apps/api/src/personal-import-sync/routes.ts
@@ -0,0 +1,41 @@
+import { createHash } from 'node:crypto';
+import type { FastifyInstance, FastifyRequest } from 'fastify';
+import type { CampusDatabase } from '../database';
+import { DomainError } from '../domain-error';
+import type { PlatformAccountService } from '../accounts/platform-account-service';
+import { PersonalImportSyncError, PersonalImportSyncService, type ImportSyncActor } from './service';
+
+const prefix = '/v1/auth/platform/personal-imports';
+export function isPersonalImportSyncRoute(method: string, path: string) {
+  return method === 'POST' && (path === `${prefix}/read` || path === `${prefix}/write`);
+}
+export function registerPersonalImportSyncRoutes(app: FastifyInstance, db: CampusDatabase, accounts: PlatformAccountService) {
+  if (process.env.CAMPUS_PERSONAL_IMPORT_SYNC_ENABLED !== 'true') return;
+  const service = new PersonalImportSyncService(db);
+  // The ledger itself is <=8 MiB; the bounded envelope is allowed a further 16 KiB.
+  const options = { bodyLimit: 8 * 1024 * 1024 + 16 * 1024, config: { rateLimit: { max: 30, timeWindow: '1 minute' } } };
+  const run = (action: (actor: ImportSyncActor, body: unknown) => Promise<unknown>) =>
+    async (request: FastifyRequest, reply: { header(name: string, value: string): unknown }) => {
+      reply.header('Cache-Control', 'no-store');
+      if (request.url.includes('?')) throw new DomainError('PERSONAL_IMPORT_INVALID_INPUT', '這個操作不接受查詢字串。', 422);
+      const actor = await accounts.resolveSession(request.headers.authorization);
+      const handle = request.headers.authorization!.trim().split(/\s+/u)[1]!;
+      const sessionHash = createHash('sha256').update(handle).digest('hex');
+      try { return await action({ ...actor, sessionHash }, request.body); }
+      catch (error) {
+        if (error instanceof PersonalImportSyncError) {
+          const message = error.statusCode === 401 ? '登入已失效，請重新登入後再同步。'
+            : error.statusCode === 409 ? '其他裝置的資料已改變，請重新取得資料後再同步。'
+              : error.statusCode === 429 ? '同步資料已達上限，請先整理資料。'
+                : '這份資料無法同步，請先檢查內容。';
+          throw new DomainError(error.code, message, error.statusCode);
+        }
+        const code = error && typeof error === 'object' && 'code' in error ? String(error.code) : '';
+        if (['23505', '40001', '40P01'].includes(code))
+          throw new DomainError('PERSONAL_IMPORT_REVISION_CONFLICT', '資料已改變，請重新取得後再同步。', 409);
+        throw error;
+      }
+    };
+  app.post(`${prefix}/read`, { ...options, bodyLimit: 4096 }, run((actor, body) => service.read(actor, body)));
+  app.post(`${prefix}/write`, options, run((actor, body) => service.write(actor, body)));
+}
diff --git a/apps/api/src/personal-import-sync/service.ts b/apps/api/src/personal-import-sync/service.ts
new file mode 100644
index 0000000..1e95d08
--- /dev/null
+++ b/apps/api/src/personal-import-sync/service.ts
@@ -0,0 +1,160 @@
+import { createHash } from 'node:crypto';
+import { validatePersonalImportSyncRecords } from './imports/sync';
+import type { PersonalImportRecord } from './imports/types';
+
+export type ImportSyncActor = {
+  platformAccountId: string;
+  credentialId: string;
+  expiresAt: number;
+  /** Derived from the already validated Platform session, never accepted from JSON. */
+  sessionHash: string;
+};
+export interface ImportSyncSql {
+  query<Row = Record<string, unknown>>(sql: string, parameters?: unknown[]): Promise<{ rows: Row[] }>;
+}
+export interface ImportSyncDatabase {
+  transaction<T>(run: (tx: ImportSyncSql) => Promise<T>): Promise<T>;
+}
+export class PersonalImportSyncError extends Error {
+  constructor(public readonly code: string, public readonly statusCode = 422) { super(code); }
+}
+export type PersonalImportSnapshot = {
+  schoolId: string;
+  revision: number;
+  records: PersonalImportRecord[];
+  updatedAt: string | null;
+  /** Row IDs whose reference no longer points to a currently accessible class. */
+  detachedCourseLinks: string[];
+};
+type Ledger = { school_id: string; revision: number; records: PersonalImportRecord[]; updated_at: Date | string };
+const fail = (code = 'PERSONAL_IMPORT_INVALID_INPUT', statusCode = 422): never => {
+  throw new PersonalImportSyncError(code, statusCode);
+};
+function record(value: unknown, allowed: readonly string[]): Record<string, unknown> {
+  if (!value || typeof value !== 'object' || Array.isArray(value)) return fail();
+  const prototype = Object.getPrototypeOf(value);
+  if (prototype !== Object.prototype && prototype !== null) return fail();
+  const result: Record<string, unknown> = Object.create(null);
+  for (const name of Reflect.ownKeys(value)) {
+    if (typeof name !== 'string' || !allowed.includes(name)) return fail();
+    const descriptor = Object.getOwnPropertyDescriptor(value, name)!;
+    if (!('value' in descriptor)) return fail();
+    result[name] = descriptor.value;
+  }
+  if (allowed.some(name => !(name in result))) return fail();
+  return result;
+}
+function school(value: unknown): string {
+  if (typeof value !== 'string' || !/^[a-z0-9][a-z0-9-]{0,79}$/u.test(value) || value === 'personal') return fail();
+  return value;
+}
+function sorted(value: unknown): unknown {
+  if (Array.isArray(value)) return value.map(sorted);
+  if (value && typeof value === 'object') return Object.fromEntries(Object.entries(value)
+    .sort(([left], [right]) => left.localeCompare(right)).map(([key, item]) => [key, sorted(item)]));
+  return value;
+}
+function fingerprint(value: unknown): string {
+  return createHash('sha256').update(JSON.stringify(sorted(value))).digest('hex');
+}
+
+/** Account isolation is taken only from a validated Platform session. No school verification is implied. */
+export class PersonalImportSyncService {
+  constructor(private readonly db: ImportSyncDatabase) {}
+
+  private async actor(tx: ImportSyncSql, actor: ImportSyncActor) {
+    if (!Number.isFinite(actor.expiresAt) || actor.expiresAt <= Date.now() || !/^[0-9a-f]{64}$/u.test(actor.sessionHash))
+      return fail('PERSONAL_IMPORT_SESSION_EXPIRED', 401);
+    // Lock in the same order as account closure, then hold the session against a concurrent logout.
+    const account = await tx.query(`SELECT id FROM platform_accounts WHERE id=$1 AND state='active' FOR SHARE`, [actor.platformAccountId]);
+    if (!account.rows.length) return fail('PERSONAL_IMPORT_SESSION_EXPIRED', 401);
+    const credential = await tx.query(`SELECT id FROM platform_account_credentials
+      WHERE id=$1 AND platform_account_id=$2 AND state='active' FOR SHARE`, [actor.credentialId, actor.platformAccountId]);
+    if (!credential.rows.length) return fail('PERSONAL_IMPORT_SESSION_EXPIRED', 401);
+    const session = await tx.query(`SELECT token_sha256 FROM platform_account_sessions
+      WHERE token_sha256=$1 AND platform_account_id=$2 AND credential_id=$3 AND expires_at>now() FOR SHARE`,
+    [actor.sessionHash, actor.platformAccountId, actor.credentialId]);
+    if (!session.rows.length) return fail('PERSONAL_IMPORT_SESSION_EXPIRED', 401);
+  }
+
+  private async accessibleLinks(tx: ImportSyncSql, actor: ImportSyncActor, schoolId: string, records: PersonalImportRecord[]) {
+    const ids = [...new Set(records.flatMap(item => item.linkedCourseId ? [item.linkedCourseId] : []))];
+    if (!ids.length) return { records, detachedCourseLinks: [] as string[] };
+    const access = await tx.query<{ id: string }>(`SELECT w.id FROM class_workspaces w
+      JOIN class_workspace_members m ON m.workspace_id=w.id AND m.platform_account_id=$1 AND m.state='active'
+      WHERE w.id=ANY($2::text[]) AND w.state='active'
+        AND NOT EXISTS (SELECT 1 FROM class_workspace_affiliations a
+          WHERE a.workspace_id=w.id AND (a.state<>'active' OR a.tenant_id<>$3))
+      FOR SHARE OF w,m`, [actor.platformAccountId, ids, schoolId]);
+    const permitted = new Set(access.rows.map(item => item.id));
+    const detachedCourseLinks: string[] = [];
+    const normalized = records.map(item => {
+      if (!item.linkedCourseId || permitted.has(item.linkedCourseId)) return item;
+      detachedCourseLinks.push(item.id);
+      const { linkedCourseId: _reference, ...personalData } = item;
+      return personalData;
+    });
+    return { records: normalized, detachedCourseLinks };
+  }
+
+  private async snapshot(tx: ImportSyncSql, actor: ImportSyncActor, schoolId: string): Promise<PersonalImportSnapshot> {
+    const ledger = (await tx.query<Ledger>(`SELECT school_id,revision,records,updated_at FROM personal_import_ledgers
+      WHERE platform_account_id=$1 AND school_id=$2`, [actor.platformAccountId, schoolId])).rows[0];
+    if (!ledger) return { schoolId, revision: 0, records: [], updatedAt: null, detachedCourseLinks: [] };
+    return { schoolId, revision: ledger.revision, updatedAt: new Date(ledger.updated_at).toISOString(),
+      ...await this.accessibleLinks(tx, actor, schoolId, ledger.records) };
+  }
+
+  async read(actor: ImportSyncActor, raw: unknown): Promise<PersonalImportSnapshot> {
+    const input = record(raw, ['schoolId']), schoolId = school(input.schoolId);
+    return this.db.transaction(async tx => {
+      await this.actor(tx, actor);
+      return this.snapshot(tx, actor, schoolId);
+    });
+  }
+
+  async write(actor: ImportSyncActor, raw: unknown): Promise<PersonalImportSnapshot> {
+    const input = record(raw, ['schoolId', 'expectedRevision', 'records', 'mutationId']);
+    const schoolId = school(input.schoolId), revision = input.expectedRevision, mutationId = input.mutationId;
+    if (!Number.isSafeInteger(revision) || (revision as number) < 0 || (revision as number) >= 2_147_483_647 ||
+      typeof mutationId !== 'string' || !/^[A-Za-z0-9_-]{8,100}$/u.test(mutationId)) return fail();
+    let records: PersonalImportRecord[];
+    try { records = validatePersonalImportSyncRecords(input.records, schoolId); }
+    catch { return fail(); }
+    const requestHash = fingerprint({ schoolId, expectedRevision: revision, records });
+    return this.db.transaction(async tx => {
+      await this.actor(tx, actor);
+      // One account lock also makes the bounded-school quota and mutation pruning race-safe.
+      await tx.query(`SELECT pg_advisory_xact_lock(hashtextextended($1,0))`, [`personal-import:${actor.platformAccountId}`]);
+      const replay = (await tx.query<{ request_hash: string }>(`SELECT request_hash FROM personal_import_mutations
+        WHERE platform_account_id=$1 AND school_id=$2 AND mutation_id=$3`, [actor.platformAccountId, schoolId, mutationId])).rows[0];
+      if (replay) {
+        if (replay.request_hash !== requestHash) return fail('PERSONAL_IMPORT_MUTATION_CONFLICT', 409);
+        // Return current state, never restore a historical snapshot on a delayed retry.
+        return this.snapshot(tx, actor, schoolId);
+      }
+      const existing = (await tx.query<{ revision: number }>(`SELECT revision FROM personal_import_ledgers
+        WHERE platform_account_id=$1 AND school_id=$2 FOR UPDATE`, [actor.platformAccountId, schoolId])).rows[0];
+      if ((existing?.revision ?? 0) !== revision) return fail('PERSONAL_IMPORT_REVISION_CONFLICT', 409);
+      if (!existing) {
+        const count = (await tx.query<{ count: number }>(`SELECT count(*)::int AS count FROM personal_import_ledgers
+          WHERE platform_account_id=$1`, [actor.platformAccountId])).rows[0]?.count ?? 0;
+        if (count >= 20) return fail('PERSONAL_IMPORT_SCHOOL_LIMIT', 429);
+      }
+      const normalized = await this.accessibleLinks(tx, actor, schoolId, records);
+      await tx.query(`INSERT INTO personal_import_ledgers (platform_account_id,school_id,revision,records)
+        VALUES ($1,$2,$3,$4::jsonb) ON CONFLICT (platform_account_id,school_id) DO UPDATE
+        SET revision=EXCLUDED.revision,records=EXCLUDED.records,updated_at=now()`,
+      [actor.platformAccountId, schoolId, (revision as number) + 1, JSON.stringify(normalized.records)]);
+      await tx.query(`INSERT INTO personal_import_mutations (platform_account_id,school_id,mutation_id,request_hash)
+        VALUES ($1,$2,$3,$4)`, [actor.platformAccountId, schoolId, mutationId, requestHash]);
+      // Only hashes and mutation keys are retained. A pruned old request still fails its revision check.
+      await tx.query(`DELETE FROM personal_import_mutations WHERE platform_account_id=$1 AND school_id=$2
+        AND mutation_id IN (SELECT mutation_id FROM personal_import_mutations
+          WHERE platform_account_id=$1 AND school_id=$2 ORDER BY created_at DESC,mutation_id DESC OFFSET 100)`,
+      [actor.platformAccountId, schoolId]);
+      const result = await this.snapshot(tx, actor, schoolId);
+      return { ...result, detachedCourseLinks: [...new Set([...normalized.detachedCourseLinks, ...result.detachedCourseLinks])] };
+    });
+  }
+}
