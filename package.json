{
  "name": "graduation-campus-app",
  "private": true,
  "engines": {
    "node": ">=20 <21"
  },
  "packageManager": "pnpm@10.28.2",
  "pnpm": {
    "overrides": {
      "@next/eslint-plugin-next": "16.2.3",
      "eslint-config-next": "16.2.3",
      "fast-xml-parser": "5.7.0",
      "js-yaml": "^4.1.1",
      "next": "16.2.3",
      "@tootallnate/once": "3.0.1",
      "minimatch": "9.0.9",
      "qs": "6.14.2",
      "serialize-javascript": "7.0.5",
      "semver": "7.7.3",
      "svgo": "2.8.2",
      "tar": "7.5.12",
      "undici": "7.24.3",
      "protobufjs": "7.5.5",
      "path-to-regexp@0.1.12": "0.1.13",
      "node-forge": "1.4.0",
      "picomatch@^2.0.0": "2.3.2",
      "picomatch@^3.0.0": "3.0.2",
      "picomatch@^4.0.0": "4.0.4",
      "yaml@^1.0.0": "1.10.3",
      "yaml@^2.0.0": "2.8.3",
      "follow-redirects": "1.16.0",
      "postcss": "8.5.10",
      "uuid@11.1.0": "11.1.1",
      "lodash": "4.18.1",
      "@xmldom/xmldom": "0.8.13",
      "webpack-dev-server": "5.2.1",
      "brace-expansion@^2.0.0": "2.0.3",
      "react": "19.1.0",
      "react-dom": "19.1.0"
    }
  },
  "scripts": {
    "dev": "pnpm dev:web",
    "dev:mobile": "pnpm --filter mobile start",
    "dev:web": "pnpm --filter web dev",
    "dev:functions": "pnpm --filter functions serve",
    "dev:ai": "cd backend/ai-server && ./run.sh",
    "ai:prepare": "cd backend/ai-server && ./run.sh --prepare",
    "ai:train": "cd backend/ai-server && ./run.sh --train",
    "ai:eval": "cd backend/ai-server && ./run.sh --eval",
    "ai:grow": "cd backend/ai-server && ./run.sh --grow",
    "live-review:file": "node ./scripts/live-file-review.mjs",
    "lint": "pnpm lint:mobile && pnpm lint:web && pnpm lint:functions && pnpm lint:shared",
    "lint:mobile": "pnpm --filter mobile lint",
    "lint:web": "pnpm --filter web lint",
    "lint:functions": "pnpm --filter functions lint",
    "lint:shared": "pnpm --filter @campus/shared lint",
    "typecheck": "pnpm typecheck:mobile && pnpm typecheck:web && pnpm typecheck:shared",
    "typecheck:mobile": "pnpm --filter mobile typecheck",
    "typecheck:web": "pnpm --filter web typecheck",
    "typecheck:shared": "pnpm --filter @campus/shared typecheck",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "firebase": "firebase",
    "test:rules": "if [ -d /opt/homebrew/opt/openjdk@21/bin ]; then export PATH=\"/opt/homebrew/opt/openjdk@21/bin:$PATH\"; export JAVA_HOME=\"/opt/homebrew/opt/openjdk@21/libexec/openjdk.jdk/Contents/Home\"; elif [ -d /usr/local/opt/openjdk@21/bin ]; then export PATH=\"/usr/local/opt/openjdk@21/bin:$PATH\"; export JAVA_HOME=\"/usr/local/opt/openjdk@21/libexec/openjdk.jdk/Contents/Home\"; fi; firebase emulators:exec --only firestore,storage \"node --test backend/tests/security-rules.test.js\"",
    "version:patch": "node ./scripts/bump-version.mjs patch",
    "version:minor": "node ./scripts/bump-version.mjs minor",
    "version:major": "node ./scripts/bump-version.mjs major",
    "release:preview": "pnpm --filter mobile exec eas build --profile preview --platform all --non-interactive",
    "release:production": "pnpm --filter mobile exec eas build --profile production --platform all --non-interactive",
    "submit:ios": "pnpm --filter mobile exec eas submit --platform ios --latest --non-interactive",
    "submit:android": "pnpm --filter mobile exec eas submit --platform android --latest --non-interactive"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@firebase/rules-unit-testing": "^5.0.0",
    "eslint": "^9.39.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "firebase-tools": "^15.4.0",
    "globals": "^17.4.0",
    "prettier": "^3.8.1",
    "typescript-eslint": "^8.57.1"
  },
  "dependencies": {}
}
