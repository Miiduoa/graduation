{
  "cli": {
    "version": ">= 16.18.0",
    "appVersionSource": "remote"
  },
  "build": {
    "base": {
      "node": "22.12.0",
      "pnpm": "10.28.2"
    },
    "development": {
      "extends": "base",
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "env": {
        "APP_ENV": "development"
      },
      "ios": {
        "simulator": true
      }
    },
    "preview": {
      "extends": "base",
      "distribution": "internal",
      "channel": "preview",
      "env": {
        "APP_ENV": "preview"
      },
      "ios": {
        "resourceClass": "m-medium"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "extends": "base",
      "channel": "production",
      "autoIncrement": true,
      "env": {
        "APP_ENV": "production",
        "EXPO_PUBLIC_API_ENV": "production",
        "EXPO_PUBLIC_DATA_SOURCE_MODE": "firebase",
        "EXPO_PUBLIC_FORCE_REAL_DATA": "true",
        "EXPO_PUBLIC_HYBRID_FALLBACK_TO_MOCK": "false",
        "EXPO_PUBLIC_ENABLE_UNIVERSAL_DEV_ACCOUNTS": "false",
        "EXPO_PUBLIC_ALLOW_LOCAL_MOCK_AUTH": "false",
        "EXPO_PUBLIC_EAS_PROJECT_ID": "8955b97c-802c-463c-bd1d-d5f02e30a966",
        "IOS_BUNDLE_IDENTIFIER": "com.nuni.app",
        "ANDROID_PACKAGE_NAME": "com.nuni.app",
        "EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID": "1096741064465-b8ue803rbqdpcq75t1g03o5t49vi0s4q.apps.googleusercontent.com",
        "EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID": "1096741064465-39b13khidhmohvo1go3nlmomgk3p07d4.apps.googleusercontent.com",
        "EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID": "1096741064465-0t5dq62t7oklrh8tnib7d4v27tm0apma.apps.googleusercontent.com"
      },
      "ios": {
        "resourceClass": "m-medium"
      },
      "android": {
        "buildType": "app-bundle"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "language": "zh-Hant"
      },
      "android": {
        "track": "internal",
        "releaseStatus": "draft",
        "changesNotSentForReview": true
      }
    }
  }
}
