+import { createApp, isPublicApiRoute } from "../app";
+import { createDatabase, type CampusDatabase } from "../database";
+import { provisionPlatformPasswordAdmin } from "./platform-password-provisioning";
+
+describe("administrator password HTTP boundary", () => {
+  let db: CampusDatabase;
+  let app: Awaited<ReturnType<typeof createApp>>;
+  const password = "HTTP test-only password";
+  let accountId: string;
+  beforeAll(async () => {
