diff --git a/apps/api/src/accounts/platform-existing-food-orders.test.ts b/apps/api/src/accounts/platform-existing-food-orders.test.ts
new file mode 100644
index 0000000..5076707
--- /dev/null
+++ b/apps/api/src/accounts/platform-existing-food-orders.test.ts
@@ -0,0 +1,188 @@
+import { createHash, randomBytes, randomUUID } from "node:crypto";
+import { afterEach, beforeEach, describe, expect, it } from "vitest";
+import { createApp } from "../app";
+import { createDatabase, type CampusDatabase } from "../database";
+import { readPaymentRuntime } from "../payments/config";
+
+const secret = "existing-platform-food-orders-test-secret-over-thirty-two";
+const realm = "/v1/auth/platform/realms/campus-demo";
+
+describe("platform customers retain their existing orders when public ordering pauses", () => {
+  let db: CampusDatabase;
+  let app: Awaited<ReturnType<typeof createApp>>;
+  let owner: Awaited<ReturnType<typeof account>>;
+  let other: Awaited<ReturnType<typeof account>>;
+  let orderId: string;
+  let quoteId: string;
+  let paymentCalls: number;
+
+  async function account() {
+    const id = `pa_${randomUUID()}`;
+    const credentialId = `pac_${randomUUID()}`;
+    const handle = `ps_${randomBytes(32).toString("base64url")}`;
+    const digest = createHash("sha256").update(handle).digest("hex");
+    await db.query(`INSERT INTO platform_accounts (id,display_name) VALUES ($1,'顧客')`, [id]);
+    await db.query(`INSERT INTO platform_account_credentials
+      (id,platform_account_id,method,provider_issuer,provider_subject,verified_at,last_authenticated_at)
+      VALUES ($1,$2,'google','https://accounts.google.com',$3,now(),now())`, [credentialId, id, randomUUID()]);
+    await db.query(`INSERT INTO platform_account_sessions
+      (token_sha256,platform_account_id,credential_id,expires_at)
+      VALUES ($1,$2,$3,now()+interval '1 hour')`, [digest, id, credentialId]);
+    return { id, credentialId, digest, headers: { authorization: `Platform ${handle}` } };
+  }
+
+  beforeEach(async () => {
+    db = await createDatabase({ attendanceCodeSecret: secret, seedDemo: true });
+    paymentCalls = 0;
+    app = await createApp(db, {
+      auth: { mode: "demo", sessionSecret: secret },
+      enableDemoAuth: false,
+      attendanceCodeSecret: secret,
+      foodPickupTokenSecret: secret,
+      paymentEndpoints: {
+        apiBaseUrl: "https://api.campus.example.edu",
+        webBaseUrl: "https://campus.example.edu",
+        handoffSecret: secret,
+      },
+      // No real provider or payment is contacted by these route tests.
+      paymentRuntime: readPaymentRuntime({
+        PAYMENT_ONLINE_ENABLED: "true", PAYMENT_ENABLED_METHODS: "credit-card",
+        TAPPAY_PARTNER_KEY: "fixture-key", TAPPAY_MERCHANT_ID: "FIXTURE",
+        TAPPAY_API_BASE_URL: "https://sandbox.tappaysdk.com",
+      }, false, async () => {
+        paymentCalls += 1;
+        return new Response(JSON.stringify({ status: 0, payment_url: "https://sandbox.tappaysdk.com/link/fixture" }), {
+          status: 200, headers: { "content-type": "application/json" },
+        });
+      }),
+    });
+    owner = await account();
+    other = await account();
+    const quote = await app.inject({ method: "POST", url: `${realm}/food/quotes`, headers: owner.headers,
+      payload: { locationId: "food-location-main", requestedPickupAt: new Date(Date.now() + 30 * 60_000).toISOString(),
+        items: [{ menuItemId: "food-item-chicken", quantity: 1, selectedOptionIds: [] }], idempotencyKey: "existing-order-quote" } });
+    expect(quote.statusCode, quote.body).toBe(201);
+    quoteId = quote.json().id;
+    const order = await app.inject({ method: "POST", url: `${realm}/food/orders`, headers: owner.headers,
+      payload: { quoteId, idempotencyKey: "existing-order-create" } });
+    expect(order.statusCode, order.body).toBe(201);
+    orderId = order.json().orderId;
+    // Give the second account its own persisted persona before closing discovery.
+    expect((await app.inject({ method: "GET", url: `${realm}/food/locations`, headers: other.headers })).statusCode).toBe(200);
+    await db.query(`UPDATE food_locations SET status='closed',public_access=false WHERE tenant_id='campus-demo'`);
+    expect((await db.query(`SELECT 1 FROM social_communities WHERE tenant_id='campus-demo'
+      AND access_scope='public' AND discoverability='listed'`)).rows).toHaveLength(0);
+  }, 60_000);
+
+  afterEach(async () => { await app?.close(); await db?.close(); });
+
+  it("lists and reads only the caller's existing orders without reopening discovery", async () => {
+    const list = await app.inject({ method: "GET", url: `${realm}/food/orders`, headers: owner.headers });
+    expect(list.statusCode, list.body).toBe(200);
+    expect(list.json().orders).toEqual([expect.objectContaining({ id: orderId, state: "payment-pending" })]);
+    const detail = await app.inject({ method: "GET", url: `${realm}/food/orders/${orderId}`, headers: owner.headers });
+    expect(detail.statusCode, detail.body).toBe(200);
+    expect(detail.json()).toMatchObject({ id: orderId, state: "payment-pending" });
+    const empty = await app.inject({ method: "GET", url: `${realm}/food/orders`, headers: other.headers });
+    expect(empty.statusCode, empty.body).toBe(200);
+    expect(empty.json().orders).toEqual([]);
+    const realms = await app.inject({ method: "GET", url: "/v1/auth/platform/realms", headers: owner.headers });
+    expect(realms.json().realms).not.toContainEqual(expect.objectContaining({ tenantId: "campus-demo" }));
+    for (const suffix of ["food/locations", "food/locations/food-location-main/menu", "social/profile", "social/communities"]) {
+      const response = await app.inject({ method: "GET", url: `${realm}/${suffix}`, headers: owner.headers });
+      expect(response.statusCode, response.body).toBe(404);
+    }
+    const quote = await app.inject({ method: "POST", url: `${realm}/food/quotes`, headers: owner.headers,
+      payload: { locationId: "food-location-main", requestedPickupAt: new Date(Date.now() + 30 * 60_000).toISOString(),
+        items: [{ menuItemId: "food-item-chicken", quantity: 1, selectedOptionIds: [] }], idempotencyKey: "paused-new-quote" } });
+    expect(quote.statusCode, quote.body).toBe(404);
+    const create = await app.inject({ method: "POST", url: `${realm}/food/orders`, headers: owner.headers,
+      payload: { quoteId, idempotencyKey: "paused-new-order" } });
+    expect(create.statusCode, create.body).toBe(404);
+  });
+
+  it("can continue the existing checkout and cancel once, retaining idempotency", async () => {
+    const checkout = await app.inject({ method: "POST", url: `${realm}/food/orders/${orderId}/payment-session`, headers: owner.headers,
+      payload: { method: "credit-card", idempotencyKey: "paused-checkout-key" } });
+    expect(checkout.statusCode, checkout.body).toBe(201);
+    expect(paymentCalls).toBe(1);
+    const payload = { reason: "changed-mind", idempotencyKey: "paused-cancel-key" };
+    const cancel = await app.inject({ method: "POST", url: `${realm}/food/orders/${orderId}/cancel`, headers: owner.headers, ...(payload ? { payload } : {}) });
+    expect(cancel.statusCode, cancel.body).toBe(200);
+    expect(cancel.json()).toMatchObject({ orderId, state: "canceled" });
+    const replay = await app.inject({ method: "POST", url: `${realm}/food/orders/${orderId}/cancel`, headers: owner.headers, ...(payload ? { payload } : {}) });
+    expect(replay.statusCode, replay.body).toBe(200);
+    expect(replay.json()).toEqual({ ...cancel.json(), replayed: true });
+    const later = await app.inject({ method: "POST", url: `${realm}/food/orders/${orderId}/payment-session`, headers: owner.headers,
+      payload: { method: "credit-card", idempotencyKey: "canceled-checkout-key" } });
+    expect(later.statusCode, later.body).toBe(409);
+    expect(paymentCalls).toBe(1);
+  });
+
+  it("does not disclose or mutate another customer's order or call its payment provider", async () => {
+    for (const [method, suffix, payload] of [
+      ["GET", "", undefined],
+      ["POST", "/cancel", { reason: "changed-mind", idempotencyKey: "outsider-cancel-key" }],
+      ["POST", "/payment-session", { method: "credit-card", idempotencyKey: "outsider-checkout-key" }],
+    ] as const) {
+      const response = await app.inject({ method, url: `${realm}/food/orders/${orderId}${suffix}`, headers: other.headers, ...(payload ? { payload } : {}) });
+      expect(response.statusCode, response.body).toBe(404);
+      expect(response.json()).toMatchObject({ error: { code: "FOOD_ORDER_NOT_FOUND" } });
+    }
+    expect(paymentCalls).toBe(0);
+    expect((await db.query(`SELECT state FROM food_orders WHERE id=$1`, [orderId])).rows).toEqual([{ state: "awaiting_payment" }]);
+  });
+
+  it("does not create a persona for a new account trying to access old orders", async () => {
+    const newcomer = await account();
+    const before = (await db.query(`SELECT count(*)::int AS count FROM people`)).rows;
+    for (const suffix of ["", `/${orderId}`]) {
+      const response = await app.inject({ method: "GET", url: `${realm}/food/orders${suffix}`, headers: newcomer.headers });
+      expect(response.statusCode, response.body).toBe(404);
+    }
+    expect((await db.query(`SELECT 1 FROM platform_tenant_personas WHERE platform_account_id=$1`, [newcomer.id])).rows).toEqual([]);
+    expect((await db.query(`SELECT count(*)::int AS count FROM people`)).rows).toEqual(before);
+  });
+
+  it("does not reuse a persona or order from a different tenant", async () => {
+    await db.query(`INSERT INTO people
+      (tenant_id,id,student_number,display_name,program,curriculum_version,study_year,campus,credential_status)
+      VALUES ('nccu','legacy-order-person','legacy-order-person','顧客','一般使用者','platform',1,'校區','active')`);
+    await db.query(`INSERT INTO platform_tenant_personas (platform_account_id,tenant_id,person_id)
+      VALUES ($1,'nccu','legacy-order-person')`, [owner.id]);
+    const otherRealm = "/v1/auth/platform/realms/nccu";
+    for (const [method, suffix, payload] of [
+      ["GET", "", undefined],
+      ["POST", "/cancel", { reason: "changed-mind", idempotencyKey: "wrong-tenant-cancel" }],
+      ["POST", "/payment-session", { method: "credit-card", idempotencyKey: "wrong-tenant-checkout" }],
+    ] as const) {
+      const response = await app.inject({ method, url: `${otherRealm}/food/orders/${orderId}${suffix}`, headers: owner.headers, ...(payload ? { payload } : {}) });
+      expect(response.statusCode, response.body).toBe(404);
+      expect(response.json()).toMatchObject({ error: { code: "FOOD_ORDER_NOT_FOUND" } });
+    }
+    expect(paymentCalls).toBe(0);
+  });
+
+  it.each([
+    ["account", 401, `UPDATE platform_accounts SET state='suspended',suspended_at=now() WHERE id=$1`, "account"],
+    ["credential", 401, `UPDATE platform_account_credentials SET state='revoked',revoked_at=now() WHERE id=$1`, "credential"],
+    ["session", 401, `DELETE FROM platform_account_sessions WHERE token_sha256=$1`, "session"],
+    ["persona", 404, `UPDATE people SET credential_status='suspended' WHERE (tenant_id,id) IN
+      (SELECT tenant_id,person_id FROM platform_tenant_personas WHERE platform_account_id=$1)`, "account"],
+    ["tenant", 404, `UPDATE tenants SET state='suspended' WHERE id=$1`, "tenant"],
+    ["food module", 403, `UPDATE tenants SET module_food_enabled=false WHERE id=$1`, "tenant"],
+  ] as const)("still denies all existing-order actions after %s revocation", async (_kind, status, sql, identity) => {
+    const current = await app.inject({ method: "GET", url: `${realm}/food/orders/${orderId}`, headers: owner.headers });
+    expect(current.statusCode, current.body).toBe(200);
+    await db.query(sql, [identity === "account" ? owner.id : identity === "credential" ? owner.credentialId : identity === "session" ? owner.digest : "campus-demo"]);
+    for (const [method, suffix, payload] of [
+      ["GET", "", undefined], ["GET", `/${orderId}`, undefined],
+      ["POST", `/${orderId}/cancel`, { reason: "changed-mind", idempotencyKey: "revoked-cancel-key" }],
+      ["POST", `/${orderId}/payment-session`, { method: "credit-card", idempotencyKey: "revoked-checkout-key" }],
+    ] as const) {
+      const response = await app.inject({ method, url: `${realm}/food/orders${suffix}`, headers: owner.headers, ...(payload ? { payload } : {}) });
+      expect(response.statusCode, response.body).toBe(status);
+    }
+    expect(paymentCalls).toBe(0);
+  });
+});
