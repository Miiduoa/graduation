  "scripts": {
    "dev": "pnpm dev:web",
    "dev:mobile": "pnpm --filter mobile start",
    "ios:sim": "pnpm ios:mobile:sim",
    "ios:mobile:sim": "pnpm --filter mobile ios:sim",
    "dev:web": "pnpm --filter web dev",
    "dev:functions": "pnpm --filter functions serve",
    "test-env:start": "bash ./scripts/test-env/start.sh",
    "test-env:seed": "bash -c \"source scripts/test-env/env.sh && node scripts/test-env/seed.cjs\"",
    "dev:ai": "cd backend/ai-server && ./run.sh",
    "ai:prepare": "cd backend/ai-server && ./run.sh --prepare",
    "ai:train": "cd backend/ai-server && ./run.sh --train",
    "ai:eval": "cd backend/ai-server && ./run.sh --eval",
    "ai:grow": "cd backend/ai-server && ./run.sh --grow",
    "live-review:file": "node ./scripts/live-file-review.mjs",
    "test:ai:marathon": "bash ./scripts/ai-app-scenario-marathon.sh",
    "lint": "pnpm lint:mobile && pnpm lint:web && pnpm lint:functions && pnpm lint:shared",
    "lint:mobile": "pnpm --filter mobile lint",
    "lint:web": "pnpm --filter web lint",
    "lint:functions": "pnpm --filter functions lint",
    "lint:shared": "pnpm --filter @campus/shared lint",
    "typecheck": "pnpm typecheck:mobile && pnpm typecheck:web && pnpm typecheck:shared",
    "typecheck:mobile": "pnpm --filter mobile typecheck",
    "typecheck:web": "pnpm --filter web typecheck",
    "typecheck:shared": "pnpm --filter @campus/shared typecheck",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "firebase": "firebase",
    "test:rules": "if [ -d /opt/homebrew/opt/openjdk@21/bin ]; then export PATH=\"/opt/homebrew/opt/openjdk@21/bin:$PATH\"; export JAVA_HOME=\"/opt/homebrew/opt/openjdk@21/libexec/openjdk.jdk/Contents/Home\"; elif [ -d /usr/local/opt/openjdk@21/bin ]; then export PATH=\"/usr/local/opt/openjdk@21/bin:$PATH\"; export JAVA_HOME=\"/usr/local/opt/openjdk@21/libexec/openjdk.jdk/Contents/Home\"; fi; export ONLINE_ORDERING_ENABLED=true; pnpm --filter functions run build:shared && firebase emulators:exec --project demo-campus-security --only firestore,storage \"ONLINE_ORDERING_ENABLED=true node --test backend/tests/security-rules.test.js backend/tests/school-responsibility-rules.test.cjs backend/functions/transactionalWrites.emulator.cjs backend/functions/agentWrites.emulator.cjs backend/functions/notificationDelivery.emulator.cjs backend/functions/eventRegistration.emulator.cjs backend/tests/event-registration-rules.test.cjs backend/tests/campus-post-bookmarks-rules.test.cjs backend/tests/campus-follows-rules.test.cjs backend/functions/accountDeletion.emulator.cjs backend/functions/groupOwnership.emulator.cjs && pnpm --filter web exec vitest run src/lib/server/groupInvite.emulator.test.ts src/lib/server/timetableShare.emulator.test.ts src/lib/server/attendanceSession.emulator.test.ts src/lib/community/follows.emulator.test.ts\"",
    "version:patch": "node ./scripts/bump-version.mjs patch",
    "version:minor": "node ./scripts/bump-version.mjs minor",
    "version:major": "node ./scripts/bump-version.mjs major",
    "release:preview": "pnpm --filter mobile exec eas build --profile preview --platform all --non-interactive",
    "release:production": "pnpm --filter mobile exec eas build --profile production --platform all --non-interactive",
    "submit:ios": "pnpm --filter mobile exec eas submit --platform ios --profile production --id \"${EAS_BUILD_ID:?Set EAS_BUILD_ID to the verified iOS build ID}\" --wait --non-interactive",
    "submit:android": "pnpm --filter mobile exec eas submit --platform android --profile production --id \"${EAS_BUILD_ID:?Set EAS_BUILD_ID to the verified Android build ID}\" --wait --non-interactive",
    "documents:build": "node scripts/document-import/build.mjs",
    "documents:check": "node scripts/document-import/build.mjs --check",
    "test:documents": "node --test scripts/document-import/reader.test.mjs"
  },
