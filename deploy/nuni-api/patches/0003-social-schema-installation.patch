@@ -138,12 +138,13 @@ describe("install automatically-registered builtin event schemas", () => {
 });

 describe("event schema seed CLI env parsing", () => {
-  it("reads one or more tenant ids and food/automatic sets", () => {
+  it("reads one or more tenant ids and food/social/automatic sets", () => {
     expect(parseEventSchemaSeedTenantIds({})).toEqual(["pu"]);
     expect(parseEventSchemaSeedTenantIds({ CAMPUS_EVENT_SCHEMA_TENANT_IDS: "pu, campus-demo" }))
       .toEqual(["pu", "campus-demo"]);
     expect(parseEventSchemaSeedTenantIds({ PU_FOOD_TENANT_ID: "nthu" })).toEqual(["nthu"]);
     expect(parseEventSchemaSeedSet({})).toBe("food");
+    expect(parseEventSchemaSeedSet({ CAMPUS_EVENT_SCHEMA_SET: "social" })).toBe("social");
     expect(parseEventSchemaSeedSet({ CAMPUS_EVENT_SCHEMA_SET: "automatic" })).toBe("automatic");
     expect(() => parseEventSchemaSeedSet({ CAMPUS_EVENT_SCHEMA_SET: "all" }))
       .toThrow(/CAMPUS_EVENT_SCHEMA_SET/);
