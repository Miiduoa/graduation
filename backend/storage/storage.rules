rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isActiveAccount() {
      return isAuthenticated()
        && (!firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
          || (firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.get('accountDeletionInProgress', false) != true
            && !(firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.get('status', '')
              in ['deleted', 'disabled', 'suspended', 'inactive'])));
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isActiveAccount() && request.auth.token.role == 'admin';
    }

    function isValidImage() {
      return request.resource.contentType.matches('image/.*');
    }

    function isValidVideo() {
      return request.resource.contentType.matches('video/.*');
    }

    function isValidAudio() {
      return request.resource.contentType.matches('audio/.*');
    }

    function isValidDocument() {
      return request.resource.contentType in [
        'application/pdf',
        'text/plain',
        'application/msword',
        'application/vnd.ms-excel',
        'application/vnd.ms-powerpoint',
        'application/vnd.openxmlformats-officedocument.wordprocessingml.document',
        'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet',
        'application/vnd.openxmlformats-officedocument.presentationml.presentation'
      ];
    }

    function isSchoolMemberStorage(schoolId) {
      // School membership may remain active after account suspension.
      // This path uses at most two Firestore lookups (account and school member).
      return isActiveAccount()
        // A missing canonical profile must not turn an orphaned membership into access.
        && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/schools/$(schoolId)/members/$(request.auth.uid)).data.status == 'active';
    }

    function campusMediaOk() {
      return (isValidImage() && maxSize(10))
        || (isValidVideo() && maxSize(100))
        || (isValidAudio() && maxSize(20))
        || (isValidDocument() && maxSize(50));
    }

    function isAllowedUpload() {
      return isValidImage() || isValidDocument();
    }

    function maxSize(mb) {
      return request.resource.size < mb * 1024 * 1024;
    }

    function hasSchoolEditorRole(schoolId) {
      return isAuthenticated()
        && firestore.exists(/databases/(default)/documents/schools/$(schoolId)/members/$(request.auth.uid))
        && (
          firestore.get(/databases/(default)/documents/schools/$(schoolId)/members/$(request.auth.uid)).data.role == 'admin'
          || firestore.get(/databases/(default)/documents/schools/$(schoolId)/members/$(request.auth.uid)).data.role == 'editor'
        )
        && firestore.get(/databases/(default)/documents/schools/$(schoolId)/members/$(request.auth.uid)).data.status == 'active';
    }

    function conversationMember(conversationId) {
      return isActiveAccount()
        && firestore.exists(/databases/(default)/documents/conversations/$(conversationId))
        && request.auth.uid in firestore.get(/databases/(default)/documents/conversations/$(conversationId)).data.memberIds;
    }

    function canManageEventAsset(eventId) {
      return isAuthenticated()
        && firestore.exists(/databases/(default)/documents/events/$(eventId))
        && hasSchoolEditorRole(firestore.get(/databases/(default)/documents/events/$(eventId)).data.schoolId);
    }

    function canManageAnnouncementAsset(announcementId) {
      return isAuthenticated()
        && firestore.exists(/databases/(default)/documents/announcements/$(announcementId))
        && hasSchoolEditorRole(firestore.get(/databases/(default)/documents/announcements/$(announcementId)).data.schoolId);
    }

    function canManageMenuAsset(menuId) {
      return isAuthenticated()
        && firestore.exists(/databases/(default)/documents/menus/$(menuId))
        && hasSchoolEditorRole(firestore.get(/databases/(default)/documents/menus/$(menuId)).data.schoolId);
    }

    function canManagePoiAsset(poiId) {
      return isAuthenticated()
        && firestore.exists(/databases/(default)/documents/pois/$(poiId))
        && hasSchoolEditorRole(firestore.get(/databases/(default)/documents/pois/$(poiId)).data.schoolId);
    }

    function canAccessRepairRequest(requestId) {
      return isAuthenticated()
        && firestore.exists(/databases/(default)/documents/repairRequests/$(requestId))
        && (
          firestore.get(/databases/(default)/documents/repairRequests/$(requestId)).data.userId == request.auth.uid
          || isAdmin()
        );
    }

    match /avatars/{fileName} {
      allow read: if true;
      allow write: if isActiveAccount()
        && fileName.matches('^' + request.auth.uid + '\\.[A-Za-z0-9]+$')
        && isValidImage()
        && maxSize(5);
    }

    match /groups/{groupId}/{fileName} {
      // privateGroupFile checks current account, school and group membership server-side.
      allow read, write: if false;
    }

    match /groups/{groupId}/posts/{postId}/{fileName} {
      allow read, write: if false;
    }

    match /assignments/{assignmentId}/submissions/{userId}/{fileName} {
      allow read, write: if false;
    }

    match /lostfound/{itemId}/{fileName} {
      allow read: if true;
      allow create: if resource == null && isActiveAccount() && isValidImage() && maxSize(10);
    }

    match /printjobs/{userId}/{jobId}/{fileName} {
      allow read: if isActiveAccount() && (isOwner(userId) || isAdmin());
      allow write: if isActiveAccount() && isOwner(userId) && isValidDocument() && maxSize(100);
    }

    match /announcements/{announcementId}/{fileName} {
      allow read: if true;
      allow write: if canManageAnnouncementAsset(announcementId) && isAllowedUpload() && maxSize(20);
    }

    match /events/{eventId}/{fileName} {
      allow read: if true;
      allow write: if fileName.matches('^cover\\.[A-Za-z0-9]+$')
        && canManageEventAsset(eventId)
        && isValidImage()
        && maxSize(10);
    }

    match /events/{eventId}/gallery/{fileName} {
      allow read: if true;
      allow write: if canManageEventAsset(eventId) && isValidImage() && maxSize(10);
    }

    match /menus/{menuId}/{fileName} {
      allow read: if true;
      allow write: if fileName.matches('^image\\.[A-Za-z0-9]+$')
        && canManageMenuAsset(menuId)
        && isValidImage()
        && maxSize(5);
    }

    match /pois/{poiId}/{fileName} {
      allow read: if true;
      allow write: if canManagePoiAsset(poiId) && isValidImage() && maxSize(10);
    }

    match /conversations/{conversationId}/messages/{messageId}/{fileName} {
      allow read: if conversationMember(conversationId);
      allow create: if resource == null && conversationMember(conversationId) && isAllowedUpload() && maxSize(20);
    }

    match /bugreports/{reportId}/{fileName} {
      allow read: if isAdmin();
      allow create: if resource == null && isActiveAccount() && isValidImage() && maxSize(10);
    }

    match /repairs/{requestId}/{fileName} {
      allow read: if isActiveAccount() && canAccessRepairRequest(requestId);
      allow write: if isActiveAccount() && canAccessRepairRequest(requestId) && isValidImage() && maxSize(10);
    }

    match /health/{userId}/{recordId}/{fileName} {
      allow read: if isActiveAccount() && (isOwner(userId) || isAdmin());
      allow write: if isActiveAccount() && (isOwner(userId) || isAdmin()) && isAllowedUpload() && maxSize(20);
    }

    match /temp/{userId}/{fileName} {
      allow read: if isActiveAccount() && isOwner(userId);
      allow write: if isActiveAccount() && isOwner(userId) && maxSize(50);
    }

    match /schools/{schoolId}/campusPosts/{postId}/{fileName} {
      allow read: if isSchoolMemberStorage(schoolId);
      allow create: if resource == null && isSchoolMemberStorage(schoolId) && campusMediaOk();
    }

    match /schools/{schoolId}/stories/{storyId}/{fileName} {
      function activeStoryMember() {
        return isAuthenticated()
          && firestore.get(/databases/(default)/documents/schools/$(schoolId)/members/$(request.auth.uid)).data.status == 'active';
      }
      function isPublishedStory() {
        let story = firestore.get(/databases/(default)/documents/campusStories/$(storyId)).data;
        return story.schoolId == schoolId
          && resource.metadata.ownerUid == story.authorUid
          && story.mediaUrl is string && story.mediaUrl.size() > 0
          && ((story.kind == 'image' && resource.contentType.matches('image/.*'))
            || (story.kind == 'video' && resource.contentType.matches('video/.*')));
      }
      allow get: if activeStoryMember()
        && (resource.metadata.get('ownerUid', '') == request.auth.uid || isPublishedStory());
      // Draft uploads may be retried until their Firestore story is published.
      allow create, update: if activeStoryMember()
        && request.resource.metadata.ownerUid == request.auth.uid
        && (resource == null || resource.metadata.ownerUid == request.auth.uid)
        && !firestore.exists(/databases/(default)/documents/campusStories/$(storyId))
        && (isValidImage() && maxSize(10) || isValidVideo() && maxSize(100));
    }

    match /conversations/{conversationId}/media/{uploadId}/{fileName} {
      allow read: if conversationMember(conversationId);
      allow create: if resource == null && conversationMember(conversationId) && campusMediaOk();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
