diff --git a/apps/api/src/accounts/platform-password-provisioning.ts b/apps/api/src/accounts/platform-password-provisioning.ts
new file mode 100644
index 0000000..a454f4c
--- /dev/null
+++ b/apps/api/src/accounts/platform-password-provisioning.ts
@@ -0,0 +1,141 @@
+import { randomUUID } from "node:crypto";
+import type { CampusDatabase, SqlExecutor } from "../database";
+import { DomainError } from "../domain-error";
+import {
+  hashPlatformPassword,
+  lockPasswordLogin,
+  normalizePlatformPasswordEmail,
+  PLATFORM_PASSWORD_ISSUER,
+} from "./platform-password-service";
+
+export type PlatformPasswordProvisionInput = {
+  email: unknown;
+  password?: unknown;
+  displayName?: unknown;
+  reason: unknown;
+  performedBy: unknown;
+  expectedAccountId?: unknown;
+};
+
+type ProvisionAction = "create-account" | "add-credential" | "rotate-password";
+type OperatorGrant = "grant" | "restore" | "unchanged";
+export type PlatformPasswordProvisionResult = {
+  accountId: string | null;
+  status: "planned" | "applied";
+  action: ProvisionAction;
+  maskedEmail: string;
+  operatorGrant: OperatorGrant;
+};
+
+function refuse(code: string, message: string): never {
+  throw new DomainError(code, message, 409);
+}
+
+function boundedText(value: unknown, min: number, max: number): string | null {
+  if (typeof value !== "string") return null;
+  const text = value.trim();
+  return text.length >= min && text.length <= max && !/[\u0000-\u001f\u007f]/u.test(text) ? text : null;
+}
+
+function maskedEmail(email: string): string {
+  const at = email.indexOf("@");
+  return `${email.slice(0, 1)}***${email.slice(at)}`;
+}
+
+async function plan(tx: SqlExecutor, email: string, expectedAccountId?: unknown) {
+  const password = (await tx.query<{
+    credential_id: string; platform_account_id: string; state: string;
+  }>(`SELECT password.credential_id,password.platform_account_id,credential.state
+      FROM platform_password_credentials password
+      JOIN platform_account_credentials credential ON credential.id=password.credential_id
+      WHERE password.email=$1`, [email])).rows[0];
+  // Email is a lookup hint, never sufficient authority to merge credentials.
+  // Include unverified and inactive matches so neither creates a shadow account.
+  const matches = (await tx.query<{ id: string; state: string; verified: boolean }>(
+    `SELECT account.id,account.state,EXISTS (
+        SELECT 1 FROM platform_account_credentials credential
+        WHERE credential.platform_account_id=account.id AND credential.state='active'
+          AND credential.method IN ('google','apple') AND credential.email_verified
+          AND lower(btrim(credential.email_at_registration))=$1
+      ) AS verified
+      FROM platform_accounts account
+      WHERE lower(btrim(account.primary_email))=$1
+        OR EXISTS (SELECT 1 FROM platform_account_credentials credential
+          WHERE credential.platform_account_id=account.id
+            AND lower(btrim(credential.email_at_registration))=$1)
+        OR account.id=$2`, [email, password?.platform_account_id ?? null],
+  )).rows;
+  if (matches.length > 1) refuse("PLATFORM_PASSWORD_IDENTITY_AMBIGUOUS", "帳號的登入身分無法唯一確認，請先核對帳號。");
+  const existing = matches[0];
+  if (existing && existing.state !== "active") refuse("PLATFORM_PASSWORD_ACCOUNT_UNAVAILABLE", "這個帳號目前不能新增登入方式。");
+  if (existing && !password && !existing.verified) refuse("PLATFORM_PASSWORD_IDENTITY_UNVERIFIED", "既有帳號沒有可核對的已驗證信箱，未變更帳號。");
+  if (password?.state !== undefined && password.state !== "active") refuse("PLATFORM_PASSWORD_CREDENTIAL_UNAVAILABLE", "這個登入方式已撤銷，未變更帳號。");
+  if (expectedAccountId !== undefined && expectedAccountId !== existing?.id) refuse("PLATFORM_PASSWORD_TARGET_CHANGED", "帳號與檢查結果不同，請重新檢查。");
+  if (existing && !password) {
+    const otherPassword = (await tx.query(`SELECT 1 FROM platform_password_credentials WHERE platform_account_id=$1`, [existing.id])).rows;
+    if (otherPassword.length) refuse("PLATFORM_PASSWORD_IDENTITY_AMBIGUOUS", "帳號的登入身分無法唯一確認，請先核對帳號。");
+  }
+  const operator = existing ? (await tx.query<{ state: string }>(
+    `SELECT state FROM platform_operator_assignments WHERE platform_account_id=$1 AND role_key='platform-operator'`, [existing.id],
+  )).rows[0] : undefined;
+  return {
+    accountId: existing?.id ?? null,
+    credentialId: password?.credential_id ?? null,
+    action: (password ? "rotate-password" : existing ? "add-credential" : "create-account") as ProvisionAction,
+    operatorGrant: (operator?.state === "active" ? "unchanged" : operator ? "restore" : "grant") as OperatorGrant,
+  };
+}
+
+export async function provisionPlatformPasswordAdmin(
+  db: CampusDatabase,
+  input: PlatformPasswordProvisionInput,
+  options: { apply: boolean; rotatePassword?: boolean },
+): Promise<PlatformPasswordProvisionResult> {
+  const email = normalizePlatformPasswordEmail(input.email);
+  const reason = boundedText(input.reason, 5, 1000);
+  const performedBy = boundedText(input.performedBy, 3, 100);
+  const displayName = input.displayName === undefined ? "平台管理員" : boundedText(input.displayName, 1, 100);
+  if (!email || !reason || !performedBy || !displayName) {
+    throw new DomainError("PLATFORM_PASSWORD_PROVISION_INPUT_INVALID", "請提供有效信箱、顯示名稱、操作者與變更原因。", 400);
+  }
+  // Hash before entering the transaction. No password or hash enters audit/output.
+  const passwordHash = options.apply ? await hashPlatformPassword(input.password as string) : null;
+  return db.transaction(async (tx) => {
+    const key = options.apply ? await lockPasswordLogin(tx, email) : null;
+    let planned = await plan(tx, email, input.expectedAccountId);
+    if (!options.apply) return { accountId: planned.accountId, status: "planned", action: planned.action, maskedEmail: maskedEmail(email), operatorGrant: planned.operatorGrant };
+    if (planned.action === "rotate-password" && options.rotatePassword !== true) {
+      refuse("PLATFORM_PASSWORD_ROTATION_REQUIRED", "這個帳號已有密碼，請明確選擇更新密碼後再執行。");
+    }
+    if (planned.accountId) {
+      // Recheck identity after acquiring the same account lock used by closure.
+      await tx.query(`SELECT id FROM platform_accounts WHERE id=$1 FOR UPDATE`, [planned.accountId]);
+      planned = await plan(tx, email, planned.accountId);
+    }
+    const accountId = planned.accountId ?? `pa_${randomUUID()}`;
+    const credentialId = planned.credentialId ?? `pac_${randomUUID()}`;
+    if (!planned.accountId) {
+      await tx.query(`INSERT INTO platform_accounts (id,display_name,primary_email) VALUES ($1,$2,$3)`, [accountId, displayName, email]);
+    }
+    if (!planned.credentialId) {
+      await tx.query(`INSERT INTO platform_account_credentials
+          (id,platform_account_id,method,provider_issuer,provider_subject,email_at_registration,email_verified,verified_at,last_authenticated_at)
+        VALUES ($1,$2,'password',$3,$4,$4,false,clock_timestamp(),clock_timestamp())`,
+      [credentialId, accountId, PLATFORM_PASSWORD_ISSUER, email]);
+      await tx.query(`INSERT INTO platform_password_credentials (credential_id,platform_account_id,email,password_hash)
+        VALUES ($1,$2,$3,$4)`, [credentialId, accountId, email, passwordHash]);
+    } else {
+      await tx.query(`UPDATE platform_password_credentials SET password_hash=$2,updated_at=clock_timestamp() WHERE credential_id=$1`, [credentialId, passwordHash]);
+      await tx.query(`DELETE FROM platform_account_sessions WHERE credential_id=$1`, [credentialId]);
+    }
+    await tx.query(`INSERT INTO platform_operator_assignments (platform_account_id,role_key,state)
+      VALUES ($1,'platform-operator','active') ON CONFLICT (platform_account_id) DO UPDATE
+      SET state='active',revoked_at=NULL,updated_at=clock_timestamp()`, [accountId]);
+    await tx.query(`UPDATE platform_password_login_throttles SET failure_count=0,locked_until=NULL,
+      window_started_at=clock_timestamp(),updated_at=clock_timestamp() WHERE login_key=$1`, [key]);
+    await tx.query(`INSERT INTO platform_password_admin_audit
+      (id,platform_account_id,credential_id,action,operator_grant,performed_by,reason)
+      VALUES ($1,$2,$3,$4,$5,$6,$7)`, [`ppa_${randomUUID()}`, accountId, credentialId, planned.action, planned.operatorGrant, performedBy, reason]);
+    return { accountId, status: "applied", action: planned.action, maskedEmail: maskedEmail(email), operatorGrant: planned.operatorGrant };
+  });
+}
diff --git a/apps/api/src/accounts/platform-password-routes.test.ts b/apps/api/src/accounts/platform-password-routes.test.ts
new file mode 100644
index 0000000..7da8ea7
--- /dev/null
+++ b/apps/api/src/accounts/platform-password-routes.test.ts
@@ -0,0 +1,127 @@
+import { afterAll, beforeAll, describe, expect, it } from "vitest";
+import { createApp, isPublicApiRoute } from "../app";
+import { createDatabase, type CampusDatabase } from "../database";
+import { provisionPlatformPasswordAdmin } from "./platform-password-provisioning";
+
+describe("administrator password HTTP boundary", () => {
+  let db: CampusDatabase;
+  let app: Awaited<ReturnType<typeof createApp>>;
+  const password = "HTTP test-only password";
+  let accountId: string;
+  beforeAll(async () => {
+    db = await createDatabase({ attendanceCodeSecret: "password-route-test-secret-over-thirty-two", seedDemo: false });
+    const provisioned = await provisionPlatformPasswordAdmin(db, {
+      email: "admin-http@example.test", password, reason: "Test administrator HTTP boundary", performedBy: "test-runner",
+    }, { apply: true });
+    accountId = provisioned.accountId!;
+    app = await createApp(db, {
+      auth: { mode: "campus-account" },
+      campusAccountSessionSecret: "password-http-test-session-secret-over-thirty-two",
+      attendanceCodeSecret: "password-route-test-secret-over-thirty-two", enableDemoAuth: false,
+    });
+  }, 30_000);
+  afterAll(async () => { await app?.close(); await db?.close(); });
+
+  it("only makes the exact password POST public and leaves campus authorization intact", async () => {
+    expect(isPublicApiRoute("POST", "/v1/auth/platform/password/sessions")).toBe(true);
+    for (const method of ["GET", "PUT", "DELETE", "PATCH"]) expect(isPublicApiRoute(method, "/v1/auth/platform/password/sessions")).toBe(false);
+    expect(isPublicApiRoute("POST", "/v1/auth/platform/password/sessions/extra")).toBe(false);
+    const response = await app.inject({ method: "POST", url: "/v1/auth/platform/password/sessions", payload: { email: "admin-http@example.test", password } });
+    expect(response.statusCode).toBe(201);
+    expect(response.headers["cache-control"]).toBe("no-store");
+    expect(response.body).not.toContain(password);
+    expect(response.json()).toMatchObject({ platformAccountId: accountId, isPlatformOperator: true });
+    const handle = response.json().sessionHandle as string;
+    const headers = { authorization: `Platform ${handle}` };
+    expect((await app.inject({ method: "GET", url: "/v1/auth/platform/sessions/current", headers })).statusCode).toBe(200);
+    expect((await app.inject({ method: "GET", url: "/v1/auth/platform/ops/audit", headers })).statusCode).toBe(200);
+    expect((await app.inject({ method: "GET", url: "/v1/bootstrap", headers })).statusCode).toBe(401);
+    expect((await app.inject({ method: "POST", url: "/v1/auth/platform/logout", headers })).statusCode).toBe(200);
+    expect((await app.inject({ method: "GET", url: "/v1/auth/platform/sessions/current", headers })).statusCode).toBe(401);
+  });
+
+  it("returns uniform failures without reflecting credentials and enforces the existing IP limit", async () => {
+    const responses = [];
+    for (const email of ["admin-http@example.test", "missing-http@example.test"]) responses.push(await app.inject({
+      method: "POST", url: "/v1/auth/platform/password/sessions", remoteAddress: "192.0.2.10",
+      payload: { email, password: "incorrect test-only password" },
+    }));
+    expect(responses.map((response) => response.statusCode)).toEqual([401, 401]);
+    expect(responses[0]!.json()).toEqual(responses[1]!.json());
+    for (const response of responses) {
+      expect(response.headers["cache-control"]).toBe("no-store");
+      expect(response.body).not.toContain("incorrect test-only password");
+    }
+    let last;
+    for (let attempt = 0; attempt < 11; attempt += 1) last = await app.inject({
+      method: "POST", url: "/v1/auth/platform/password/sessions", remoteAddress: "192.0.2.11", payload: { email: "invalid", password },
+    });
+    expect(last!.statusCode).toBe(429);
+  });
+
+  it("revokes existing password sessions immediately when the operator grant is revoked", async () => {
+    const logged = await app.inject({ method: "POST", url: "/v1/auth/platform/password/sessions", remoteAddress: "192.0.2.12", payload: { email: "admin-http@example.test", password } });
+    const headers = { authorization: `Platform ${logged.json().sessionHandle as string}` };
+    await db.query(`UPDATE platform_operator_assignments SET state='revoked',revoked_at=now() WHERE platform_account_id=$1`, [accountId]);
+    expect((await app.inject({ method: "GET", url: "/v1/auth/platform/sessions/current", headers })).statusCode).toBe(401);
+    expect((await app.inject({ method: "GET", url: "/v1/auth/platform/ops/audit", headers })).statusCode).toBe(401);
+    expect((await app.inject({ method: "POST", url: "/v1/auth/platform/password/sessions", remoteAddress: "192.0.2.12", payload: { email: "admin-http@example.test", password } })).statusCode).toBe(401);
+  });
+
+  it("requires platform sessions for public social projections and cannot override target ids", async () => {
+    await db.query(`UPDATE platform_operator_assignments SET state='active',revoked_at=NULL WHERE platform_account_id=$1`, [accountId]);
+    for (const path of ["boards", "feed", "blocks", "reports"]) {
+      const url = `/v1/auth/platform/social/${path}`;
+      expect(isPublicApiRoute("GET", url)).toBe(true);
+      expect((await app.inject({ method: "GET", url })).statusCode).toBe(401);
+    }
+    expect(isPublicApiRoute("GET", "/v1/auth/platform/social/private")).toBe(false);
+    const logged = await app.inject({ method: "POST", url: "/v1/auth/platform/password/sessions", remoteAddress: "192.0.2.14", payload: { email: "admin-http@example.test", password } });
+    const headers = { authorization: `Platform ${logged.json().sessionHandle as string}` };
+    for (const url of ["/v1/auth/platform/social/boards", "/v1/auth/platform/social/feed", "/v1/auth/platform/ops/social/reports"]) {
+      const response = await app.inject({ method: "GET", url, headers });
+      expect(response.statusCode).toBe(200);
+      expect(response.headers["cache-control"]).toBe("no-store");
+      expect(response.json().items).toEqual([]);
+    }
+    const overridden = await app.inject({ method: "POST", url: "/v1/auth/platform/social/blocks/path-target/revoke", headers,
+      payload: { blockId: "body-target", expectedVersion: 1, idempotencyKey: "http-unblock-test" } });
+    expect(overridden.statusCode).toBe(422);
+    const decision = await app.inject({ method: "POST", url: "/v1/auth/platform/ops/social/reports/path-target/decision", headers,
+      payload: { reportId: "body-target", decision: "hide", reason: "HTTP schema test", expectedVersion: 1, idempotencyKey: "http-decision-test" } });
+    expect(decision.statusCode).toBe(422);
+  });
+
+  it("publishes only school directory metadata while retaining readiness status", async () => {
+    expect(isPublicApiRoute("GET", "/v1/auth/schools/directory")).toBe(true);
+    expect(isPublicApiRoute("POST", "/v1/auth/schools/directory")).toBe(false);
+    expect(isPublicApiRoute("GET", "/v1/auth/schools/directory/private")).toBe(false);
+    await db.query(`INSERT INTO tenants (id,display_name,state,directory_source)
+      VALUES ('directory-open','目錄開放測試','open','manual'),('directory-closed','目錄停用測試','suspended','manual')`);
+    const response = await app.inject({ method: "GET", url: "/v1/auth/schools/directory", remoteAddress: "192.0.2.13" });
+    expect(response.statusCode).toBe(200);
+    const schools = response.json().schools as Array<{ tenantId: string; displayName: string; status: string }>;
+    expect(schools).toContainEqual({ tenantId: "directory-open", displayName: "目錄開放測試", status: "open" });
+    expect(schools.some((school) => school.tenantId === "directory-closed" || school.tenantId === "campus-demo")).toBe(false);
+    expect(schools.every((school) => Object.keys(school).sort().join(",") === "displayName,status,tenantId")).toBe(true);
+    expect(schools.some((school) => school.status === "not-open")).toBe(true);
+  });
+
+  it("creates a real first public board through the operator-only strict route", async () => {
+    const url = "/v1/auth/platform/ops/social/boards";
+    const payload = { tenantId: "first-board-http", name: "公開交流測試", description: "HTTP first board fixture", idempotencyKey: "http-first-board-test" };
+    expect((await app.inject({ method: "POST", url, payload, remoteAddress: "192.0.2.15" })).statusCode).toBe(401);
+    await db.query(`INSERT INTO tenants (id,display_name,state,directory_source)
+      VALUES ('first-board-http','首個看板測試','provisioned','manual')`);
+    const logged = await app.inject({ method: "POST", url: "/v1/auth/platform/password/sessions", remoteAddress: "192.0.2.16", payload: { email: "admin-http@example.test", password } });
+    const headers = { authorization: `Platform ${logged.json().sessionHandle as string}` };
+    const overridden = await app.inject({ method: "POST", url, headers, payload: { ...payload, accessScope: "campus" }, remoteAddress: "192.0.2.17" });
+    expect(overridden.statusCode).toBe(422);
+    const response = await app.inject({ method: "POST", url, headers, payload, remoteAddress: "192.0.2.18" });
+    expect(response.statusCode).toBe(201);
+    expect(response.headers["cache-control"]).toBe("no-store");
+    expect(response.json()).toMatchObject({ tenantId: "first-board-http", name: "公開交流測試", canPost: true });
+    const board = (await db.query<{ access_scope: string; discoverability: string }>(`SELECT access_scope,discoverability FROM social_communities WHERE tenant_id=$1 AND id=$2`, [payload.tenantId, response.json().id])).rows[0];
+    expect(board).toEqual({ access_scope: "public", discoverability: "listed" });
+  });
+});
