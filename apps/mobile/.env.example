#
# Mobile app environment variables
# Copy this file to `.env` before running the app.
#
# cp apps/mobile/.env.example apps/mobile/.env
#

# ---------- App runtime ----------
APP_ENV=development
EXPO_PUBLIC_EAS_PROJECT_ID=

# ---------- Data source mode ----------
# mock | firebase | hybrid
EXPO_PUBLIC_DATA_SOURCE_MODE=hybrid

# development | staging | production（設為 production 可強制走真實 Firestore／雲端路徑，見 src/config/runtime.ts）
EXPO_PUBLIC_API_ENV=development

# Hybrid mode behavior
EXPO_PUBLIC_HYBRID_TIMEOUT_MS=10000
EXPO_PUBLIC_HYBRID_FALLBACK_TO_MOCK=true
EXPO_PUBLIC_PREFER_REAL_API=true

# TronClass / LMS：設為 false 時 App 不對 TronClass 後端發網路請求（口試純離線／避免全網路取數）
# EXPO_PUBLIC_TRONCLASS_DATA_ENABLED=false

# Google 登入（Firebase Auth + Expo AuthSession）：填 Firebase Console「Web／iOS／Android」OAuth client id
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
# Local development only. Enables mock auth fallback when Firebase is not configured.
EXPO_PUBLIC_ALLOW_LOCAL_MOCK_AUTH=false

# ---------- Firebase ----------
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_CLOUD_FUNCTION_REGION=asia-east1

# 館藏 OPAC Cloudflare Worker 基底網址（無結尾斜線）；留空則僅裝置直連
# EXPO_PUBLIC_LIBRARY_OPAC_PROXY_URL=https://campus-opac-proxy.your-account.workers.dev
# 可選；若設定則覆寫靜宜 tw-pu 適配器與相關 URL 的 Cloud Functions 根位址（須含 https，無結尾斜線）
# EXPO_PUBLIC_CLOUD_FUNCTION_BASE_URL=https://asia-east1-你的專案-id.cloudfunctions.net
# 勿開：設為 true 會把部分請求導向本機 Functions emulator（本 repo 預設改為只連正式雲端）
# EXPO_PUBLIC_USE_CLOUD_FUNCTION_EMULATOR=false

# ---------- iOS 本機 Xcode / Simulator 編譯（可選）----------
# Sign in with Apple、Associated Domains 等 entitlement 會讓 expo run:ios 在「模擬器」仍需具備簽署設定。
# Xcode → Settings → Accounts 登入後，會員詳情可查 Team ID；或 https://developer.apple.com/account （Membership）。
# 寫入 .env 後執行 `pod install`（或 expo run:ios，其內會跑 pod），Podfile 會把 DEVELOPMENT_TEAM 寫進 mobile Xcode 專案。
# IOS_DEVELOPMENT_TEAM=XXXXXXXXXX

# ---------- Maps ----------
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# ---------- AI ----------
# development:
# - offline = 裝置端展示模式，不呼叫 AI API 或 AI server
# - local-llm = 連到你自己啟動的本機/內網 AI server，可用 Ollama 做訓練/評測
# - cloud = 連到 Firebase Cloud Function askCampusAssistant
# preview/production:
# - app.config.ts 會強制 aiProvider=cloud；本機 Ollama 不會成為上架依賴
# - 免費優先的模型金鑰放在後端：Groq -> Gemini；不要在上架版填任何正式模型金鑰
# 本機開發預設走 Gemini function-calling；正式與預覽 build 仍由 app.config.ts 強制 cloud。
EXPO_PUBLIC_AI_PROVIDER=gemini
# Simulator 測雲端後端時建議 true：askCampusAssistant 失敗時不要默默落到 offline/mock，改顯示錯誤以便除錯。
# 仍須填好上方 Firebase 變數並登入，否則 callCampusAssistant 會直接略過。
EXPO_PUBLIC_DEV_PREFER_CLOUD_ASSISTANT=false
EXPO_PUBLIC_AI_SERVER_URL=
# 僅限本機開發測試。上架版請留空，模型金鑰必須放在後端環境變數或 secrets。
EXPO_PUBLIC_GEMINI_API_KEY=
# true = 允許本地 AI 在需要外部即時資訊時查公開網路來源並附來源
EXPO_PUBLIC_AI_ENABLE_WEB_SEARCH=true
# true = 允許背景低頻預抓公開來源，存成本地可追溯知識庫（不是訓練模型權重）
EXPO_PUBLIC_AI_WEB_LEARNING_ENABLED=true

# ---------- Test school login ----------
TEST_SCHOOL_LOGIN_ENABLED=false
TEST_SCHOOL_ID=tw-demo-uni
TEST_SCHOOL_USERNAME=
EXPO_PUBLIC_ENABLE_UNIVERSAL_DEV_ACCOUNTS=false

# ============================================
# Payment Services (Optional)
# ============================================
# Stripe Publishable Key
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-key

# TapPay App ID and Key (Taiwan local payments)
EXPO_PUBLIC_TAPPAY_APP_ID=your-tappay-app-id
EXPO_PUBLIC_TAPPAY_APP_KEY=your-tappay-app-key
EXPO_PUBLIC_TAPPAY_SERVER_TYPE=sandbox

# ============================================
# Analytics (Optional)
# ============================================
# Enable analytics tracking
EXPO_PUBLIC_ANALYTICS_ENABLED=true

# ============================================
# Feature Flags
# ============================================
# Enable demo/mock data mode
EXPO_PUBLIC_USE_MOCK_DATA=false

# false = 不對 TronClass／LMS 發網路請求（口試、離線 demo）；預設 true（未設定同 true）
# EXPO_PUBLIC_TRONCLASS_DATA_ENABLED=false

# ============================================
# Google Sign-In（Mobile SSOLoginScreen → Firebase Auth）
# ============================================
# Firebase Console → 專案設定 → 一般 → Web 應用程式用戶端 ID
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=123456789-xxxx.apps.googleusercontent.com
# 可選；未填時「使用 Google 繼續」按鈕會停用
# EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=123456789-ios.apps.googleusercontent.com
# EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=123456789-android.apps.googleusercontent.com

# Enable AR navigation features
EXPO_PUBLIC_AR_ENABLED=true

# Enable voice guidance
EXPO_PUBLIC_VOICE_GUIDANCE_ENABLED=true
