+        await tx.query<ConfirmationRow>(
+          `SELECT *,expires_at>clock_timestamp() AS unexpired FROM platform_public_agent_confirmations
+        WHERE platform_account_id=$1 AND task=$2 AND request_id=$3 FOR UPDATE`,
