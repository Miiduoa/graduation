# Server runtime configuration. Keep secrets in the existing host secret store.
# Adds the Nuni classroom without replacing Campus One pages or school login.
NUNI_CLASSROOM_ENABLED=true
NUNI_API_BASE_URL=https://api.nuni.tw
WEB_PUBLIC_ORIGIN=https://nuni.tw
BFF_SESSION_SECRET=
# 獨立 TronClass 綁定的 Firestore 與登入限流由 Web runtime 直接存取。
# 填入既有 campus-one-tw 服務帳戶的原始 JSON，不是 base64；只設在
# nuni-functions 不足以啟用 Web API。請存入既有 Web 主機的 secret store，
# 不得加 NEXT_PUBLIC_、作為 Docker build arg 或提交真實內容。
FIREBASE_SERVICE_ACCOUNT_JSON=
# 獨立 TronClass 綁定不依賴 E-campus session。
# false 可停止全部 /api/tronclass 操作；未設則啟用讀取與綁定路由。
# TRONCLASS_INTEGRATION_ENABLED=true
# 至少 32 字元，用來加密校方 session；未設時沿用 BFF_SESSION_SECRET。
# TRONCLASS_SESSION_SECRET=
# 正式送出需完成校方 write adapter 合約驗證。現在 adapter 固定拒絕寫入，
# 單改環境變數無法開啟；不得把本機 fixture 測試視為真實繳交驗證。
# TRONCLASS_HOMEWORK_WRITE_ENABLED=false
# 校方流量預設 IPv4 直連；既有 Web 主機若使用校方 relay，沿用其
# PU_EDGE_RELAY_URL 與 PU_EDGE_RELAY_SECRET，不要在此範例填入正式值。
PLATFORM_GOOGLE_LOGIN_ENABLED=true
PLATFORM_GOOGLE_CLIENT_SECRET=
# Google AI 代辦權限：先由既有 API migration runner 套用 283 與角色 ACL，再發布 Web。
# 可沿用 ASSIGNMENT_FILE_DATABASE_URL 或 DATABASE_URL；必須連到既有 nuni PostgreSQL。
# PLATFORM_ASSISTANT_DATABASE_URL=
# 作業拍照／檔案繳交。未設或不是字面 true 就是關；正式環境不要開，除非本人說「上」。
# ASSIGNMENT_FILE_SUBMIT_ENABLED=true
# ASSIGNMENT_FILE_STORE_DIR=
# ASSIGNMENT_FILE_SIGNING_SECRET=
# 私人檔案：伺服器簽發私有 Supabase Storage URL。未完整設定時回 503。
# FILE_STORAGE_BACKEND=supabase
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_STORAGE_BUCKET=private-files
