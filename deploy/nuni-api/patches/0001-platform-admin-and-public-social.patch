diff --git a/apps/api/src/accounts/platform-password-service.ts b/apps/api/src/accounts/platform-password-service.ts
new file mode 100644
index 0000000..c4793f2
--- /dev/null
+++ b/apps/api/src/accounts/platform-password-service.ts
@@ -0,0 +1,145 @@
+import { createHash, randomBytes, scrypt, timingSafeEqual } from "node:crypto";
+import type { CampusDatabase, SqlExecutor } from "../database";
+import { DomainError } from "../domain-error";
+import type { PlatformAccountService } from "./platform-account-service";
+
+const SCRYPT_N = 32768;
+const SCRYPT_R = 8;
+const SCRYPT_P = 3;
+const HASH_PREFIX = `scrypt$${SCRYPT_N}$${SCRYPT_R}$${SCRYPT_P}`;
+const DUMMY_HASH = `${HASH_PREFIX}$${Buffer.alloc(16).toString("base64url")}$${Buffer.alloc(32).toString("base64url")}`;
+const LOCKOUT_MS = 15 * 60 * 1000;
+const SESSION_SECONDS = 3600;
+export const PLATFORM_PASSWORD_ISSUER = "urn:nuni:platform-password";
+
+export function normalizePlatformPasswordEmail(value: unknown): string | null {
+  if (typeof value !== "string" || value.length > 300) return null;
+  const email = value.trim().toLowerCase();
+  if (email.length > 254 || !/^[a-z0-9.!#$%&'*+/=?^_`{|}~-]+@[a-z0-9](?:[a-z0-9-]*[a-z0-9])?(?:\.[a-z0-9](?:[a-z0-9-]*[a-z0-9])?)+$/u.test(email)) return null;
+  return email;
+}
+
+export function validPlatformPassword(value: unknown): value is string {
+  return typeof value === "string" && Array.from(value).length >= 8 && Buffer.byteLength(value, "utf8") <= 256;
+}
+
+function derive(password: string, salt: Buffer): Promise<Buffer> {
+  return new Promise((resolve, reject) => {
+    scrypt(password, salt, 32, { N: SCRYPT_N, r: SCRYPT_R, p: SCRYPT_P, maxmem: 64 * 1024 * 1024 }, (error, hash) => {
+      if (error) reject(error);
+      else resolve(hash);
+    });
+  });
+}
+
+export async function hashPlatformPassword(password: string): Promise<string> {
+  if (!validPlatformPassword(password)) {
+    throw new DomainError("PLATFORM_PASSWORD_INPUT_INVALID", "密碼至少需要 8 個字元，且不能超過 256 位元組。", 400);
+  }
+  const salt = randomBytes(16);
+  return `${HASH_PREFIX}$${salt.toString("base64url")}$${(await derive(password, salt)).toString("base64url")}`;
+}
+
+async function verifyPassword(password: string, stored: string): Promise<boolean> {
+  const parts = stored.split("$");
+  const valid = parts.length === 6 && parts.slice(0, 4).join("$") === HASH_PREFIX
+    && /^[A-Za-z0-9_-]{22}$/u.test(parts[4] ?? "") && /^[A-Za-z0-9_-]{43}$/u.test(parts[5] ?? "");
+  const selected = valid ? parts : DUMMY_HASH.split("$");
+  const hash = await derive(password, Buffer.from(selected[4]!, "base64url"));
+  return timingSafeEqual(hash, Buffer.from(selected[5]!, "base64url")) && valid;
+}
+
+export function passwordLoginKey(email: string): string {
+  return createHash("sha256").update(email).digest("hex");
+}
+
+export async function lockPasswordLogin(tx: SqlExecutor, email: string): Promise<string> {
+  const key = passwordLoginKey(email);
+  await tx.query(`INSERT INTO platform_password_login_throttles (login_key) VALUES ($1)
+    ON CONFLICT (login_key) DO NOTHING`, [key]);
+  await tx.query(`SELECT login_key FROM platform_password_login_throttles WHERE login_key=$1 FOR UPDATE`, [key]);
+  return key;
+}
+
+function loginInvalid(): DomainError {
+  return new DomainError("PLATFORM_PASSWORD_LOGIN_INVALID", "帳號或密碼不正確，請稍後再試。", 401);
+}
+
+export class PlatformPasswordService {
+  constructor(private readonly db: CampusDatabase, private readonly accounts: PlatformAccountService) {}
+
+  async login(input: { email: unknown; password: unknown }) {
+    const email = normalizePlatformPasswordEmail(input.email);
+    const suppliedPassword = input.password;
+    const acceptablePassword = validPlatformPassword(suppliedPassword);
+    if (!email) throw loginInvalid();
+    const password = acceptablePassword ? suppliedPassword : "invalid-password-input";
+    const result = await this.db.transaction(async (tx) => {
+      const key = await lockPasswordLogin(tx, email);
+      // Read the database clock after acquiring the shared bucket lock.
+      const throttle = (await tx.query<{
+        failure_count: number; window_expired: boolean; blocked: boolean;
+      }>(`SELECT failure_count,
+          window_started_at <= clock_timestamp() - interval '15 minutes' AS window_expired,
+          COALESCE(locked_until > clock_timestamp(), false) AS blocked
+        FROM platform_password_login_throttles WHERE login_key=$1`, [key])).rows[0]!;
+      if (throttle.blocked) {
+        await verifyPassword(password, DUMMY_HASH);
+        return null;
+      }
+      const stored = (await tx.query<{
+        credential_id: string; platform_account_id: string; password_hash: string;
+      }>(`SELECT credential_id, platform_account_id, password_hash
+        FROM platform_password_credentials WHERE email=$1`, [email])).rows[0];
+      // Lock the account first, matching account close/suspension transactions.
+      const account = stored ? (await tx.query<{ state: string }>(
+        `SELECT state FROM platform_accounts WHERE id=$1 FOR UPDATE`, [stored.platform_account_id],
+      )).rows[0] : undefined;
+      const credential = stored ? (await tx.query<{ state: string; method: string }>(
+        `SELECT state,method FROM platform_account_credentials WHERE id=$1 AND platform_account_id=$2 FOR UPDATE`,
+        [stored.credential_id, stored.platform_account_id],
+      )).rows[0] : undefined;
+      const assignment = stored ? (await tx.query<{ state: string }>(
+        `SELECT state FROM platform_operator_assignments
+          WHERE platform_account_id=$1 AND role_key='platform-operator' FOR UPDATE`, [stored.platform_account_id],
+      )).rows[0] : undefined;
+      const matches = await verifyPassword(password, stored?.password_hash ?? DUMMY_HASH);
+      if (!acceptablePassword || !matches || account?.state !== "active"
+        || credential?.state !== "active" || credential.method !== "password" || assignment?.state !== "active") {
+        const failures = throttle.window_expired ? 1 : Math.min(5, throttle.failure_count + 1);
+        await tx.query(`UPDATE platform_password_login_throttles
+          SET failure_count=$2,
+              window_started_at=CASE WHEN $3 THEN clock_timestamp() ELSE window_started_at END,
+              locked_until=CASE WHEN $2 >= 5 THEN clock_timestamp() + ($4::integer * interval '1 millisecond') ELSE NULL END,
+              updated_at=clock_timestamp() WHERE login_key=$1`, [key, failures, throttle.window_expired, LOCKOUT_MS]);
+        // Returning commits the failure counter; throwing here would roll it back.
+        return null;
+      }
+      const sessionHandle = `ps_${randomBytes(32).toString("base64url")}`;
+      const expiresAt = (await tx.query<{ expires_at: Date | string }>(
+        `INSERT INTO platform_account_sessions (token_sha256,platform_account_id,credential_id,expires_at)
+          VALUES ($1,$2,$3,clock_timestamp() + ($4::integer * interval '1 second')) RETURNING expires_at`,
+        [passwordLoginKey(sessionHandle), stored!.platform_account_id, stored!.credential_id, SESSION_SECONDS],
+      )).rows[0]!.expires_at;
+      await tx.query(`UPDATE platform_account_credentials SET last_authenticated_at=clock_timestamp(),updated_at=clock_timestamp() WHERE id=$1`, [stored!.credential_id]);
+      await tx.query(`UPDATE platform_password_login_throttles SET failure_count=0,window_started_at=clock_timestamp(),locked_until=NULL,updated_at=clock_timestamp() WHERE login_key=$1`, [key]);
+      return { sessionHandle, platformAccountId: stored!.platform_account_id, credentialId: stored!.credential_id, expiresAt: new Date(expiresAt).getTime() };
+    });
+    if (!result) throw loginInvalid();
+    // Resolve again so a revocation committed after credential verification fails closed.
+    let projection: Awaited<ReturnType<PlatformAccountService["projectCurrentSession"]>>;
+    try {
+      const actor = await this.accounts.resolveSession(`Platform ${result.sessionHandle}`);
+      projection = await this.accounts.projectCurrentSession(actor);
+    } catch (error) {
+      await this.accounts.logout(`Platform ${result.sessionHandle}`);
+      if (error instanceof DomainError && error.statusCode === 401) throw loginInvalid();
+      throw error;
+    }
+    if (!projection.isPlatformOperator) {
+      await this.accounts.logout(`Platform ${result.sessionHandle}`);
+      throw loginInvalid();
+    }
+    return { ...projection, sessionHandle: result.sessionHandle, expiresInSeconds: SESSION_SECONDS, created: false as const };
+  }
+}
