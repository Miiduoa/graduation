diff --git a/android/src/main/java/com/rnllama/Arm64LibrarySelector.java b/android/src/main/java/com/rnllama/Arm64LibrarySelector.java
new file mode 100644
--- /dev/null
+++ b/android/src/main/java/com/rnllama/Arm64LibrarySelector.java
@@ -0,0 +1,37 @@
+package com.rnllama;
+
+import java.util.Arrays;
+import java.util.HashSet;
+import java.util.Set;
+
+final class Arm64LibrarySelector {
+  private Arm64LibrarySelector() {}
+
+  static String select(String cpuInfoFeaturesLine) {
+    // Linux reports scalar and SIMD half-precision arithmetic separately.
+    Set<String> features = new HashSet<>(Arrays.asList(cpuInfoFeaturesLine.trim().split("\\s+")));
+    if (!features.contains("fphp") || !features.contains("asimdhp")) {
+      return "rnllama_v8";
+    }
+    if (!features.contains("asimddp")) {
+      return "rnllama_v8_2_fp16";
+    }
+    if (!features.contains("asimdfhm")) {
+      return "rnllama_v8_2_fp16_dotprod";
+    }
+
+    boolean sve = features.contains("sve");
+    boolean i8mm = features.contains("i8mm");
+    // Combining +sve and +i8mm lets Clang emit SVE matrix multiply too.
+    if (sve && i8mm && features.contains("svei8mm")) {
+      return "rnllama_v8_4_fp16_dotprod_i8mm_sve";
+    }
+    if (sve) {
+      return "rnllama_v8_4_fp16_dotprod_sve";
+    }
+    if (i8mm) {
+      return "rnllama_v8_4_fp16_dotprod_i8mm";
+    }
+    return "rnllama_v8_4_fp16_dotprod";
+  }
+}
