# ============================================
# Firebase Configuration
# ============================================
# Get these values from Firebase Console > Project Settings > General
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:abcdef123456
NEXT_PUBLIC_CLOUD_FUNCTION_REGION=asia-east1
# 未設定時，網頁端不會呼叫 Cloud Functions（正式 Spark 專案沒有 asia-east1 HTTPS 端點）。
# 部署 nuni-functions 到 Fly 後再設定，例如：
# NEXT_PUBLIC_FUNCTIONS_BASE_URL=https://nuni-functions.fly.dev

# 請假站內送出／撤回／核閱。伺服器 runtime 讀這個開關，同時控制畫面與寫入。
# 未設定或 false 時，請假頁／核閱頁顯示「尚未開放」，API 回 503。
# LEAVE_WEB_API_ENABLED=true

# 靜宜學號／教職員帳號登入。伺服器 runtime 讀這個開關，同時控制 sign-in-options
# 的 studentId 與 /api/fn/signInPuStudentId。未設定或 false 時登入頁與
# SchoolAccountRequired 維持關閉，API 回 503。只接受 pu。
# SCHOOL_STUDENT_ID_LOGIN_ENABLED=true

# 私人檔案改走 Cloudflare R2（正式 Spark 專案沒有 Storage bucket）。未設定時維持現狀，
# 頁面不呼叫新路由。伺服器與網頁開關都要開，且 R2 金鑰齊全，才會發短效期預簽 URL。
# FILE_STORAGE_BACKEND=r2
# NEXT_PUBLIC_FILE_STORAGE_BACKEND=r2
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# 測試用 S3 相容端點（正式環境可省略，預設 https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com）
# R2_ENDPOINT=
# R2_REGION=auto
# R2_PRESIGN_TTL_SECONDS=60

# ============================================
# Server-side Firebase Admin (for API routes)
# ============================================
# Service account JSON (base64 encoded)
FIREBASE_SERVICE_ACCOUNT_BASE64=your-base64-encoded-service-account-json

# ============================================
# Feature Flags
# ============================================
# Default school ID for demo
NEXT_PUBLIC_DEFAULT_SCHOOL_ID=demo-school

# Enable PWA features
NEXT_PUBLIC_PWA_ENABLED=true

# Enable analytics
NEXT_PUBLIC_ANALYTICS_ENABLED=true

# ============================================
# TDX 公車即時到站與靜宜轉乘建議（伺服器端）
# ============================================
# 正式站要啟用即時到站與「去哪裡」轉乘，請設定這兩個既有變數。留空則只顯示直達／靜態名錄與 Google 地圖。
TDX_CLIENT_ID=
TDX_CLIENT_SECRET=
