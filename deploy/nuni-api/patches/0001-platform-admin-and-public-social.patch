+    await db.query(`UPDATE social_communities SET access_scope='campus' WHERE tenant_id='campus-demo' AND id='public-board'`);
+    await expect(service.createPost(author, input)).rejects.toMatchObject({ statusCode: 404 });
+    await expect(service.createPost(reader, { ...input, idempotencyKey: key() })).rejects.toMatchObject({ statusCode: 404 });
+    const count = await db.query<{ count: number }>(`SELECT count(*)::int AS count FROM social_posts WHERE tenant_id='campus-demo' AND community_id='public-board'`);
+    expect(count.rows[0]?.count).toBe(2);
+  });
+
+  it("rolls post/report/idempotency back when the mandatory audit fails and permits a safe retry", async () => {
+    const post = await service.createPost(author, { tenantId: "nccu", communityId: "public-board", text: "交易回復驗證", idempotencyKey: key() });
+    const report = await service.report(reader, { tenantId: post.tenantId, postId: post.id, reason: "other", idempotencyKey: key() });
+    const input = { reportId: report.id, decision: "hide" as const, reason: "測試交易原子性", expectedVersion: report.version, idempotencyKey: key() };
+    await db.exec(`CREATE FUNCTION fail_public_social_audit_test() RETURNS trigger LANGUAGE plpgsql AS $$
+      BEGIN IF NEW.action='hide' THEN RAISE EXCEPTION 'audit test failure'; END IF; RETURN NEW; END; $$;
+      CREATE TRIGGER fail_public_social_audit_test BEFORE INSERT ON platform_public_social_audit
+        FOR EACH ROW EXECUTE FUNCTION fail_public_social_audit_test();`);
+    await expect(service.decideReport(operator, input)).rejects.toThrow("audit test failure");
+    expect((await service.getPost(reader, { tenantId: post.tenantId, postId: post.id })).version).toBe(post.version);
+    expect((await service.listReports(reader)).items[0]?.state).toBe("open");
+    expect((await db.query(`SELECT key FROM platform_public_social_idempotency WHERE key=$1`, [input.idempotencyKey])).rows).toHaveLength(0);
+    await db.exec(`DROP TRIGGER fail_public_social_audit_test ON platform_public_social_audit; DROP FUNCTION fail_public_social_audit_test();`);
+    await db.query(`UPDATE social_posts SET visibility='only-me' WHERE tenant_id=$1 AND id=$2`, [post.tenantId, post.id]);
+    await expect(service.decideReport(operator, input)).rejects.toMatchObject({ code: "PLATFORM_SOCIAL_POST_UNAVAILABLE" });
+    const dismissed = await service.decideReport(operator, { ...input, decision: "dismiss", idempotencyKey: key() });
+    expect(dismissed.state).toBe("dismissed");
+    expect((await db.query<{ state: string }>(`SELECT state FROM social_posts WHERE tenant_id=$1 AND id=$2`, [post.tenantId, post.id])).rows[0]?.state).toBe("published");
+  });
+});
diff --git a/apps/api/src/accounts/platform-social-service.ts b/apps/api/src/accounts/platform-social-service.ts
new file mode 100644
index 0000000..46c9619
--- /dev/null
+++ b/apps/api/src/accounts/platform-social-service.ts
@@ -0,0 +1,345 @@
+import { randomUUID } from "node:crypto";
+import { z } from "zod";
+import type { CampusDatabase, SqlExecutor } from "../database";
+import { DomainError } from "../domain-error";
+import { SocialService, type SocialServiceOptions } from "../social/social-service";
+import { socialRequestHash } from "../social/social-utils";
+import type { PlatformAccountService, PlatformActor } from "./platform-account-service";
+
+const id = z.string().min(1).max(120);
+const tenantId = z.string().max(80).regex(/^[a-z0-9][a-z0-9-]*[a-z0-9]$/u);
+const idempotencyKey = z.string().trim().min(8).max(100);
+const expectedVersion = z.number().int().positive();
+export const PlatformSocialTargetSchema = z.object({ tenantId, postId: id }).strict();
+export const PlatformSocialFeedQuerySchema = z.object({
+  tenantId: tenantId.optional(), communityId: id.optional(), cursor: z.string().max(1000).optional(),
+  limit: z.coerce.number().int().min(1).max(50).default(20),
+}).strict().refine(value => !value.communityId || Boolean(value.tenantId), { message: "看板篩選需要指定所屬公開區域。" });
+export const PlatformSocialCreatePostSchema = z.object({ tenantId, communityId: id, text: z.string().trim().min(1).max(10_000), idempotencyKey }).strict();
+export const PlatformSocialCreateBoardSchema = z.object({ tenantId, name: z.string().trim().min(2).max(80),
+  description: z.string().trim().max(400).default(""), idempotencyKey }).strict();
+export const PlatformSocialBlockSchema = PlatformSocialTargetSchema.extend({ idempotencyKey });
+export const PlatformSocialUnblockSchema = z.object({ blockId: id, expectedVersion, idempotencyKey }).strict();
+export const PlatformSocialReportSchema = PlatformSocialTargetSchema.extend({
+  reason: z.enum(["harassment", "spam", "privacy", "hate", "violence", "other"]),
+  detail: z.string().trim().max(2000).default(""), idempotencyKey,
+});
+export const PlatformSocialOperatorReportsQuerySchema = z.object({
+  state: z.enum(["open", "hidden", "dismissed"]).optional(), limit: z.coerce.number().int().min(1).max(100).default(50),
+}).strict();
+export const PlatformSocialDecisionSchema = z.object({
+  reportId: id, decision: z.enum(["hide", "dismiss"]), reason: z.string().trim().min(5).max(2000), expectedVersion, idempotencyKey,
+}).strict();
+
+interface PublicPostRow {
+  id: string; tenant_id: string; tenant_name: string; community_id: string; community_name: string;
+  text_content: string; display_name: string; author_account_id: string; published_at: string; version: number;
+}
+interface BlockRow { id: string; version: number; state: string; display_name: string; created_at: string | Date }
+interface ReportRow {
+  id: string; tenant_id: string; post_id: string; reporter_account_id: string; author_account_id: string;
+  reason: string; state: string; version: number; created_at: string | Date; detail: string;
+  public_snapshot: Record<string, unknown>; decision_reason: string | null;
+}
+
+// Every target operation uses this exact visibility gate. Membership-only,
+// unmapped campus authors and federation data never enter the global projection.
+const publicPosts = `FROM social_posts p
+  JOIN social_communities c ON c.tenant_id=p.tenant_id AND c.id=p.community_id
+  JOIN tenants t ON t.id=p.tenant_id
+  JOIN social_profiles profile ON profile.tenant_id=p.tenant_id AND profile.id=p.author_profile_id
+  JOIN platform_tenant_personas persona ON persona.tenant_id=profile.tenant_id AND persona.person_id=profile.person_id
+  JOIN platform_accounts author ON author.id=persona.platform_account_id
+  WHERE p.state='published' AND p.visibility='public-campus'
+    AND c.access_scope='public' AND c.discoverability='listed'
+    AND t.state IN ('provisioned','open') AND author.state='active'`;
+const postColumns = `p.id,p.tenant_id,t.display_name AS tenant_name,p.community_id,c.name AS community_name,
+  p.text_content,profile.display_name,persona.platform_account_id AS author_account_id,
+  to_char(p.published_at AT TIME ZONE 'UTC','YYYY-MM-DD"T"HH24:MI:SS.US"Z"') AS published_at,p.version`;
+const notBlocked = `AND NOT EXISTS (SELECT 1 FROM platform_public_social_blocks b WHERE b.state='active'
+  AND ((b.owner_account_id=$1 AND b.target_account_id=persona.platform_account_id)
+    OR (b.target_account_id=$1 AND b.owner_account_id=persona.platform_account_id)))`;
+
+export class PlatformSocialService {
+  constructor(
+    private readonly db: CampusDatabase,
+    private readonly accounts: PlatformAccountService,
+    private readonly socialOptions: SocialServiceOptions = {},
+  ) {}
+
+  async createBoard(actor: PlatformActor, input: z.input<typeof PlatformSocialCreateBoardSchema>) {
+    const data = PlatformSocialCreateBoardSchema.parse(input);
+    await this.read(actor, tx => this.requireOperator(tx, actor));
+    const persona = await this.accounts.resolvePublicRealmActor(actor, data.tenantId, { forCommunityCreation: true });
+    const target = await this.write(actor, "board", data, async tx => {
+      const tenant = (await tx.query(`SELECT id FROM tenants WHERE id=$1 AND state IN ('provisioned','open') FOR SHARE`, [data.tenantId])).rows[0];
+      if (!tenant) throw notFound();
+      const social = new SocialService(transactionDatabase(this.db, tx), this.socialOptions);
+      const board = await social.createCommunity(persona, {
+        kind: "group", name: data.name, description: data.description, discoverability: "listed",
+        joinPolicy: "open", postingPolicy: "members", idempotencyKey: `public-board-${socialRequestHash(data).slice(0, 64)}`,
+      }, "public");
+      return { tenantId: data.tenantId, communityId: String(board.id) };
+    }, true);
+    const board = (await this.boards(actor)).items.find(row => row.tenantId === target.tenantId && row.id === target.communityId);
+    if (!board) throw notFound();
+    return board;
+  }
+
+  async boards(actor: PlatformActor) {
+    return this.read(actor, async tx => {
+      const rows = await tx.query<{
+        tenant_id: string; tenant_name: string; id: string; name: string; description: string | null;
+        join_policy: string; posting_policy: string; can_post: boolean;
+      }>(`SELECT c.tenant_id,t.display_name AS tenant_name,c.id,c.name,c.description,c.join_policy,c.posting_policy,
+          ((c.join_policy='open' AND c.posting_policy='members') OR EXISTS (
+            SELECT 1 FROM platform_tenant_personas persona JOIN social_profiles profile
+              ON profile.tenant_id=persona.tenant_id AND profile.person_id=persona.person_id
+            JOIN social_memberships m ON m.tenant_id=profile.tenant_id AND m.profile_id=profile.id
+            WHERE persona.platform_account_id=$1 AND m.tenant_id=c.tenant_id AND m.community_id=c.id
+              AND m.state='active' AND (c.posting_policy='members' OR m.role IN ('owner','moderator')))) AS can_post
+        FROM social_communities c JOIN tenants t ON t.id=c.tenant_id
+        WHERE c.access_scope='public' AND c.discoverability='listed' AND t.state IN ('provisioned','open')
+        ORDER BY t.display_name,c.name,c.tenant_id,c.id`, [actor.platformAccountId]);
+      return { items: rows.rows.map(row => ({ tenantId: row.tenant_id, tenantName: row.tenant_name, id: row.id,
+        name: row.name, description: row.description, joinPolicy: row.join_policy, postingPolicy: row.posting_policy, canPost: row.can_post })) };
+    });
+  }
+
+  async feed(actor: PlatformActor, input: z.input<typeof PlatformSocialFeedQuerySchema>) {
+    const query = PlatformSocialFeedQuerySchema.parse(input);
+    const scope = socialRequestHash({ viewer: actor.platformAccountId, tenantId: query.tenantId ?? null, communityId: query.communityId ?? null });
+    let cursor: { date: string; tenantId: string; postId: string } | null = null;
+    if (query.cursor) {
+      try {
+        const value = z.object({ date: z.string().datetime({ precision: 6 }), tenantId, postId: id, scope: z.literal(scope) }).strict()
+          .parse(JSON.parse(Buffer.from(query.cursor, "base64url").toString("utf8")));
+        cursor = value;
+      } catch { throw new DomainError("PLATFORM_SOCIAL_CURSOR_INVALID", "這個清單已變更，請重新載入。", 422); }
+    }
+    return this.read(actor, async tx => {
+      const rows = await tx.query<PublicPostRow>(`SELECT ${postColumns} ${publicPosts} ${notBlocked}
+        AND ($2::text IS NULL OR p.tenant_id=$2) AND ($3::text IS NULL OR p.community_id=$3)
+        AND ($4::timestamptz IS NULL OR (p.published_at,p.tenant_id,p.id)<($4::timestamptz,$5::text,$6::text))
+        ORDER BY p.published_at DESC,p.tenant_id DESC,p.id DESC LIMIT $7`,
+      [actor.platformAccountId, query.tenantId ?? null, query.communityId ?? null, cursor?.date ?? null, cursor?.tenantId ?? null, cursor?.postId ?? null, query.limit + 1]);
+      const selected = rows.rows.slice(0, query.limit);
+      const last = selected.at(-1);
+      return { items: selected.map(row => projectPost(row, actor)), nextCursor: rows.rows.length > query.limit && last
+        ? Buffer.from(JSON.stringify({ date: last.published_at, tenantId: last.tenant_id, postId: last.id, scope })).toString("base64url") : null };
+    });
+  }
+
+  async getPost(actor: PlatformActor, input: z.input<typeof PlatformSocialTargetSchema>) {
+    const target = PlatformSocialTargetSchema.parse(input);
+    return this.read(actor, async tx => projectPost(await this.publicTarget(tx, actor, target), actor));
+  }
+
+  async createPost(actor: PlatformActor, input: z.input<typeof PlatformSocialCreatePostSchema>) {
+    const data = PlatformSocialCreatePostSchema.parse(input);
+    await this.read(actor, async () => undefined);
+    const persona = await this.accounts.resolvePublicRealmActor(actor, data.tenantId);
+    return this.write(actor, "post", data, async tx => {
+      await tx.query(`SELECT id FROM people WHERE tenant_id=$1 AND id=$2 FOR UPDATE`, [persona.tenantId, persona.personId]);
+      await this.requireBoard(tx, data.tenantId, data.communityId);
+      // Reuse all existing participation restrictions, membership rules, history,
+      // idempotency and governed outbox, in this transaction (no nested commit).
+      const social = new SocialService(transactionDatabase(this.db, tx), this.socialOptions);
+      const profile = await social.getSelfProfile(persona);
+      const membership = (await tx.query(`SELECT 1 FROM social_memberships WHERE tenant_id=$1
+        AND community_id=$2 AND profile_id=$3 AND state='active'`, [data.tenantId, data.communityId, profile.id])).rows[0];
+      if (!membership) {
+        const board = await this.requireBoard(tx, data.tenantId, data.communityId);
+        if (board.join_policy !== "open" || board.posting_policy !== "members") {
+          throw new DomainError("PLATFORM_SOCIAL_MEMBERSHIP_REQUIRED", "這個看板需要既有成員或管理員資格才能發表。", 403);
+        }
+        await social.changeMembership(persona, data.communityId, { action: "request-join", reasonCode: "user-request", idempotencyKey: `public-join-${socialRequestHash(data).slice(0, 64)}` });
+      }
+      const post = await social.createPost(persona, { communityId: data.communityId,
+        content: { text: data.text, tagIds: [], mediaRefs: [] }, visibility: "public-campus", state: "published",
+        idempotencyKey: `public-post-${socialRequestHash(data).slice(0, 64)}` });
+      return { tenantId: data.tenantId, postId: String(post.id) };
+    }).then(target => this.getPost(actor, target));
+  }
+
+  async blockAuthor(actor: PlatformActor, input: z.input<typeof PlatformSocialBlockSchema>) {
+    const data = PlatformSocialBlockSchema.parse(input);
+    return this.write(actor, "block", data, async tx => {
+      const target = await this.publicTarget(tx, actor, data, true);
+      if (target.author_account_id === actor.platformAccountId) throw new DomainError("PLATFORM_SOCIAL_SELF_TARGET", "不能封鎖自己的帳號。", 422);
+      const row = (await tx.query<BlockRow>(`INSERT INTO platform_public_social_blocks (id,owner_account_id,target_account_id)
+        VALUES ($1,$2,$3) ON CONFLICT (owner_account_id,target_account_id) DO UPDATE
+        SET state='active',version=platform_public_social_blocks.version+1,updated_at=now() RETURNING *`,
+      [randomUUID(), actor.platformAccountId, target.author_account_id])).rows[0]!;
+      await this.audit(tx, actor, "block", { blockId: row.id });
+      return { id: row.id, state: row.state, version: row.version };
+    });
+  }
+
+  async listBlocks(actor: PlatformActor) {
+    return this.read(actor, async tx => ({ items: (await tx.query<BlockRow>(`SELECT b.id,b.version,b.created_at,target.display_name
+      FROM platform_public_social_blocks b JOIN platform_accounts target ON target.id=b.target_account_id
+      WHERE b.owner_account_id=$1 AND b.state='active' ORDER BY b.created_at DESC,b.id DESC`, [actor.platformAccountId])).rows
+      .map(row => ({ id: row.id, version: row.version, displayName: row.display_name, createdAt: iso(row.created_at) })) }));
+  }
+
+  async unblock(actor: PlatformActor, input: z.input<typeof PlatformSocialUnblockSchema>) {
+    const data = PlatformSocialUnblockSchema.parse(input);
+    return this.write(actor, "unblock", data, async tx => {
+      const row = (await tx.query<BlockRow>(`SELECT * FROM platform_public_social_blocks
+        WHERE id=$1 AND owner_account_id=$2 FOR UPDATE`, [data.blockId, actor.platformAccountId])).rows[0];
+      if (!row) throw notFound();
+      if (row.version !== data.expectedVersion || row.state !== "active") throw versionConflict();
+      await tx.query(`UPDATE platform_public_social_blocks SET state='revoked',version=version+1,updated_at=now() WHERE id=$1`, [row.id]);
+      await this.audit(tx, actor, "unblock", { blockId: row.id });
+      return { id: row.id, state: "revoked", version: row.version + 1 };
+    });
+  }
+
+  async report(actor: PlatformActor, input: z.input<typeof PlatformSocialReportSchema>) {
+    const data = PlatformSocialReportSchema.parse(input);
+    return this.write(actor, "report", data, async tx => {
+      const target = await this.publicTarget(tx, actor, data, true);
+      if (target.author_account_id === actor.platformAccountId) throw new DomainError("PLATFORM_SOCIAL_SELF_TARGET", "不能檢舉自己的貼文。", 422);
+      const existing = (await tx.query(`SELECT id FROM platform_public_social_reports WHERE reporter_account_id=$1
+        AND tenant_id=$2 AND post_id=$3 AND state='open'`, [actor.platformAccountId, data.tenantId, data.postId])).rows[0];
+      if (existing) throw new DomainError("PLATFORM_SOCIAL_REPORT_PENDING", "這則貼文已有你的待處理檢舉。", 409);
+      const row = (await tx.query<ReportRow>(`INSERT INTO platform_public_social_reports
+        (id,reporter_account_id,author_account_id,tenant_id,post_id,reason,detail,public_snapshot)
+        VALUES ($1,$2,$3,$4,$5,$6,$7,$8::jsonb) RETURNING *`, [randomUUID(), actor.platformAccountId,
+        target.author_account_id, data.tenantId, data.postId, data.reason, data.detail, JSON.stringify(projectPost(target, actor))])).rows[0]!;
+      await this.audit(tx, actor, "report", { reportId: row.id });
+      return projectReport(row);
+    });
+  }
+
+  async listReports(actor: PlatformActor) {
+    return this.read(actor, async tx => ({ items: (await tx.query<ReportRow>(`SELECT * FROM platform_public_social_reports
+      WHERE reporter_account_id=$1 ORDER BY created_at DESC,id DESC LIMIT 100`, [actor.platformAccountId])).rows.map(projectReport) }));
+  }
+
+  async listOperatorReports(actor: PlatformActor, input: z.input<typeof PlatformSocialOperatorReportsQuerySchema>) {
+    const query = PlatformSocialOperatorReportsQuerySchema.parse(input);
+    return this.read(actor, async tx => {
+      await this.requireOperator(tx, actor);
+      return { items: (await tx.query<ReportRow>(`SELECT * FROM platform_public_social_reports
+        WHERE ($1::text IS NULL OR state=$1) ORDER BY created_at ASC,id ASC LIMIT $2`, [query.state ?? null, query.limit])).rows
+        .map(row => ({ ...projectReport(row), detail: row.detail, snapshot: row.public_snapshot, decisionReason: row.decision_reason,
+          canDecide: row.state === "open" && row.reporter_account_id !== actor.platformAccountId && row.author_account_id !== actor.platformAccountId })) };
+    });
+  }
+
+  async decideReport(actor: PlatformActor, input: z.input<typeof PlatformSocialDecisionSchema>) {
+    const data = PlatformSocialDecisionSchema.parse(input);
+    return this.write(actor, "decision", data, async tx => {
+      const report = (await tx.query<ReportRow>(`SELECT * FROM platform_public_social_reports WHERE id=$1 FOR UPDATE`, [data.reportId])).rows[0];
+      if (!report) throw notFound();
+      if (report.author_account_id === actor.platformAccountId || report.reporter_account_id === actor.platformAccountId) {
+        throw new DomainError("PLATFORM_SOCIAL_REVIEW_CONFLICT", "本人提出的檢舉或本人的貼文，請交由其他管理員處理。", 403);
+      }
+      if (report.version !== data.expectedVersion || report.state !== "open") throw versionConflict();
+      let postVersion: number | undefined;
+      if (data.decision === "hide") {
+        // Moderators do not inherit a viewer's block list. The public scope gate
+        // remains mandatory, including after the author changes visibility.
+        const post = (await tx.query<PublicPostRow>(`SELECT ${postColumns} ${publicPosts}
+          AND p.tenant_id=$1 AND p.id=$2 FOR UPDATE OF p FOR SHARE OF c,t`, [report.tenant_id, report.post_id])).rows[0];
+        if (!post) throw new DomainError("PLATFORM_SOCIAL_POST_UNAVAILABLE", "貼文已不是公開狀態，請確認後將這筆檢舉結案。", 409);
+        postVersion = post.version + 1;
+        await tx.query(`UPDATE social_posts SET state='removed',version=version+1,updated_at=now()
+          WHERE tenant_id=$1 AND id=$2 AND version=$3`, [post.tenant_id, post.id, post.version]);
+        // Platform moderation has no campus actor: its own immutable audit is
+        // authoritative, rather than inventing a people/identity-subject grant.
+        await this.audit(tx, actor, "hide", { reportId: report.id, postVersion, reason: data.reason });
+      } else await this.audit(tx, actor, "dismiss", { reportId: report.id, reason: data.reason });
+      const changed = (await tx.query<ReportRow>(`UPDATE platform_public_social_reports
+        SET state=$2,version=version+1,decision_reason=$3,decided_by_account_id=$4,decided_at=now()
+        WHERE id=$1 AND version=$5 RETURNING *`, [report.id, data.decision === "hide" ? "hidden" : "dismissed",
+        data.reason, actor.platformAccountId, data.expectedVersion])).rows[0];
+      if (!changed) throw versionConflict();
+      return projectReport(changed);
+    }, true);
+  }
+
+  private async publicTarget(tx: SqlExecutor, actor: PlatformActor, target: { tenantId: string; postId: string }, lock = false) {
+    const row = (await tx.query<PublicPostRow>(`SELECT ${postColumns} ${publicPosts} ${notBlocked}
+      AND p.tenant_id=$2 AND p.id=$3${lock ? " FOR SHARE OF p,c,t" : ""}`, [actor.platformAccountId, target.tenantId, target.postId])).rows[0];
+    if (!row) throw notFound();
+    return row;
+  }
+
+  private async requireBoard(tx: SqlExecutor, tenant: string, board: string) {
+    const row = (await tx.query<{ join_policy: string; posting_policy: string }>(`SELECT c.join_policy,c.posting_policy
+      FROM social_communities c JOIN tenants t ON t.id=c.tenant_id
+      WHERE c.tenant_id=$1 AND c.id=$2 AND c.access_scope='public' AND c.discoverability='listed'
+        AND t.state IN ('provisioned','open') FOR UPDATE OF c FOR SHARE OF t`, [tenant, board])).rows[0];
+    if (!row) throw notFound();
+    return row;
+  }
+
+  private async requireActor(tx: SqlExecutor, actor: PlatformActor, write: boolean) {
+    if (!Number.isFinite(actor.expiresAt) || actor.expiresAt <= Date.now()) throw inactive();
+    // Lock order matches account close/password revocation: account, credential.
+    const account = (await tx.query(`SELECT id FROM platform_accounts WHERE id=$1 AND state='active'
+      FOR ${write ? "UPDATE" : "SHARE"}`, [actor.platformAccountId])).rows[0];
+    if (!account) throw inactive();
+    const credential = (await tx.query(`SELECT id FROM platform_account_credentials
+      WHERE id=$1 AND platform_account_id=$2 AND state='active' FOR SHARE`, [actor.credentialId, actor.platformAccountId])).rows[0];
+    if (!credential) throw inactive();
+  }
+
+  private async requireOperator(tx: SqlExecutor, actor: PlatformActor) {
+    const row = (await tx.query(`SELECT platform_account_id FROM platform_operator_assignments
+      WHERE platform_account_id=$1 AND role_key='platform-operator' AND state='active' FOR SHARE`, [actor.platformAccountId])).rows[0];
+    if (!row) throw new DomainError("PLATFORM_OPERATOR_REQUIRED", "只有平台營運人員可以使用這項操作。", 403);
+  }
+
+  private read<T>(actor: PlatformActor, operation: (tx: SqlExecutor) => Promise<T>) {
+    return this.db.transaction(async tx => { await this.requireActor(tx, actor, false); return operation(tx); });
+  }
+
+  private write<T extends object>(actor: PlatformActor, operation: string, input: { idempotencyKey: string },
+    run: (tx: SqlExecutor) => Promise<T>, operator = false): Promise<T> {
+    return this.db.transaction(async tx => {
+      await this.requireActor(tx, actor, true);
+      if (operator) await this.requireOperator(tx, actor);
+      const hash = socialRequestHash(input);
+      const previous = (await tx.query<{ request_hash: string; response: T }>(`SELECT request_hash,response
+        FROM platform_public_social_idempotency WHERE actor_account_id=$1 AND operation=$2 AND key=$3`,
+      [actor.platformAccountId, operation, input.idempotencyKey])).rows[0];
+      if (previous) {
+        if (previous.request_hash !== hash) throw new DomainError("IDEMPOTENCY_CONFLICT", "這個操作識別碼已用於其他內容，請重新操作。", 409);
+        return previous.response;
+      }
+      const result = await run(tx);
+      await tx.query(`INSERT INTO platform_public_social_idempotency (actor_account_id,operation,key,request_hash,response)
+        VALUES ($1,$2,$3,$4,$5::jsonb)`, [actor.platformAccountId, operation, input.idempotencyKey, hash, JSON.stringify(result)]);
+      return result;
+    });
+  }
+
+  private async audit(tx: SqlExecutor, actor: PlatformActor, action: string, detail: { reportId?: string; blockId?: string; postVersion?: number; reason?: string }) {
+    await tx.query(`INSERT INTO platform_public_social_audit (id,actor_account_id,action,report_id,block_id,post_version,reason)
+      VALUES ($1,$2,$3,$4,$5,$6,$7)`, [randomUUID(), actor.platformAccountId, action, detail.reportId ?? null,
+      detail.blockId ?? null, detail.postVersion ?? null, detail.reason ?? null]);
+  }
+}
+
+function transactionDatabase(db: CampusDatabase, tx: SqlExecutor): CampusDatabase {
+  const transaction: CampusDatabase["transaction"] = async run => run(tx);
+  return { kind: db.kind, query: tx.query.bind(tx), exec: tx.exec.bind(tx), transaction,
+    withPinnedSession: async run => run({ kind: db.kind, query: tx.query.bind(tx), exec: tx.exec.bind(tx), transaction }),
+    checkReadiness: db.checkReadiness.bind(db), close: async () => { throw new Error("Cannot close an active social transaction"); } };
+}
+function projectPost(row: PublicPostRow, actor: PlatformActor) {
+  return { id: row.id, tenantId: row.tenant_id, tenantName: row.tenant_name, communityId: row.community_id,
+    communityName: row.community_name, text: row.text_content, author: { displayName: row.display_name, isSelf: row.author_account_id === actor.platformAccountId },
+    publishedAt: row.published_at, version: row.version };
+}
+function projectReport(row: ReportRow) {
+  return { id: row.id, tenantId: row.tenant_id, postId: row.post_id, state: row.state, version: row.version, reason: row.reason, createdAt: iso(row.created_at) };
+}
+function iso(value: string | Date) { return new Date(value).toISOString(); }
+function notFound() { return new DomainError("PLATFORM_SOCIAL_NOT_FOUND", "找不到這則公開內容。", 404); }
+function inactive() { return new DomainError("PLATFORM_SESSION_INVALID", "登入已失效，請重新登入。", 401); }
+function versionConflict() { return new DomainError("PLATFORM_SOCIAL_VERSION_CONFLICT", "資料已由其他操作更新，請重新載入再處理。", 409); }
