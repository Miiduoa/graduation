+    const personId = await this.db.transaction(async (tx) => {
+      // Serialize first creation with other account operations, then use the
+      // persisted mapping; older personas need not follow today's ID format.
+      const account = await tx.query<{ display_name: string; tenant_name: string }>(
+        `SELECT account.display_name, tenant.display_name AS tenant_name
+           FROM platform_accounts account
+           CROSS JOIN tenants tenant
