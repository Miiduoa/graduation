+
+function samePlaceIdentity(a: CampusMapPlaceLike, b: CampusMapPlaceLike): boolean {
+  return (
+    a.id === b.id &&
+    a.name === b.name &&
+    Math.abs(a.lat - b.lat) < PLACE_COORD_EPSILON &&
+    Math.abs(a.lng - b.lng) < PLACE_COORD_EPSILON
+  );
+}
+
+function allBundledProvidencePlaces(): readonly ProvidencePlace[] {
+  return [...PROVIDENCE_CAMPUS_PLACES, ...PROVIDENCE_BUS_STOPS];
+}
+
+function findBundledProvidencePlace(location: CampusMapPlaceLike): ProvidencePlace | undefined {
+  return allBundledProvidencePlaces().find((entry) => samePlaceIdentity(entry, location));
+}
+
+export function isBusStopLocation(location: CampusMapPlaceLike): boolean {
+  return location.category === '公車站';
+}
+
+function samePlace(a: CampusMapPlaceLike, b: CampusMapPlaceLike): boolean {
+  const latGap = Math.abs(a.lat - b.lat);
+  const lngGap = Math.abs(a.lng - b.lng);
+  return a.name === b.name && latGap < PLACE_COORD_EPSILON && lngGap < PLACE_COORD_EPSILON;
+}
+
+/**
+ * 靜宜第一版地點組裝：
+ * - Firestore 有地點時以它為準，只補上還沒有的公車站牌，讓建築與站牌同圖。
+ * - Firestore 確認為空時，改用隨附的 OpenStreetMap 建築資料加站牌。
+ * - 其他學校原樣回傳，不混入靜宜資料。
+ */
+export function withProvidenceCampusPlaces(
+  schoolId: string,
+  locations: readonly CampusMapPlaceLike[],
+): CampusMapPlaceLike[] {
+  if (schoolId !== 'pu') return [...locations];
+  const base: readonly CampusMapPlaceLike[] = locations.length ? locations : PROVIDENCE_CAMPUS_PLACES;
+  const merged = [...base];
+  for (const stop of PROVIDENCE_BUS_STOPS) {
+    // 同 ID 以伺服器／既有紀錄為準；不同 ID 仍用名稱＋鄰近座標保守去重。
+    if (merged.some((place) => place.id === stop.id || samePlace(place, stop))) continue;
+    merged.push(stop);
+  }
+  return merged.sort((a, b) => a.name.localeCompare(b.name, 'zh-Hant'));
+}
+
+/** 有內建、已核對地點的學校；這些地點不必等外部資料就能先顯示。 */
+export function hasBundledCampusPlaces(schoolId: string): boolean {
+  return schoolId === 'pu';
+}
+
+export function providencePlaceSourceUrl(
+  schoolId: string,
+  location: CampusMapPlaceLike,
+): string | null {
+  if (schoolId !== 'pu') return null;
+  return findBundledProvidencePlace(location)?.sourceUrl ?? null;
+}
+
+/** 只有單一來源、還沒交叉確認的地點，畫面會老實標「待確認」。 */
+export function isProvidencePendingVerification(
+  schoolId: string,
+  location: CampusMapPlaceLike,
+): boolean {
+  if (schoolId !== 'pu') return false;
+  return findBundledProvidencePlace(location)?.verification === 'single-source';
+}
+
+/** OpenStreetMap 閘門標記，與校方「如何到靜宜」GPS（24.2257, 120.5772）相距約 11 公尺。 */
+export const PROVIDENCE_WALK_ORIGIN = {
+  lat: 24.225714,
+  lng: 120.577096,
+} as const;
+
+export function walkingMinutesFromMeters(distanceInMeters: number): number | null {
+  if (!Number.isFinite(distanceInMeters) || distanceInMeters < 0) return null;
+  return Math.max(1, Math.round(distanceInMeters / WALKING_METERS_PER_MINUTE));
+}
+
+/**
+ * 用直線距離粗估步行時間：公尺 ÷ 每分鐘 80 公尺，四捨五入，最少 1 分鐘。
+ * 這不是路線導航時間，畫面必須把公式寫出來。
+ */
+export function walkingEstimateLabel(distanceInMeters: number): string {
+  const minutes = walkingMinutesFromMeters(distanceInMeters);
+  if (minutes == null) return '';
+  const metres = Math.round(distanceInMeters);
+  return `步行約 ${minutes} 分鐘（直線 ${metres} 公尺 ÷ 每分鐘 ${WALKING_METERS_PER_MINUTE} 公尺，四捨五入；不是導航路線時間）`;
+}
+
+export function locationSearchText(location: CampusMapPlaceLike): string {
+  return [
+    location.name,
+    location.category,
+    location.description,
+    location.building,
+    location.floor,
+    ...(location.facilities ?? []),
+  ]
+    .filter(Boolean)
+    .join(' ');
+}
+
+export function locationMatchesSearch(location: CampusMapPlaceLike, rawTerm: string): boolean {
+  const term = rawTerm.trim().toLocaleLowerCase('zh-TW');
+  if (!term) return true;
+  return locationSearchText(location).toLocaleLowerCase('zh-TW').includes(term);
+}
