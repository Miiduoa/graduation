@@ -0,0 +1,191 @@
+import { randomUUID } from "node:crypto";
+import { afterEach, beforeEach, describe, expect, it } from "vitest";
+import { createDatabase, type CampusDatabase } from "../database";
+import { PlatformAccountService, type PlatformActor } from "./platform-account-service";
+import { PlatformSocialService } from "./platform-social-service";
+import { SocialService } from "../social/social-service";
+
+describe("platform public social", () => {
+  let db: CampusDatabase;
+  let accounts: PlatformAccountService;
+  let service: PlatformSocialService;
+  let author: PlatformActor;
+  let reader: PlatformActor;
+  let operator: PlatformActor;
+  const key = () => randomUUID();
+
+  async function account(name: string) {
+    const platformAccountId = `pa_${randomUUID()}`;
+    const credentialId = `pac_${randomUUID()}`;
+    await db.query(`INSERT INTO platform_accounts (id,display_name) VALUES ($1,$2)`, [platformAccountId, name]);
+    await db.query(`INSERT INTO platform_account_credentials
+      (id,platform_account_id,method,provider_issuer,provider_subject,verified_at,last_authenticated_at)
+      VALUES ($1,$2,'google','https://accounts.google.com',$3,now(),now())`, [credentialId, platformAccountId, key()]);
+    return { platformAccountId, credentialId, expiresAt: Date.now() + 3_600_000 };
+  }
+
+  beforeEach(async () => {
+    db = await createDatabase({ attendanceCodeSecret: "public-social-test-secret-over-thirty-two-characters" });
+    accounts = new PlatformAccountService(db, { verify: async () => { throw new Error("unused"); } });
+    service = new PlatformSocialService(db, accounts);
+    author = await account("作者");
+    reader = await account("讀者");
+    operator = await account("營運人員");
+    await db.query(`INSERT INTO platform_operator_assignments (platform_account_id,role_key,state)
+      VALUES ($1,'platform-operator','active')`, [operator.platformAccountId]);
+    for (const tenant of ["campus-demo", "nccu"]) {
+      await db.query(`INSERT INTO people
+        (tenant_id,id,student_number,display_name,program,curriculum_version,study_year,campus,credential_status)
+        VALUES ($1,'public-board-owner','PUBLICOWNER','看板管理','一般使用者','platform',1,'公開社群','active')`, [tenant]);
+      await db.query(`INSERT INTO social_profiles (tenant_id,id,person_id,handle,display_name)
+        VALUES ($1,'public-board-owner','public-board-owner','public-board-owner','看板管理')`, [tenant]);
+      await db.query(`INSERT INTO social_communities
+        (tenant_id,id,kind,name,discoverability,join_policy,posting_policy,owner_profile_id,access_scope)
+        VALUES ($1,'public-board','group','公開交流','listed','open','members','public-board-owner','public')`, [tenant]);
+    }
+  }, 60_000);
+
+  afterEach(async () => { await db?.close(); });
+
+  it("publishes real posts in an open board and keeps private/unlisted/suspended content out of every target lookup", async () => {
+    const post = await service.createPost(author, { tenantId: "campus-demo", communityId: "public-board", text: "跨校交流", idempotencyKey: key() });
+    expect((await service.feed(reader, {})).items.some(item => item.id === post.id)).toBe(true);
+    expect(post.author).toEqual({ displayName: "作者", isSelf: true });
+    await db.query(`UPDATE social_posts SET visibility='community-members' WHERE tenant_id=$1 AND id=$2`, [post.tenantId, post.id]);
+    await expect(service.getPost(reader, { tenantId: post.tenantId, postId: post.id })).rejects.toMatchObject({ statusCode: 404 });
+    await expect(service.report(reader, { tenantId: post.tenantId, postId: post.id, reason: "spam", idempotencyKey: key() })).rejects.toMatchObject({ statusCode: 404 });
+    await expect(service.blockAuthor(reader, { tenantId: post.tenantId, postId: post.id, idempotencyKey: key() })).rejects.toMatchObject({ statusCode: 404 });
+    await db.query(`UPDATE social_posts SET visibility='public-campus' WHERE tenant_id=$1 AND id=$2`, [post.tenantId, post.id]);
+    await db.query(`UPDATE social_communities SET discoverability='unlisted' WHERE tenant_id='campus-demo' AND id='public-board'`);
+    expect((await service.feed(reader, { tenantId: "campus-demo" })).items).toEqual([]);
