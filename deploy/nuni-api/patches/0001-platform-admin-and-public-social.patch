diff --git a/apps/api/src/migrations/275_platform_password_administrators.sql b/apps/api/src/migrations/275_platform_password_administrators.sql
new file mode 100644
index 0000000..7edadfa
--- /dev/null
+++ b/apps/api/src/migrations/275_platform_password_administrators.sql
@@ -0,0 +1,52 @@
+ALTER TABLE platform_account_credentials
+  DROP CONSTRAINT platform_account_credentials_method_check;
+
+ALTER TABLE platform_account_credentials
+  ADD CONSTRAINT platform_account_credentials_method_check
+    CHECK (method IN ('google', 'apple', 'qa', 'password'));
+
+CREATE TABLE platform_password_credentials (
+  credential_id text PRIMARY KEY,
+  platform_account_id text NOT NULL UNIQUE REFERENCES platform_accounts(id),
+  email text NOT NULL UNIQUE CHECK (email = lower(btrim(email)) AND length(email) BETWEEN 3 AND 254),
+  password_hash text NOT NULL CHECK (length(password_hash) BETWEEN 80 AND 256),
+  created_at timestamptz NOT NULL DEFAULT now(),
+  updated_at timestamptz NOT NULL DEFAULT now(),
+  FOREIGN KEY (credential_id, platform_account_id)
+    REFERENCES platform_account_credentials(id, platform_account_id)
+);
+
+-- Unknown and existing accounts share the same lockout path. No email or
+-- submitted password is stored in the failed-attempt record.
+CREATE TABLE platform_password_login_throttles (
+  login_key text PRIMARY KEY CHECK (login_key ~ '^[a-f0-9]{64}$'),
+  failure_count integer NOT NULL DEFAULT 0 CHECK (failure_count BETWEEN 0 AND 5),
+  window_started_at timestamptz NOT NULL DEFAULT now(),
+  locked_until timestamptz,
+  updated_at timestamptz NOT NULL DEFAULT now()
+);
+
+CREATE INDEX platform_password_login_throttles_expiry_idx
+  ON platform_password_login_throttles(updated_at);
+
+CREATE TABLE platform_password_admin_audit (
+  id text PRIMARY KEY CHECK (id ~ '^ppa_[0-9a-f-]{36}$'),
+  platform_account_id text NOT NULL REFERENCES platform_accounts(id),
+  credential_id text NOT NULL REFERENCES platform_account_credentials(id),
+  action text NOT NULL CHECK (action IN ('create-account', 'add-credential', 'rotate-password')),
+  operator_grant text NOT NULL CHECK (operator_grant IN ('grant', 'restore', 'unchanged')),
+  performed_by text NOT NULL CHECK (length(btrim(performed_by)) BETWEEN 3 AND 100),
+  reason text NOT NULL CHECK (length(btrim(reason)) BETWEEN 5 AND 1000),
+  created_at timestamptz NOT NULL DEFAULT now()
+);
+
+CREATE FUNCTION platform_password_admin_audit_append_only()
+RETURNS trigger LANGUAGE plpgsql AS $$
+BEGIN
+  RAISE EXCEPTION 'administrator credential audit is append-only' USING ERRCODE = '42501';
+END;
+$$;
+
+CREATE TRIGGER platform_password_admin_audit_guard
+BEFORE UPDATE OR DELETE ON platform_password_admin_audit
+FOR EACH ROW EXECUTE FUNCTION platform_password_admin_audit_append_only();
diff --git a/apps/api/src/migrations/276_platform_public_social.sql b/apps/api/src/migrations/276_platform_public_social.sql
new file mode 100644
index 0000000..01f1332
--- /dev/null
+++ b/apps/api/src/migrations/276_platform_public_social.sql
@@ -0,0 +1,72 @@
+CREATE TABLE platform_public_social_blocks (
+  id text PRIMARY KEY,
+  owner_account_id text NOT NULL REFERENCES platform_accounts(id),
+  target_account_id text NOT NULL REFERENCES platform_accounts(id),
+  state text NOT NULL DEFAULT 'active' CHECK (state IN ('active','revoked')),
+  version integer NOT NULL DEFAULT 1 CHECK (version > 0),
+  created_at timestamptz NOT NULL DEFAULT now(),
+  updated_at timestamptz NOT NULL DEFAULT now(),
+  UNIQUE (owner_account_id,target_account_id),
+  CHECK (owner_account_id <> target_account_id)
+);
+CREATE INDEX platform_public_social_blocks_target_idx
+  ON platform_public_social_blocks (target_account_id,owner_account_id) WHERE state='active';
+
+CREATE TABLE platform_public_social_reports (
+  id text PRIMARY KEY,
+  reporter_account_id text NOT NULL REFERENCES platform_accounts(id),
+  author_account_id text NOT NULL REFERENCES platform_accounts(id),
+  tenant_id text NOT NULL,
+  post_id text NOT NULL,
+  reason text NOT NULL CHECK (reason IN ('harassment','spam','privacy','hate','violence','other')),
+  detail text NOT NULL DEFAULT '' CHECK (length(detail) <= 2000),
+  public_snapshot jsonb NOT NULL,
+  state text NOT NULL DEFAULT 'open' CHECK (state IN ('open','hidden','dismissed')),
+  version integer NOT NULL DEFAULT 1 CHECK (version > 0),
+  decision_reason text,
+  decided_by_account_id text REFERENCES platform_accounts(id),
+  decided_at timestamptz,
+  created_at timestamptz NOT NULL DEFAULT now(),
+  FOREIGN KEY (tenant_id,post_id) REFERENCES social_posts(tenant_id,id),
+  CHECK (reporter_account_id <> author_account_id),
+  CHECK (decided_by_account_id IS NULL OR
+    (decided_by_account_id <> reporter_account_id AND decided_by_account_id <> author_account_id)),
+  CHECK ((state='open' AND decided_at IS NULL AND decided_by_account_id IS NULL AND decision_reason IS NULL)
+    OR (state<>'open' AND decided_at IS NOT NULL AND decided_by_account_id IS NOT NULL AND length(btrim(decision_reason)) BETWEEN 5 AND 2000))
+);
+CREATE UNIQUE INDEX platform_public_social_reports_open_idx
+  ON platform_public_social_reports (reporter_account_id,tenant_id,post_id) WHERE state='open';
+CREATE INDEX platform_public_social_reports_queue_idx
+  ON platform_public_social_reports (state,created_at,id);
+
+CREATE TABLE platform_public_social_idempotency (
+  actor_account_id text NOT NULL REFERENCES platform_accounts(id),
+  operation text NOT NULL,
+  key text NOT NULL CHECK (length(key) BETWEEN 8 AND 100),
+  request_hash text NOT NULL CHECK (request_hash ~ '^[a-f0-9]{64}$'),
+  response jsonb NOT NULL,
+  created_at timestamptz NOT NULL DEFAULT now(),
+  PRIMARY KEY (actor_account_id,operation,key)
+);
+
+CREATE TABLE platform_public_social_audit (
+  id text PRIMARY KEY,
+  actor_account_id text NOT NULL REFERENCES platform_accounts(id),
+  action text NOT NULL CHECK (action IN ('block','unblock','report','hide','dismiss')),
+  report_id text REFERENCES platform_public_social_reports(id),
+  block_id text REFERENCES platform_public_social_blocks(id),
+  post_version integer,
+  reason text,
+  created_at timestamptz NOT NULL DEFAULT now(),
+  CHECK ((action IN ('block','unblock') AND block_id IS NOT NULL AND report_id IS NULL)
+    OR (action IN ('report','hide','dismiss') AND report_id IS NOT NULL AND block_id IS NULL))
+);
+
+CREATE FUNCTION reject_platform_public_social_audit_change() RETURNS trigger LANGUAGE plpgsql AS $$
+BEGIN
+  RAISE EXCEPTION 'platform public social audit is append-only';
+END;
+$$;
+CREATE TRIGGER platform_public_social_audit_append_only
+  BEFORE UPDATE OR DELETE ON platform_public_social_audit
+  FOR EACH ROW EXECUTE FUNCTION reject_platform_public_social_audit_change();
diff --git a/apps/api/src/platform-password-admin-cli.ts b/apps/api/src/platform-password-admin-cli.ts
new file mode 100644
index 0000000..5a17513
--- /dev/null
+++ b/apps/api/src/platform-password-admin-cli.ts
@@ -0,0 +1,61 @@
+import { resolve } from "node:path";
+import { fileURLToPath } from "node:url";
+import { createDatabase } from "./database";
+import { readDatabaseRuntimeConfig } from "./database-runtime-config";
+import { DomainError } from "./domain-error";
+import { provisionPlatformPasswordAdmin, type PlatformPasswordProvisionInput } from "./accounts/platform-password-provisioning";
+
+export async function readProvisionInput(stream: AsyncIterable<Uint8Array | string>): Promise<PlatformPasswordProvisionInput> {
+  const chunks: Buffer[] = [];
+  let length = 0;
+  for await (const chunk of stream) {
+    const buffer = Buffer.from(chunk);
+    length += buffer.length;
+    if (length > 8192) throw new Error("INPUT_TOO_LARGE");
+    chunks.push(buffer);
+  }
+  const buffer = Buffer.concat(chunks);
+  try {
+    const value: unknown = JSON.parse(buffer.toString("utf8"));
+    if (!value || typeof value !== "object" || Array.isArray(value)) throw new Error("INVALID_INPUT");
+    const allowed = new Set(["email", "password", "displayName", "reason", "performedBy", "expectedAccountId"]);
+    if (Object.keys(value).some((key) => !allowed.has(key))) throw new Error("INVALID_INPUT");
+    return value as PlatformPasswordProvisionInput;
+  } finally {
+    buffer.fill(0);
+    for (const chunk of chunks) chunk.fill(0);
+  }
+}
+
+export async function main(args = process.argv.slice(2)): Promise<void> {
+  if (args.some((arg) => arg !== "--apply" && arg !== "--rotate-password")
+    || (args.includes("--rotate-password") && !args.includes("--apply")) || process.stdin.isTTY) {
+    throw new Error("Use stdin JSON; flags: --apply [--rotate-password]. No credentials in arguments.");
+  }
+  const input = await readProvisionInput(process.stdin);
+  const isProduction = process.env.NODE_ENV === "production";
+  const runtimeConfig = readDatabaseRuntimeConfig(process.env, { isProduction, component: "migrate", allowEmbedded: !isProduction });
+  const db = await createDatabase({
+    runtimeConfig,
+    schemaMode: "verify",
+    seedDemo: false,
+    attendanceCodeSecret: "password-provision-does-not-use-attendance",
+  });
+  try {
+    const result = await provisionPlatformPasswordAdmin(db, input, { apply: args.includes("--apply"), rotatePassword: args.includes("--rotate-password") });
+    process.stdout.write(`${JSON.stringify(result)}\n`);
+  } finally {
+    delete input.password;
+    await db.close();
+  }
+}
+
+if (process.argv[1] && resolve(process.argv[1]) === fileURLToPath(import.meta.url)) {
+  try {
+    await main();
+  } catch (error) {
+    // Driver/JSON error messages can contain supplied values; never print them.
+    process.stderr.write(`${error instanceof DomainError ? error.code : "PLATFORM_PASSWORD_PROVISION_FAILED"}\n`);
+    process.exitCode = 1;
+  }
+}
