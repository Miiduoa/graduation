{
  "name": "mobile",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "dev": "expo start",
    "start": "expo start",
    "start:clean": "expo start -c",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "ios:sim": "expo run:ios",
    "web": "expo start --web",
    "lint": "eslint App.tsx src --ext .ts,.tsx",
    "test": "NODE_OPTIONS='--max-old-space-size=4096' jest --runInBand",
    "test:ai:self": "NODE_OPTIONS='--max-old-space-size=4096' EXPO_PUBLIC_AI_PROVIDER=offline EXPO_PUBLIC_AI_TEST_FAST=1 AI_SELF_TEST_ROUNDS=${AI_SELF_TEST_ROUNDS:-10000} jest src/__tests__/services/aiSelfDialog.test.ts --runInBand",
    "ai:train:long": "NODE_OPTIONS='--max-old-space-size=8192 --expose-gc' EXPO_PUBLIC_AI_PROVIDER=offline EXPO_PUBLIC_AI_TEST_FAST=1 jest --config jest.ai-training.config.js --runInBand --testTimeout=8000000",
    "ai:train:long:2h:5m": "bash scripts/ai-training-2h-5min-batches.sh",
    "test:ai:marathon": "bash ../../scripts/ai-app-scenario-marathon.sh",
    "test:ai:proactive": "NODE_OPTIONS='--max-old-space-size=4096' jest src/__tests__/services/proactiveAI.test.ts --runInBand",
    "test:ai:web": "NODE_OPTIONS='--max-old-space-size=4096' jest src/__tests__/services/webSearch.test.ts src/__tests__/services/webLearning.test.ts src/__tests__/services/aiWebSearchIntegration.test.ts --runInBand",
    "test:watch": "NODE_OPTIONS='--max-old-space-size=4096' jest --watch --runInBand",
    "test:coverage": "NODE_OPTIONS='--max-old-space-size=4096' jest --coverage --runInBand",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "e2e:maestro:nav": "MAESTRO_DRIVER_STARTUP_TIMEOUT=120000 maestro test .maestro/flows/11_navigation_ai_first.yaml --env APP_ID=com.campus.app",
    "e2e:maestro:nav:dev": "MAESTRO_DRIVER_STARTUP_TIMEOUT=120000 maestro test .maestro/flows/11_navigation_ai_first.yaml --env APP_ID=com.campus.app.dev",
    "e2e:maestro:onboarding": "MAESTRO_DRIVER_STARTUP_TIMEOUT=120000 maestro test .maestro/flows/01_onboarding.yaml --env APP_ID=com.campus.app",
    "e2e:maestro:onboarding:dev": "MAESTRO_DRIVER_STARTUP_TIMEOUT=120000 maestro test .maestro/flows/01_onboarding.yaml --env APP_ID=com.campus.app.dev",
    "e2e:maestro:all:dev": "MAESTRO_DRIVER_STARTUP_TIMEOUT=120000 maestro test .maestro/flows --env APP_ID=com.campus.app.dev",
    "e2e:maestro:all:prod": "MAESTRO_DRIVER_STARTUP_TIMEOUT=120000 maestro test .maestro/flows --env APP_ID=com.campus.app"
  },
  "dependencies": {
    "@campus/shared": "workspace:*",
    "@expo/metro-runtime": "^6.1.2",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/netinfo": "^11.4.1",
    "@react-native-firebase/analytics": "^23.8.6",
    "@react-native-firebase/app": "^23.8.6",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/native": "^7.1.8",
    "@react-navigation/native-stack": "^7.3.16",
    "dotenv": "^17.3.1",
    "expo": "~54.0.33",
    "expo-auth-session": "~7.0.10",
    "expo-av": "~16.0.8",
    "expo-blur": "~15.0.8",
    "expo-calendar": "~15.0.8",
    "expo-camera": "~17.0.10",
    "expo-clipboard": "~8.0.8",
    "expo-constants": "~18.0.13",
    "expo-crypto": "^15.0.8",
    "expo-device": "^8.0.10",
    "expo-document-picker": "^14.0.8",
    "expo-file-system": "^19.0.21",
    "expo-haptics": "~15.0.8",
    "expo-image-picker": "~17.0.10",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.11",
    "expo-local-authentication": "^17.0.8",
    "expo-localization": "^17.0.8",
    "expo-location": "~19.0.8",
    "expo-mail-composer": "~15.0.8",
    "expo-media-library": "~18.2.1",
    "expo-notifications": "^0.32.16",
    "expo-print": "~15.0.8",
    "expo-secure-store": "~15.0.7",
    "expo-sensors": "~15.0.8",
    "expo-sharing": "^14.0.8",
    "expo-status-bar": "~3.0.9",
    "expo-web-browser": "^15.0.10",
    "firebase": "^12.8.0",
    "ical.js": "^2.2.1",
    "llama.rn": "^0.4.8",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.16.0",
    "react-native-web": "^0.21.2",
    "react-native-webview": "~13.13.5"
  },
  "devDependencies": {
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^13.3.0",
    "@types/jest": "^29.5.14",
    "@types/minimatch": "3.0.5",
    "@types/react": "~19.1.0",
    "jest": "^29.7.0",
    "jest-expo": "~54.0.0",
    "react-test-renderer": "19.1.0",
    "typescript": "~5.9.2"
  },
  "private": true,
  "expo": {
    "doctor": {
      "_comment": "demo 期間刻意忽略的 check（不是程式問題）：ios/android folder + app.config.ts 並存是 prebuild 後刻意保留。",
      "appConfigFieldsNotSyncedCheck": {
        "enabled": false
      },
      "reactNativeDirectoryCheck": {
        "enabled": false
      }
    },
    "install": {
      "_comment": "patch / minor 版本對齊由獨立 expo upgrade PR 處理，這裡 exclude 讓 expo-doctor 不再 fail Build Mobile CI。",
      "exclude": [
        "expo",
        "expo-auth-session",
        "expo-crypto",
        "expo-file-system",
        "expo-image-picker",
        "expo-linking",
        "expo-notifications",
        "expo-web-browser",
        "react-native-webview"
      ]
    }
  }
}
