diff --git a/apps/api/src/accounts/platform-password-service.pg.test.ts b/apps/api/src/accounts/platform-password-service.pg.test.ts
new file mode 100644
index 0000000..c30ada3
--- /dev/null
+++ b/apps/api/src/accounts/platform-password-service.pg.test.ts
@@ -0,0 +1,47 @@
+import { randomUUID } from "node:crypto";
+import { afterAll, beforeAll, describe, expect, it } from "vitest";
+import { createDatabase, type CampusDatabase } from "../database";
+import { PlatformAccountService } from "./platform-account-service";
+import { PlatformPasswordService, passwordLoginKey } from "./platform-password-service";
+import { provisionPlatformPasswordAdmin } from "./platform-password-provisioning";
+
+const url = process.env.PLATFORM_PASSWORD_PG_TEST_URL;
+describe.skipIf(!url)("password throttling across real PostgreSQL pools", () => {
+  let first: CampusDatabase;
+  let second: CampusDatabase;
+  const password = "PostgreSQL test-only password";
+  const suffix = randomUUID();
+  const input = (email: string) => ({ email, password, performedBy: "postgres-test", reason: "Cross-pool administrator security test" });
+  function service(db: CampusDatabase) {
+    return new PlatformPasswordService(db, new PlatformAccountService(db, { verify: async () => { throw new Error("unused"); } }));
+  }
+  beforeAll(async () => {
+    const runtimeConfig = {
+      kind: "postgres" as const, url: url!, tlsMode: "disable" as const,
+      applicationName: "campus-password-security-test", pool: { max: 1, ssl: false, statement_timeout: 10_000 },
+    };
+    first = await createDatabase({ runtimeConfig, attendanceCodeSecret: "password-pg-test-not-production", seedDemo: false });
+    second = await createDatabase({ runtimeConfig, attendanceCodeSecret: "password-pg-test-not-production", seedDemo: false, schemaMode: "verify" });
+  }, 60_000);
+  afterAll(async () => { await first?.close(); await second?.close(); });
+
+  it("does not lose failures or allow a second pool to bypass account lockout", async () => {
+    const email = `parallel-${suffix}@example.test`;
+    await provisionPlatformPasswordAdmin(first, input(email), { apply: true });
+    const workers = [service(first), service(second)];
+    const attempts = await Promise.allSettled(Array.from({ length: 8 }, (_, index) => workers[index % 2]!.login({ email, password: "incorrect test-only password" })));
+    expect(attempts.every((result) => result.status === "rejected")).toBe(true);
+    expect((await second.query<{ failure_count: number }>(`SELECT failure_count FROM platform_password_login_throttles WHERE login_key=$1`, [passwordLoginKey(email)])).rows[0]?.failure_count).toBe(5);
+    await expect(service(second).login({ email, password })).rejects.toMatchObject({ code: "PLATFORM_PASSWORD_LOGIN_INVALID" });
+  }, 20_000);
+
+  it("lets only one concurrent provisioning transaction create an administrator", async () => {
+    const email = `provision-${suffix}@example.test`;
+    const attempts = await Promise.allSettled([first, second].map((db) => provisionPlatformPasswordAdmin(db, input(email), { apply: true })));
+    expect(attempts.filter((result) => result.status === "fulfilled")).toHaveLength(1);
+    expect(attempts.filter((result) => result.status === "rejected")).toHaveLength(1);
+    expect((await first.query<{ count: number }>(`SELECT count(*)::int AS count FROM platform_accounts WHERE primary_email=$1`, [email])).rows[0]?.count).toBe(1);
+    expect((await first.query<{ count: number }>(`SELECT count(*)::int AS count FROM platform_password_admin_audit audit
+      JOIN platform_accounts account ON account.id=audit.platform_account_id WHERE account.primary_email=$1`, [email])).rows[0]?.count).toBe(1);
+  }, 20_000);
+});
