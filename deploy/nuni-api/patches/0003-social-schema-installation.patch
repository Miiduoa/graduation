@@ -3,6 +3,7 @@ import type { CampusDatabase } from "../database";
 import {
   BUILTIN_EVENT_SCHEMAS,
   BUILTIN_FOOD_EVENT_SCHEMAS,
+  BUILTIN_SOCIAL_EVENT_SCHEMAS,
   isAutomaticallyRegisteredBuiltinEventSchema,
   type BuiltinEventSchema,
 } from "./builtin-event-schemas";
@@ -13,7 +14,7 @@ import { EventSchemaService } from "./event-schema-service";
 export const BUILTIN_EVENT_SCHEMA_AUTHOR_PERSON_ID = "nuni-event-schema-author";
 export const BUILTIN_EVENT_SCHEMA_REVIEWER_PERSON_ID = "nuni-event-schema-reviewer";

-export type BuiltinEventSchemaInstallSet = "food" | "automatic";
+export type BuiltinEventSchemaInstallSet = "food" | "social" | "automatic";

 export interface InstallBuiltinEventSchemasOptions {
   tenantId: string;
@@ -36,7 +37,8 @@ export interface InstallBuiltinEventSchemasResult {
 export function schemasForBuiltinEventSchemaInstallSet(
   set: BuiltinEventSchemaInstallSet,
 ): readonly BuiltinEventSchema[] {
-  const source = set === "automatic" ? BUILTIN_EVENT_SCHEMAS : BUILTIN_FOOD_EVENT_SCHEMAS;
+  const source = set === "automatic" ? BUILTIN_EVENT_SCHEMAS
+    : set === "social" ? BUILTIN_SOCIAL_EVENT_SCHEMAS : BUILTIN_FOOD_EVENT_SCHEMAS;
   return source.filter(isAutomaticallyRegisteredBuiltinEventSchema);
 }

@@ -58,8 +60,8 @@ export function parseEventSchemaSeedTenantIds(

 export function parseEventSchemaSeedSet(environment: NodeJS.ProcessEnv): BuiltinEventSchemaInstallSet {
   const raw = environment.CAMPUS_EVENT_SCHEMA_SET?.trim().toLowerCase() || "food";
-  if (raw !== "food" && raw !== "automatic") {
-    throw new Error("CAMPUS_EVENT_SCHEMA_SET 只能是 food 或 automatic");
+  if (raw !== "food" && raw !== "social" && raw !== "automatic") {
+    throw new Error("CAMPUS_EVENT_SCHEMA_SET 只能是 food、social 或 automatic");
   }
   return raw;
 }
diff --git a/apps/api/src/event-governance/install-social-event-schemas.test.ts b/apps/api/src/event-governance/install-social-event-schemas.test.ts
new file mode 100644
index 0000000..6a2a643
--- /dev/null
+++ b/apps/api/src/event-governance/install-social-event-schemas.test.ts
@@ -0,0 +1,149 @@
+import { randomUUID } from "node:crypto";
+import { afterEach, beforeEach, describe, expect, it } from "vitest";
+import { PlatformAccountService, type PlatformActor } from "../accounts/platform-account-service";
+import { PlatformSocialService } from "../accounts/platform-social-service";
+import { createDatabase, type CampusDatabase } from "../database";
+import { SocialService } from "../social/social-service";
+import { BUILTIN_SOCIAL_EVENT_SCHEMAS, isAutomaticallyRegisteredBuiltinEventSchema } from "./builtin-event-schemas";
+import { eventSchemaSha256 } from "./event-schema-runtime";
+import {
+  BUILTIN_EVENT_SCHEMA_AUTHOR_PERSON_ID,
+  BUILTIN_EVENT_SCHEMA_REVIEWER_PERSON_ID,
+  installAutomaticallyRegisteredBuiltinEventSchemas,
+  schemasForBuiltinEventSchemaInstallSet,
+} from "./install-builtin-event-schemas";
+
+describe("social event schema installation for a real tenant", () => {
+  let db: CampusDatabase;
+  const tenantId = "social-release-school";
+
+  beforeEach(async () => {
+    db = await createDatabase({ seedDemo: false, attendanceCodeSecret: "social-release-secret-over-thirty-two-characters" });
+    await db.query(`INSERT INTO tenants (id,display_name,state,directory_source)
+      VALUES ($1,'社群契約驗證校','open','manual')`, [tenantId]);
+  }, 60_000);
+
+  afterEach(async () => { await db?.close(); });
+
+  async function account(displayName: string): Promise<PlatformActor> {
+    const platformAccountId = `pa_${randomUUID()}`;
+    const credentialId = `pac_${randomUUID()}`;
+    await db.query(`INSERT INTO platform_accounts (id,display_name) VALUES ($1,$2)`, [platformAccountId, displayName]);
+    await db.query(`INSERT INTO platform_account_credentials
+      (id,platform_account_id,method,provider_issuer,provider_subject,verified_at,last_authenticated_at)
+      VALUES ($1,$2,'google','https://accounts.google.com',$3,now(),now())`,
+    [credentialId, platformAccountId, randomUUID()]);
+    return { platformAccountId, credentialId, expiresAt: Date.now() + 3_600_000 };
+  }
+
+  async function count(table: "social_communities" | "social_posts" | "outbox_events" | "platform_event_schemas") {
+    return (await db.query<{ count: number }>(`SELECT count(*)::int AS count FROM ${table} WHERE tenant_id=$1`, [tenantId])).rows[0]!.count;
+  }
+
+  it("keeps board and post writes fail-closed until social-only contracts are installed with governed audit", async () => {
+    const accounts = new PlatformAccountService(db, { verify: async () => { throw new Error("unused"); } });
+    const service = new PlatformSocialService(db, accounts, { eventSchemaEnforcement: "enforce" });
+    const operator = await account("校園營運");
+    const reader = await account("公開交流使用者");
+    await db.query(`INSERT INTO platform_operator_assignments (platform_account_id,role_key,state)
+      VALUES ($1,'platform-operator','active')`, [operator.platformAccountId]);
+    const boardInput = { tenantId, name: "跨校問答", description: "各校公開交流", idempotencyKey: randomUUID() };
+
+    await expect(service.createBoard(operator, boardInput)).rejects.toMatchObject({
+      code: "EVENT_PUBLISH_SCHEMA_UNAVAILABLE", statusCode: 503,
+      message: expect.stringContaining("social.membership.changed@1.0.0"),
+    });
+    expect(await count("social_communities")).toBe(0);
+    expect(await count("outbox_events")).toBe(0);
+    expect(await count("platform_event_schemas")).toBe(0);
+
+    // An existing board/member fixture isolates the post event prerequisite;
+    // no service ever runs with enforcement disabled to create this fixture.
+    const social = new SocialService(db, { eventSchemaEnforcement: "enforce" });
+    const owner = await accounts.resolvePublicRealmActor(operator, tenantId, { forCommunityCreation: true });
+    const ownerProfile = await social.getSelfProfile(owner);
+    const existingBoardId = randomUUID();
+    await db.query(`INSERT INTO social_communities
+      (tenant_id,id,kind,name,discoverability,join_policy,posting_policy,owner_profile_id,access_scope)
+      VALUES ($1,$2,'group','既有公開看板','listed','open','members',$3,'public')`,
+    [tenantId, existingBoardId, ownerProfile.id]);
+    const readerPersona = await accounts.resolvePublicRealmActor(reader, tenantId);
+    const readerProfile = await social.getSelfProfile(readerPersona);
+    await db.query(`INSERT INTO social_memberships (tenant_id,id,community_id,profile_id,role,state)
+      VALUES ($1,$2,$3,$4,'member','active')`, [tenantId, randomUUID(), existingBoardId, readerProfile.id]);
+    const postInput = { tenantId, communityId: existingBoardId, text: "公開交流內容", idempotencyKey: randomUUID() };
+    await expect(service.createPost(reader, postInput)).rejects.toMatchObject({
+      code: "EVENT_PUBLISH_SCHEMA_UNAVAILABLE", statusCode: 503,
+      message: expect.stringContaining("social.post.created@1.0.0"),
+    });
+    expect(await count("social_posts")).toBe(0);
+    expect(await count("outbox_events")).toBe(0);
+
+    const schemas = schemasForBuiltinEventSchemaInstallSet("social");
+    expect(schemas).toEqual(BUILTIN_SOCIAL_EVENT_SCHEMAS.filter(isAutomaticallyRegisteredBuiltinEventSchema));
+    expect(schemas).toHaveLength(30);
+    expect(schemas.every(schema => schema.owningModule === "social")).toBe(true);
+    expect(await installAutomaticallyRegisteredBuiltinEventSchemas(db, { tenantId, schemas })).toEqual({
+      tenantId, considered: 30, registered: 30, activated: 30, alreadyActive: 0,
+    });
+
+    const rows = (await db.query<{
+      event_type: string; schema_version: string; schema_sha256: string; state: string;
+      version: number; created_by: string; reviewed_by: string;
+    }>(`SELECT event_type,schema_version,schema_sha256,state,version,created_by,reviewed_by
+      FROM platform_event_schemas WHERE tenant_id=$1`, [tenantId])).rows;
+    expect(rows).toHaveLength(30);
+    for (const schema of schemas) {
+      expect(rows.find(row => row.event_type === schema.eventType && row.schema_version === schema.schemaVersion)).toEqual({
+        event_type: schema.eventType, schema_version: schema.schemaVersion,
+        schema_sha256: eventSchemaSha256(schema.eventType, schema.schemaVersion, schema.payloadSchema),
+        state: "active", version: 2,
+        created_by: BUILTIN_EVENT_SCHEMA_AUTHOR_PERSON_ID, reviewed_by: BUILTIN_EVENT_SCHEMA_REVIEWER_PERSON_ID,
+      });
+    }
+    const audit = async () => (await db.query<{
+      event_type: string; schema_version: string; action: string; actor_id: string; reason_code: string;
+    }>(`SELECT event_type,schema_version,action,actor_id,reason_code FROM platform_event_schema_audit
+      WHERE tenant_id=$1 ORDER BY event_type,schema_version,action`, [tenantId])).rows;
+    const firstAudit = await audit();
+    expect(firstAudit).toHaveLength(60);
+    for (const schema of schemas) {
+      expect(firstAudit).toContainEqual({ event_type: schema.eventType, schema_version: schema.schemaVersion,
+        action: "registered", actor_id: BUILTIN_EVENT_SCHEMA_AUTHOR_PERSON_ID, reason_code: "BUILTIN_SCHEMA_REGISTERED" });
+      expect(firstAudit).toContainEqual({ event_type: schema.eventType, schema_version: schema.schemaVersion,
+        action: "activated", actor_id: BUILTIN_EVENT_SCHEMA_REVIEWER_PERSON_ID, reason_code: "BUILTIN_SCHEMA_ACTIVATED" });
+    }
+    expect(await installAutomaticallyRegisteredBuiltinEventSchemas(db, { tenantId, schemas })).toEqual({
+      tenantId, considered: 30, registered: 0, activated: 0, alreadyActive: 30,
+    });
+    expect(await audit()).toEqual(firstAudit);
+
+    // The original failed requests can now be retried with their original keys.
+    const board = await service.createBoard(operator, boardInput);
+    expect(board).toMatchObject({ tenantId, name: boardInput.name, canPost: true });
+    expect(await service.createBoard(operator, boardInput)).toEqual(board);
+    const post = await service.createPost(reader, postInput);
+    expect(post).toMatchObject({ tenantId, text: postInput.text });
+    expect((await service.createPost(reader, postInput)).id).toBe(post.id);
+    const newBoardPost = await service.createPost(reader, {
+      tenantId, communityId: board.id, text: "新看板也能發表", idempotencyKey: randomUUID(),
+    });
+    expect((await service.feed(operator, { tenantId })).items.map(item => item.id)).toContain(newBoardPost.id);
+    expect(await count("social_communities")).toBe(2);
+    expect(await count("social_posts")).toBe(2);
+    const events = (await db.query<{
+      event_type: string; event_schema_version: string; event_schema_sha256: string; producer_key: string;
+    }>(`SELECT event_type,event_schema_version,event_schema_sha256,producer_key
+      FROM outbox_events WHERE tenant_id=$1`, [tenantId])).rows;
+    expect(events.map(event => event.event_type)).toEqual(expect.arrayContaining([
+      "social.membership.changed", "social.community.created", "social.post.created",
+    ]));
+    for (const event of events) {
+      expect(event.producer_key).toBe("social-api");
+      expect(rows.find(row => row.event_type === event.event_type && row.schema_version === event.event_schema_version)?.schema_sha256)
+        .toBe(event.event_schema_sha256);
+      expect(event.event_schema_sha256).toMatch(/^[a-f0-9]{64}$/u);
+    }
+    expect((await db.query(`SELECT id FROM people WHERE id IN ('teacher-demo','student-demo','platform-event-author-demo')`)).rows).toEqual([]);
+  }, 60_000);
+});
