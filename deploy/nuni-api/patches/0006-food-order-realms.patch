-  /**
-   * Build the deliberately narrow tenant persona used by dedicated platform
-   * food/social routes.  This is not an identity_subject and carries no campus
-   * role, so it cannot become an enrolment, discount, grade or door grant.
+  /** Discover the caller's order history independently of public shop availability.
+   * This lookup creates no persona and does not authorize new orders.
    */
+  async listFoodOrderRealms(actor: PlatformActor): Promise<Array<{ tenantId: string; name: string }>> {
+    await this.requireActiveAccount(actor.platformAccountId);
+    const result = await this.db.query<{ id: string; display_name: string }>(
+      `SELECT tenant.id, tenant.display_name
+       FROM platform_tenant_personas persona
+       JOIN platform_accounts account ON account.id=persona.platform_account_id
+       JOIN tenants tenant ON tenant.id=persona.tenant_id
+       JOIN people person ON person.tenant_id=persona.tenant_id AND person.id=persona.person_id
+       WHERE persona.platform_account_id=$1 AND account.state='active'
+         AND person.credential_status='active'
+         AND tenant.state IN ('provisioned','open') AND tenant.module_food_enabled
+         AND EXISTS(SELECT 1 FROM food_orders orders
+           WHERE orders.tenant_id=persona.tenant_id AND orders.person_id=persona.person_id)
+       ORDER BY tenant.display_name, tenant.id`,
+      [actor.platformAccountId],
+    );
+    return result.rows.map(row => ({ tenantId: row.id, name: row.display_name }));
+  }
+
+  /** Build a narrow persisted food/social persona without campus roles. */
