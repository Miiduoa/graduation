rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isActiveAccount() {
      return isAuthenticated()
        && (!firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
          || (firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.get('accountDeletionInProgress', false) != true
            && !(firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.get('status', '')
              in ['deleted', 'disabled', 'suspended', 'inactive'])));
    }

    // Sensitive private files require a live canonical profile. A stale Auth token
    // must not regain access merely because the user document was deleted.
    function hasCanonicalActiveAccount() {
      return isActiveAccount()
        && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid));
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      // A role claim can outlive the canonical account document after deletion.
      return hasCanonicalActiveAccount() && request.auth.token.role == 'admin';
    }

    function isValidImage() {
      return request.resource.contentType.matches('image/.*');
    }

    function isValidVideo() {
      return request.resource.contentType.matches('video/.*');
    }

    function isValidAudio() {
      return request.resource.contentType.matches('audio/.*');
    }

    function isValidDocument() {
      return request.resource.contentType in [
        'application/pdf',
        'text/plain',
        'application/msword',
        'application/vnd.ms-excel',
        'application/vnd.ms-powerpoint',
        'application/vnd.openxmlformats-officedocument.wordprocessingml.document',
        'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet',
        'application/vnd.openxmlformats-officedocument.presentationml.presentation'
      ];
    }

    function isSchoolMemberStorage(schoolId) {
      // School membership may remain active after account suspension.
      // This path uses at most two Firestore lookups (account and school member).
      return isActiveAccount()
        // A missing canonical profile must not turn an orphaned membership into access.
        && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/schools/$(schoolId)/members/$(request.auth.uid)).data.status == 'active';
    }

    function campusMediaOk() {
      return (isValidImage() && maxSize(10))
        || (isValidVideo() && maxSize(100))
        || (isValidAudio() && maxSize(20))
        || (isValidDocument() && maxSize(50));
    }

    function isAllowedUpload() {
      return isValidImage() || isValidDocument();
    }

    function maxSize(mb) {
      return request.resource.size < mb * 1024 * 1024;
    }

    function hasSchoolEditorRole(schoolId) {
      return isAuthenticated()
        && firestore.exists(/databases/(default)/documents/schools/$(schoolId)/members/$(request.auth.uid))
        && (
          firestore.get(/databases/(default)/documents/schools/$(schoolId)/members/$(request.auth.uid)).data.role == 'admin'
          || firestore.get(/databases/(default)/documents/schools/$(schoolId)/members/$(request.auth.uid)).data.role == 'editor'
        )
        && firestore.get(/databases/(default)/documents/schools/$(schoolId)/members/$(request.auth.uid)).data.status == 'active';
    }

    function isGroupMember(groupId) {
      return isAuthenticated()
        && firestore.exists(/databases/(default)/documents/groups/$(groupId)/members/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/groups/$(groupId)/members/$(request.auth.uid)).data.status == 'active';
    }

    function canManageGroup(groupId) {
      return isGroupMember(groupId)
        && (
          firestore.get(/databases/(default)/documents/groups/$(groupId)/members/$(request.auth.uid)).data.role == 'admin'
          || firestore.get(/databases/(default)/documents/groups/$(groupId)/members/$(request.auth.uid)).data.role == 'owner'
          || firestore.get(/databases/(default)/documents/groups/$(groupId)/members/$(request.auth.uid)).data.role == 'instructor'
          || firestore.get(/databases/(default)/documents/groups/$(groupId)/members/$(request.auth.uid)).data.role == 'moderator'
        );
    }

    // A stale membership in a previous school does not grant access to DM attachments.
    function isCurrentSchoolMemberStorage(schoolId) {
      return schoolId is string
        && schoolId.size() > 0
        && isSchoolMemberStorage(schoolId)
        && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.get('schoolId', '') == schoolId;
    }

    function conversationMember(conversationId) {
      // Conversation memberIds may survive account deletion; require a live canonical profile.
      // Storage rules can access only two unique Firestore documents per request.
      return isActiveAccount()
        && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
        && firestore.exists(/databases/(default)/documents/conversations/$(conversationId))
        && request.auth.uid in firestore.get(/databases/(default)/documents/conversations/$(conversationId)).data.memberIds
        && isCurrentSchoolMemberStorage(
          firestore.get(/databases/(default)/documents/conversations/$(conversationId)).data.get('schoolId', '')
        );
    }

    function canManageEventAsset(eventId) {
      return isAuthenticated()
        && firestore.exists(/databases/(default)/documents/events/$(eventId))
        && hasSchoolEditorRole(firestore.get(/databases/(default)/documents/events/$(eventId)).data.schoolId);
    }

    function canManageAnnouncementAsset(announcementId) {
      return isAuthenticated()
        && firestore.exists(/databases/(default)/documents/announcements/$(announcementId))
        && hasSchoolEditorRole(firestore.get(/databases/(default)/documents/announcements/$(announcementId)).data.schoolId);
    }

    function canManageMenuAsset(menuId) {
      return isAuthenticated()
        && firestore.exists(/databases/(default)/documents/menus/$(menuId))
        && hasSchoolEditorRole(firestore.get(/databases/(default)/documents/menus/$(menuId)).data.schoolId);
    }

    function canManagePoiAsset(poiId) {
      return isAuthenticated()
        && firestore.exists(/databases/(default)/documents/pois/$(poiId))
        && hasSchoolEditorRole(firestore.get(/databases/(default)/documents/pois/$(poiId)).data.schoolId);
    }

    function canAccessRepairRequest(requestId) {
      return isAuthenticated()
        && firestore.exists(/databases/(default)/documents/repairRequests/$(requestId))
        && (
          firestore.get(/databases/(default)/documents/repairRequests/$(requestId)).data.userId == request.auth.uid
          || isAdmin()
        );
    }

    match /avatars/{fileName} {
      allow read: if true;
      allow write: if hasCanonicalActiveAccount()
        && fileName.matches('^' + request.auth.uid + '\\.[A-Za-z0-9]+$')
        && isValidImage()
        && maxSize(5);
    }

    match /groups/{groupId}/{fileName} {
      // privateGroupFile checks current account, school and group membership server-side.
      allow read, write: if false;
    }

    match /groups/{groupId}/posts/{postId}/{fileName} {
      allow read, write: if false;
    }

    match /assignments/{assignmentId}/submissions/{userId}/{fileName} {
      allow read, write: if false;
    }

    match /lostfound/{itemId}/{fileName} {
      allow read: if true;
      allow create: if resource == null && hasCanonicalActiveAccount() && isValidImage() && maxSize(10);
    }

    match /printjobs/{userId}/{jobId}/{fileName} {
      allow read: if hasCanonicalActiveAccount() && (isOwner(userId) || isAdmin());
      allow write: if hasCanonicalActiveAccount() && isOwner(userId) && isValidDocument() && maxSize(100);
    }

    match /announcements/{announcementId}/{fileName} {
      allow read: if true;
      allow write: if canManageAnnouncementAsset(announcementId) && isAllowedUpload() && maxSize(20);
    }

    match /events/{eventId}/{fileName} {
      allow read: if true;
      allow write: if fileName.matches('^cover\\.[A-Za-z0-9]+$')
        && canManageEventAsset(eventId)
        && isValidImage()
        && maxSize(10);
    }

    match /events/{eventId}/gallery/{fileName} {
      allow read: if true;
      allow write: if canManageEventAsset(eventId) && isValidImage() && maxSize(10);
    }

    match /menus/{menuId}/{fileName} {
      allow read: if true;
      allow write: if fileName.matches('^image\\.[A-Za-z0-9]+$')
        && canManageMenuAsset(menuId)
        && isValidImage()
        && maxSize(5);
    }

    match /pois/{poiId}/{fileName} {
      allow read: if true;
      allow write: if canManagePoiAsset(poiId) && isValidImage() && maxSize(10);
    }

    match /conversations/{conversationId}/messages/{messageId}/{fileName} {
      // Direct SDK reads/writes require three distinct Firestore documents and
      // exceed the production Storage Rules cap of TWO. Even an active member
      // must use dmAttachmentDelivery (server-side authorization per request).
      // Denying SDK metadata access also prevents issuing NEW Firebase tokens.
      // Pre-existing download URLs remain valid until separately revoked.
      allow read, write: if false;
    }

    match /bugreports/{reportId}/{fileName} {
      allow read: if isAdmin();
      allow create: if resource == null && hasCanonicalActiveAccount() && isValidImage() && maxSize(10);
    }

    match /repairs/{requestId}/{fileName} {
      allow read: if hasCanonicalActiveAccount() && canAccessRepairRequest(requestId);
      allow write: if hasCanonicalActiveAccount() && canAccessRepairRequest(requestId) && isValidImage() && maxSize(10);
    }

    match /health/{userId}/{recordId}/{fileName} {
      allow read: if hasCanonicalActiveAccount() && (isOwner(userId) || isAdmin());
      allow write: if hasCanonicalActiveAccount() && (isOwner(userId) || isAdmin()) && isAllowedUpload() && maxSize(20);
    }

    match /temp/{userId}/{fileName} {
      allow read: if hasCanonicalActiveAccount() && isOwner(userId);
      allow write: if hasCanonicalActiveAccount() && isOwner(userId) && maxSize(50);
    }

    match /schools/{schoolId}/campusPosts/{postId}/{fileName} {
      allow read: if isSchoolMemberStorage(schoolId);
      allow create: if resource == null && isSchoolMemberStorage(schoolId) && campusMediaOk();
    }

    match /schools/{schoolId}/stories/{storyId}/{fileName} {
      function storyAccountBoundToSchool() {
        // Production Storage allows two unique Firestore documents per
        // request. This match reads members/{uid} and campusStories only.
        // Both profileBoundSchoolId and a non-empty profileBoundGeneration
        // are server-stamped on school login. Clients cannot write school
        // members. Server delete/suspend clears the stamp in the same
        // transaction; triggers are backup only.
        let member = firestore.get(/databases/(default)/documents/schools/$(schoolId)/members/$(request.auth.uid)).data;
        return isAuthenticated()
          && member.status == 'active'
          && member.get('profileBoundSchoolId', '') == schoolId
          && member.get('profileBoundGeneration', '') is string
          && member.get('profileBoundGeneration', '').size() > 0;
      }
      function isPublishedStory() {
        let story = firestore.get(/databases/(default)/documents/campusStories/$(storyId)).data;
        return story.schoolId == schoolId
          && resource.metadata.ownerUid == story.authorUid
          && story.mediaUrl is string && story.mediaUrl.size() > 0
          // Story expiry is stored as epoch milliseconds by the mobile publisher.
          && story.expiresAt is int && story.expiresAt > request.time.toMillis()
          && ((story.kind == 'image' && resource.contentType.matches('image/.*'))
            || (story.kind == 'video' && fileName == 'video' && resource.contentType == 'video/mp4'));
      }
      allow get: if storyAccountBoundToSchool()
        && (
          // Before publication only the author can preview a draft. Once the
          // story exists, all readers (including its author) use the published
          // owner, media-type and expiry checks.
          (resource.metadata.get('ownerUid', '') == request.auth.uid
            && !firestore.exists(/databases/(default)/documents/campusStories/$(storyId)))
          || isPublishedStory()
        );
      // Draft uploads may be retried until their Firestore story is published.
      allow create, update: if storyAccountBoundToSchool()
        && request.resource.metadata.ownerUid == request.auth.uid
        && (resource == null || resource.metadata.ownerUid == request.auth.uid)
        && !firestore.exists(/databases/(default)/documents/campusStories/$(storyId))
        && request.resource.size > 0
        && ((fileName == 'image' && isValidImage() && maxSize(10))
          || (fileName == 'video' && request.resource.contentType == 'video/mp4' && maxSize(100)));
    }

    match /conversations/{conversationId}/media/{uploadId}/{fileName} {
      // GCS V4 POST and one-minute signed GET are issued only by the
      // authenticated dmAttachmentDelivery callable, not Storage SDK rules.
      allow read, write: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
