index 0000000..925e004
--- /dev/null
+++ b/apps/api/src/public-cafeterias/merchantMode.ts
@@ -0,0 +1,186 @@
+export const MERCHANT_MODES = ['native_order', 'showcase_link', 'info_only'] as const;
+export type MerchantMode = (typeof MERCHANT_MODES)[number];
+
+export const PRICE_DISCLAIMER = '價格、是否賣完、是否接單以店家訂餐頁為準。Nuni 不處理這筆的付款與退款。';
+export const EXTERNAL_ORDER_HONEST_TEXT =
+  '訂單在店家系統，請到店家查看。我們沒有這筆的訂單號碼、餐點明細或付款狀態。';
+export const MENU_STALE_TEXT = '菜單可能過期，價格以店家頁面為準。';
+export const SHOWCASE_ORDER_BUTTON_TEXT = '到店家網站訂餐';
+export const SHOWCASE_EXTERNAL_ORDER_HINT = '這間店要到店家自己的頁面訂餐。';
+export const SHOWCASE_ORDER_CAPTION =
+  '會開啟店家自己的網站，訂單和付款由店家處理，Campus One 查不到這筆訂單';
+export const SHOWCASE_LEAVE_NOTICE = SHOWCASE_ORDER_CAPTION;
+export const NATIVE_ORDERING_CLOSED_TEXT = '這間店目前不能在 App 點餐';
+export const MENU_STALE_AFTER_HOURS = 24;
+
+export function normalizeMerchantMode(value: unknown): MerchantMode {
+  return MERCHANT_MODES.includes(value as MerchantMode) ? (value as MerchantMode) : 'info_only';
+}
+
+export function resolveStoredMerchantMode(cafeteria: {
+  merchantMode?: unknown;
+  orderingEnabled?: boolean;
+} = {}): MerchantMode {
+  if (MERCHANT_MODES.includes(cafeteria.merchantMode as MerchantMode)) {
+    return cafeteria.merchantMode as MerchantMode;
+  }
+  return cafeteria.orderingEnabled === true ? 'native_order' : 'info_only';
+}
+
+export const STOREFRONT_URL_MAX_LENGTH = 2048;
+export const STOREFRONT_URL_HTTPS_TEXT = '請貼 https:// 開頭的網址';
+export const STOREFRONT_URL_CREDENTIALS_TEXT = '網址裡不能有帳號或密碼';
+export const STOREFRONT_URL_TOO_LONG_TEXT = '網址太長，請改用店家網站首頁或訂餐頁的網址';
+
+type StorefrontUrlIssueKind = 'ok' | 'https' | 'credentials' | 'length' | 'chars';
+
+function storefrontUrlHasForbiddenChars(value: string): boolean {
+  if (value !== value.trim()) return true;
+  for (let i = 0; i < value.length; i += 1) {
+    const code = value.charCodeAt(i);
+    if (code <= 0x20 || code === 0x7f) return true;
+  }
+  return false;
+}
+
+/** 寫入／外連共用：不 trim。前後空白或控制字元直接拒絕。 */
+function inspectHttpsStorefrontUrl(value: string): StorefrontUrlIssueKind {
+  if (value.length > STOREFRONT_URL_MAX_LENGTH) return 'length';
+  if (storefrontUrlHasForbiddenChars(value)) return 'chars';
+  try {
+    const url = new URL(value);
+    if (url.protocol !== 'https:') return 'https';
+    if (url.username || url.password) return 'credentials';
+    return 'ok';
+  } catch {
+    return 'https';
+  }
+}
+
+export function isHttpsOrderingUrl(value: unknown): value is string {
+  return (
+    typeof value === 'string' &&
+    value !== '' &&
+    value === value.trim() &&
+    storefrontUrlIssue(value) === null
+  );
+}
+
+export function trimStorefrontUrl(value: unknown): string {
+  return typeof value === 'string' ? value.trim() : '';
+}
+
+/** 畫面用：先去掉前後空白再檢查。空白本身不報錯；空字串表示沒填。 */
+export function storefrontUrlIssue(value: unknown): string | null {
+  const trimmed = trimStorefrontUrl(value);
+  if (!trimmed) return null;
+  const issue = inspectHttpsStorefrontUrl(trimmed);
+  if (issue === 'ok') return null;
+  if (issue === 'length') return STOREFRONT_URL_TOO_LONG_TEXT;
+  if (issue === 'credentials') return STOREFRONT_URL_CREDENTIALS_TEXT;
+  return STOREFRONT_URL_HTTPS_TEXT;
+}
+
+/** 後端／規則用：帶空白或控制字元的值直接擋，不先 trim。空字串可以。 */
+export function isStoredStorefrontUrlAllowed(value: unknown): boolean {
+  if (value == null || value === '') return true;
+  return isHttpsOrderingUrl(value);
+}
+
+export function safeStorefrontUrl(value: unknown): string | undefined {
+  return isHttpsOrderingUrl(value) ? value : undefined;
+}
+
+export function buildShowcaseOrderingUrl(
+  orderingUrl: string,
+  schoolId: string,
+  cafeteriaId: string,
+): string {
+  const url = new URL(orderingUrl);
+  url.searchParams.set('utm_source', 'nuni');
+  url.searchParams.set('utm_campaign', 'campus');
+  url.searchParams.set('ref', `nuni-${schoolId}-${cafeteriaId}`);
+  return url.toString();
+}
+
+export function isMenuStale(menuSyncedAt: string | Date | null | undefined, now = new Date()): boolean {
+  if (!menuSyncedAt) return true;
+  const date = menuSyncedAt instanceof Date ? menuSyncedAt : new Date(menuSyncedAt);
+  if (!Number.isFinite(date.getTime())) return true;
+  return now.getTime() - date.getTime() > MENU_STALE_AFTER_HOURS * 60 * 60 * 1000;
+}
+
+export function parseMenuCsv(text: string): { name: string; price: number | null; category: string }[] {
+  const lines = String(text || '')
+    .split(/\r?\n/)
+    .map((line) => line.trim())
+    .filter(Boolean);
+  const firstLine = lines[0];
+  if (firstLine === undefined) return [];
+  const header = splitCsvLine(firstLine).map((cell) => cell.toLowerCase());
+  const nameIndex = header.findIndex((cell) => /name|品名|名稱/.test(cell));
+  const priceIndex = header.findIndex((cell) => /price|價格|售價/.test(cell));
+  const categoryIndex = header.findIndex((cell) => /category|分類|類別/.test(cell));
+  const start = nameIndex >= 0 ? 1 : 0;
+  return lines.slice(start).flatMap((line) => {
+    const cells = splitCsvLine(line);
+    const name = ((nameIndex >= 0 ? cells[nameIndex] : cells[0]) ?? '').trim();
+    if (!name) return [];
+    const rawPrice = priceIndex >= 0 ? cells[priceIndex] : cells[1];
+    const parsed = rawPrice != null && rawPrice !== '' ? Number(String(rawPrice).replace(/[^\d.]/g, '')) : NaN;
+    return [
+      {
+        name: name.slice(0, 80),
+        price: Number.isFinite(parsed) && parsed >= 0 ? parsed : null,
+        category: ((categoryIndex >= 0 ? cells[categoryIndex] : cells[2]) || '').trim().slice(0, 40),
+      },
+    ];
+  });
+}
+
+function splitCsvLine(line: string): string[] {
+  const cells: string[] = [];
+  let current = '';
+  let quoted = false;
+  for (let i = 0; i < line.length; i += 1) {
+    const char = line[i];
+    if (char === '"') {
+      if (quoted && line[i + 1] === '"') {
+        current += '"';
+        i += 1;
+      } else {
+        quoted = !quoted;
+      }
+    } else if (char === ',' && !quoted) {
+      cells.push(current);
+      current = '';
+    } else {
+      current += char;
+    }
+  }
+  cells.push(current);
+  return cells.map((cell) => cell.trim());
+}
+
+export function studentCafeteriaAction(input: {
+  merchantMode?: unknown;
+  orderingEnabled?: boolean;
+  onlineOrderingEnabled?: boolean;
+  orderingUrl?: unknown;
+}): { kind: 'native' | 'showcase' | 'info' | 'native_closed'; label: string } {
+  const mode = resolveStoredMerchantMode(input);
+  if (
+    mode === 'showcase_link' &&
+    storefrontUrlIssue(input.orderingUrl) === null &&
+    isHttpsOrderingUrl(input.orderingUrl)
+  ) {
+    return { kind: 'showcase', label: SHOWCASE_ORDER_BUTTON_TEXT };
+  }
+  if (mode === 'native_order') {
+    if (input.onlineOrderingEnabled === true && input.orderingEnabled === true) {
+      return { kind: 'native', label: '點餐' };
+    }
+    return { kind: 'native_closed', label: NATIVE_ORDERING_CLOSED_TEXT };
+  }
+  return { kind: 'info', label: '查看店面' };
+}
diff --git a/apps/api/src/public-cafeterias/routes.ts b/apps/api/src/public-cafeterias/routes.ts
new file mode 100644
index 0000000..2c37142
--- /dev/null
+++ b/apps/api/src/public-cafeterias/routes.ts
@@ -0,0 +1,92 @@
+import type { FastifyInstance, FastifyRequest, FastifyReply } from 'fastify';
+import {
+  PublicCafeteriaError,
+  PublicCafeteriaService,
+  createWindowLimiter,
+} from './service';
+
+const listPath = /^\/v1\/public\/schools\/([^/]+)\/cafeterias\/?$/;
+const missingSchoolPath = /^\/v1\/public\/(?:schools\/)?cafeterias\/?$/;
+const limiter = createWindowLimiter({ max: 60, windowMs: 60_000 });
+const ROUTE_METHODS = ['GET', 'POST', 'PUT', 'PATCH', 'DELETE'] as const;
+const WRITE_METHODS = new Set(['POST', 'PUT', 'PATCH', 'DELETE']);
+const orderingPath =
+  /^\/v1\/(?:.*\/)?food\/(?:.*\/)?(?:orders|quotes|pos-orders|pickup[^/]*)(?:\/|$)/;
+const merchantOrderPath =
+  /^\/v1\/(?:auth\/platform\/)?merchant-workspaces\/[^/]+\/[^/]+\/orders(?:\/|$)/;
+
+export function resetPublicCafeteriaLimiter() {
+  limiter.reset();
+}
+
+/** 未設或不是字面 true 就是關；本機測試要開才明確設 ONLINE_ORDERING_ENABLED=true。 */
+export function onlineOrderingEnabled() {
+  return process.env.ONLINE_ORDERING_ENABLED === 'true';
+}
+
+export function isOrderingRoute(path: string) {
+  const pathname = path.split('?', 1)[0] ?? path;
+  if (/\/purchase-orders(?:\/|$)/.test(pathname)) return false;
+  return orderingPath.test(pathname) || merchantOrderPath.test(pathname);
+}
+
+export function isOrderingWrite(method: string, path: string) {
+  return WRITE_METHODS.has(method.toUpperCase()) && isOrderingRoute(path);
+}
+
+export function isPublicCafeteriaRoute(_method: string, path: string) {
+  const pathname = path.split('?', 1)[0] ?? path;
+  return listPath.test(pathname) || missingSchoolPath.test(pathname);
+}
+
+function clientKey(request: FastifyRequest) {
+  return request.ip || 'anon';
+}
+
+export function registerPublicCafeteriaRoutes(
+  app: FastifyInstance,
+  db: { query: PublicCafeteriaService['list'] extends never ? never : ConstructorParameters<typeof PublicCafeteriaService>[0]['query'] },
+) {
+  app.addHook('onRequest', async (request, reply) => {
+    if (onlineOrderingEnabled() || !isOrderingWrite(request.method, request.url)) return;
+    return reply.code(412).send({
+      error: { code: 'ONLINE_ORDERING_DISABLED', message: '線上點餐尚未開放' },
+    });
+  });
+  const service = new PublicCafeteriaService(db);
+  const send = async (request: FastifyRequest, reply: FastifyReply, schoolId: unknown) => {
+    try {
+      if (request.method !== 'GET') {
+        throw new PublicCafeteriaError(405, 'METHOD_NOT_ALLOWED', '餐廳目錄只提供讀取');
+      }
+      if (!limiter.allow(clientKey(request))) {
+        throw new PublicCafeteriaError(429, 'RATE_LIMITED', '查詢過於頻繁，請稍後再試');
+      }
+      const catalog = await service.list(schoolId);
+      reply.header('Cache-Control', 'public, max-age=60');
+      return catalog;
+    } catch (error) {
+      if (error instanceof PublicCafeteriaError) {
+        if (error.status === 405) reply.header('Allow', 'GET');
+        return reply.code(error.status).send({ error: { code: error.code, message: error.message } });
+      }
+      throw error;
+    }
+  };
+  app.route({
+    method: [...ROUTE_METHODS],
+    url: '/v1/public/schools/:schoolId/cafeterias',
+    handler: async (request, reply) =>
+      send(request, reply, (request.params as { schoolId?: string }).schoolId),
+  });
+  app.route({
+    method: [...ROUTE_METHODS],
+    url: '/v1/public/cafeterias',
+    handler: async (request, reply) => send(request, reply, ''),
+  });
+  app.route({
+    method: [...ROUTE_METHODS],
+    url: '/v1/public/schools/cafeterias',
+    handler: async (request, reply) => send(request, reply, ''),
+  });
+}
diff --git a/apps/api/src/public-cafeterias/service.ts b/apps/api/src/public-cafeterias/service.ts
new file mode 100644
index 0000000..e4c5906
--- /dev/null
+++ b/apps/api/src/public-cafeterias/service.ts
@@ -0,0 +1,217 @@
+import {
+  assertNoPrivateCafeteriaFields,
+  parseCafeteriaLocations,
+  parseCafeteriaMenu,
+  toPublicCafeteriaMenuItem,
+  toPublicCafeteriaRecord,
+  type CafeteriaCatalogMenuItem,
+  type CafeteriaCatalogRecord,
+} from './cafeteriaCatalog';
+
+export class PublicCafeteriaError extends Error {
+  constructor(
+    readonly status: number,
+    readonly code: string,
+    message: string,
+  ) {
+    super(message);
+    this.name = 'PublicCafeteriaError';
+  }
+}
+
+export type PublicCafeteriaSql = {
+  query<Row = Record<string, unknown>>(
+    sql: string,
+    params?: unknown[],
+  ): Promise<{ rows: Row[] }>;
+};
+
+export type PublicCafeteriaCatalog = {
+  schoolId: string;
+  cafeterias: ReturnType<typeof toPublicCafeteriaRecord>[];
+  menus: ReturnType<typeof toPublicCafeteriaMenuItem>[];
+};
+
+const TENANT = /^[a-z0-9][a-z0-9-]{0,78}[a-z0-9]$/;
+const CACHE_MS = 60_000;
+const cache = new Map<string, { expiresAt: number; value: PublicCafeteriaCatalog }>();
+
+export function publicCafeteriaCacheTtlMs() {
+  return CACHE_MS;
+}
+
+export function resetPublicCafeteriaCache() {
+  cache.clear();
+}
+
+export function requirePublicSchoolId(value: unknown): string {
+  if (typeof value !== 'string' || !TENANT.test(value)) {
+    throw new PublicCafeteriaError(400, 'SCHOOL_ID_REQUIRED', '請指定學校');
+  }
+  return value;
+}
+
+type TenantRow = { id: string; state: string };
+type LocationRow = {
+  id: string;
+  name: string;
+  zone_label: string | null;
+  opening_hours: string | null;
+  description: string | null;
+  merchant_mode: string | null;
+  review_status: string | null;
+  source_url: string | null;
+  external_order_url: string | null;
+  source_label: string | null;
+  source_updated_at: string | Date | null;
+};
+type MenuRow = {
+  id: string;
+  location_id: string;
+  name: string;
+  section_name: string | null;
+  description: string | null;
+  price_minor: number | null;
+  available: boolean | null;
+  sold_out: boolean | null;
+};
+
+function asIso(value: string | Date | null): string | undefined {
+  if (!value) return undefined;
+  const date = value instanceof Date ? value : new Date(value);
+  return Number.isFinite(date.getTime()) ? date.toISOString() : undefined;
+}
+
+function projectLocation(row: LocationRow, schoolId: string): CafeteriaCatalogRecord | null {
+  return parseCafeteriaLocations(
+    [
+      {
+        id: row.id,
+        name: row.name,
+        schoolId,
+        zoneLabel: row.zone_label,
+        openingHours: row.opening_hours,
+        description: row.description,
+        merchantMode: row.merchant_mode,
+        reviewStatus: row.review_status,
+        sourceUrl: row.source_url,
+        externalOrderUrl: row.external_order_url,
+        sourceLabel: row.source_label,
+        sourceUpdatedAt: asIso(row.source_updated_at),
+      },
+    ],
+    schoolId,
+  )[0] ?? null;
+}
+
+function projectMenus(
+  rows: MenuRow[],
+  locations: CafeteriaCatalogRecord[],
+  schoolId: string,
+): CafeteriaCatalogMenuItem[] {
+  const byId = new Map(locations.map((row) => [row.id, row]));
+  const items: CafeteriaCatalogMenuItem[] = [];
+  for (const row of rows) {
+    const location = byId.get(row.location_id);
+    if (!location) continue;
+    const parsed = parseCafeteriaMenu(
+      {
+        location: { id: location.id, name: location.name },
+        items: [
+          {
+            id: row.id,
+            name: row.name,
+            category: row.section_name,
+            description: row.description,
+            basePrice: { amountMinor: row.price_minor },
+            available: row.available,
+            soldOut: row.sold_out,
+          },
+        ],
+      },
+      schoolId,
+      location.id,
+      location.name,
+    );
+    items.push(...parsed);
+  }
+  return items;
+}
+
+export class PublicCafeteriaService {
+  constructor(private readonly db: PublicCafeteriaSql) {}
+
+  async list(schoolIdInput: unknown, now = Date.now()): Promise<PublicCafeteriaCatalog> {
+    const schoolId = requirePublicSchoolId(schoolIdInput);
+    const hit = cache.get(schoolId);
+    if (hit && hit.expiresAt > now) return hit.value;
+    const tenant = (
+      await this.db.query<TenantRow>('SELECT id, state FROM tenants WHERE id=$1', [schoolId])
+    ).rows[0];
+    if (!tenant || tenant.state !== 'open') {
+      const empty = { schoolId, cafeterias: [], menus: [] };
+      cache.set(schoolId, { expiresAt: now + CACHE_MS, value: empty });
+      return empty;
+    }
+    const locations = (
+      await this.db.query<LocationRow>(
+        `SELECT id, name, zone_label, NULL::text AS opening_hours, description, merchant_mode,
+                'unverified'::text AS review_status,
+                source_url, external_order_url, source_label, source_updated_at
+           FROM food_locations
+          WHERE tenant_id=$1 AND public_access=true AND status='open'
+          ORDER BY name
+          LIMIT 100`,
+        [schoolId],
+      )
+    ).rows
+      .map((row) => projectLocation(row, schoolId))
+      .filter((row): row is CafeteriaCatalogRecord => row !== null);
+    const locationIds = locations.map((row) => row.id);
+    const menus =
+      locationIds.length === 0
+        ? []
+        : projectMenus(
+            (
+              await this.db.query<MenuRow>(
+                `SELECT i.id, v.location_id, i.name, i.section_name, i.description, i.price_minor, i.available, false AS sold_out
+                   FROM food_menu_items i
+                   JOIN food_menu_versions v ON v.id=i.menu_version_id AND v.tenant_id=i.tenant_id
+                  WHERE i.tenant_id=$1 AND v.state='published' AND v.location_id = ANY($2::text[])
+                  LIMIT 400`,
+                [schoolId, locationIds],
+              )
+            ).rows,
+            locations,
+            schoolId,
+          );
+    const value: PublicCafeteriaCatalog = {
+      schoolId,
+      cafeterias: locations.map(toPublicCafeteriaRecord),
+      menus: menus.map(toPublicCafeteriaMenuItem),
+    };
+    assertNoPrivateCafeteriaFields(value.cafeterias);
+    assertNoPrivateCafeteriaFields(value.menus);
+    cache.set(schoolId, { expiresAt: now + CACHE_MS, value });
+    return value;
+  }
+}
+
+export function createWindowLimiter(options: { max: number; windowMs: number }) {
+  const hits = new Map<string, number[]>();
+  return {
+    allow(key: string, now = Date.now()) {
+      const recent = (hits.get(key) ?? []).filter((stamp) => now - stamp < options.windowMs);
+      if (recent.length >= options.max) {
+        hits.set(key, recent);
+        return false;
+      }
+      recent.push(now);
+      hits.set(key, recent);
+      return true;
+    },
+    reset() {
+      hits.clear();
+    },
+  };
+}
