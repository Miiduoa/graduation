index 210cfa5..a98b5ab 100644
--- a/apps/api/src/app.ts
+++ b/apps/api/src/app.ts
@@ -1180,6 +1180,24 @@ export async function createApp(db: CampusDatabase, options: AppOptions): Promis
     if (error instanceof ZodError) {
       return reply.status(422).send({ error: { code: "VALIDATION_ERROR", message: error.message } });
     }
+    /**
+     * Fastify JSON body parser client errors only.
+     *
+     * Match the known framework codes together with their documented HTTP 400.
+     * Do not promote an arbitrary thrown `statusCode` to a client response.
+     * DomainError / AuthError above keep 401/403 semantics unchanged.
+     */
+    if (
+      typeof error === "object" && error
+      && "code" in error
+      && (error.code === "FST_ERR_CTP_INVALID_JSON_BODY" || error.code === "FST_ERR_CTP_EMPTY_JSON_BODY")
+      && "statusCode" in error
+      && error.statusCode === 400
+    ) {
+      return reply.status(400).send({
+        error: { code: "INVALID_JSON_BODY", message: "請求內容不是有效的 JSON" },
+      });
+    }
     if (typeof error === "object" && error && "statusCode" in error && error.statusCode === 429) {
       return reply.status(429).send({ error: { code: "RATE_LIMITED", message: "嘗試次數過多，請稍後再試" } });
     }
diff --git a/apps/api/src/json-body-parser-errors.test.ts b/apps/api/src/json-body-parser-errors.test.ts
new file mode 100644
index 0000000..07d6297
--- /dev/null
+++ b/apps/api/src/json-body-parser-errors.test.ts
@@ -0,0 +1,181 @@
+import { afterAll, beforeAll, describe, expect, it } from "vitest";
+import { generateKeyPair, exportJWK, SignJWT } from "jose";
+import { createApp } from "./app";
+import { createDatabase, type CampusDatabase } from "./database";
+import { provisionPlatformPasswordAdmin } from "./accounts/platform-password-provisioning";
+
+describe("JSON body parser HTTP error boundary", () => {
+  let db: CampusDatabase;
+  let app: Awaited<ReturnType<typeof createApp>>;
+  let privateKey: CryptoKey;
+  const password = "JSON-boundary test-only password";
+  const email = "json-body-boundary@example.test";
+
+  beforeAll(async () => {
+    db = await createDatabase({
+      attendanceCodeSecret: "json-body-parser-test-secret-over-thirty-two",
+      seedDemo: false,
+    });
+    await db.query(`INSERT INTO platform_identity_providers
+      (kind,issuer,client_id,jwks_uri,authorization_endpoint,token_endpoint,state)
+      VALUES ('google-consumer','https://accounts.google.com','json-body-parser-client',
+      'https://www.googleapis.com/oauth2/v3/certs','https://accounts.google.com/o/oauth2/v2/auth',
+      'https://oauth2.googleapis.com/token','enabled')`);
+    await provisionPlatformPasswordAdmin(db, {
+      email,
+      password,
+      reason: "JSON body parser HTTP boundary fixture",
+      performedBy: "json-body-parser-test",
+    }, { apply: true });
+
+    const pair = await generateKeyPair("RS256", { extractable: true });
+    privateKey = pair.privateKey;
+    const publicJwk = {
+      ...(await exportJWK(pair.publicKey)),
+      kid: "json-body-parser-test",
+      alg: "RS256",
+      use: "sig",
+    };
+
+    app = await createApp(db, {
+      auth: { mode: "campus-account" },
+      campusAccountSessionSecret: "json-body-parser-session-secret-over-thirty-two",
+      attendanceCodeSecret: "json-body-parser-test-secret-over-thirty-two",
+      enableDemoAuth: false,
+      externalIdpJwksFetch: async () =>
+        new Response(JSON.stringify({ keys: [publicJwk] }), {
+          headers: { "Content-Type": "application/json" },
+        }),
+    });
+    app.addHook("onRequest", async (request) => {
+      if (request.headers["x-security-force-internal-error"] === "1") {
+        throw new Error("SECRET_INTERNAL_DETAIL_must_not_leak");
+      }
+    });
+  }, 30_000);
+
+  afterAll(async () => {
+    await app?.close();
+    await db?.close();
+  });
+
+  it("rejects malformed JSON with HTTP 400 without leaking parser text", async () => {
+    const response = await app.inject({
+      method: "POST",
+      url: "/v1/auth/platform/password/sessions",
+      headers: { "content-type": "application/json" },
+      payload: "{",
+    });
+    expect(response.statusCode).toBe(400);
+    expect(response.json()).toEqual({
+      error: { code: "INVALID_JSON_BODY", message: "請求內容不是有效的 JSON" },
+    });
+    expect(response.body).not.toMatch(/FST_ERR|Body is not valid JSON|content-type/i);
+  });
+
+  it("rejects empty JSON bodies with HTTP 400 without leaking parser text", async () => {
+    const response = await app.inject({
+      method: "POST",
+      url: "/v1/auth/platform/password/sessions",
+      headers: { "content-type": "application/json", "content-length": "0" },
+      payload: "",
+    });
+    expect(response.statusCode).toBe(400);
+    expect(response.json()).toEqual({
+      error: { code: "INVALID_JSON_BODY", message: "請求內容不是有效的 JSON" },
+    });
+    expect(response.body).not.toMatch(/FST_ERR|Body cannot be empty|content-type/i);
+  });
+
+  it("keeps wrong-password login as generic 401", async () => {
+    const response = await app.inject({
+      method: "POST",
+      url: "/v1/auth/platform/password/sessions",
+      headers: { "content-type": "application/json" },
+      payload: { email, password: "incorrect test-only password" },
+    });
+    expect(response.statusCode).toBe(401);
+    expect(response.json()).toEqual({
+      error: { code: "PLATFORM_PASSWORD_LOGIN_INVALID", message: "帳號或密碼不正確，請稍後再試。" },
+    });
+    expect(response.body).not.toContain("incorrect test-only password");
+  });
+
+  it("keeps unknown internal errors opaque 500", async () => {
+    const response = await app.inject({
+      method: "GET",
+      url: "/health/live",
+      headers: { "x-security-force-internal-error": "1" },
+    });
+    expect(response.statusCode).toBe(500);
+    expect(response.json()).toEqual({
+      error: { code: "INTERNAL_ERROR", message: "系統暫時無法完成操作" },
+    });
+    expect(response.body).not.toContain("SECRET_INTERNAL");
+  });
+
+  it("preserves authenticated Zod 422 contract", async () => {
+    const logged = await app.inject({
+      method: "POST",
+      url: "/v1/auth/platform/password/sessions",
+      payload: { email, password },
+    });
+    expect(logged.statusCode).toBe(201);
+    const headers = { authorization: `Platform ${logged.json().sessionHandle as string}` };
+    const invalidShape = await app.inject({
+      method: "POST",
+      url: "/v1/auth/platform/social/blocks/path-target/revoke",
+      headers,
+      payload: {
+        blockId: "body-target",
+        expectedVersion: 1,
+        idempotencyKey: "json-body-422-test",
+      },
+    });
+    expect(invalidShape.statusCode).toBe(422);
+    expect(invalidShape.json().error.code).toBe("VALIDATION_ERROR");
+  });
+
+  it("preserves ordinary session 403 on operator-only route", async () => {
+    const tx = await app.inject({
+      method: "POST",
+      url: "/v1/auth/platform/login-transactions",
+      headers: { "content-type": "application/json" },
+      payload: { kind: "google-consumer" },
+    });
+    expect(tx.statusCode).toBe(200);
+    const txBody = tx.json();
+    const idToken = await new SignJWT({
+      nonce: txBody.nonce,
+      email: "json-body-ordinary@example.test",
+      email_verified: true,
+    })
+      .setProtectedHeader({ alg: "RS256", kid: "json-body-parser-test", typ: "JWT" })
+      .setIssuer("https://accounts.google.com")
+      .setAudience("json-body-parser-client")
+      .setSubject("json-body-ordinary")
+      .setIssuedAt()
+      .setExpirationTime("10m")
+      .sign(privateKey);
+    const session = await app.inject({
+      method: "POST",
+      url: "/v1/auth/platform/sessions",
+      headers: { "content-type": "application/json" },
+      payload: {
+        kind: "google-consumer",
+        transactionId: txBody.transactionId,
+        nonce: txBody.nonce,
+        idToken,
+        displayName: "json-body-ordinary",
+      },
+    });
+    expect(session.statusCode).toBe(201);
+    const denied = await app.inject({
+      method: "GET",
+      url: "/v1/auth/platform/ops/audit",
+      headers: { authorization: `Platform ${session.json().sessionHandle as string}` },
+    });
+    expect(denied.statusCode).toBe(403);
+    expect(denied.json().error.code).toBe("PLATFORM_OPERATOR_REQUIRED");
+  });
+});
