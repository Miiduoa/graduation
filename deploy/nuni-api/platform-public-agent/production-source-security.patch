diff --git a/apps/api/src/platform-public-agent/admission.ts b/apps/api/src/platform-public-agent/admission.ts
new file mode 100644
index 0000000..76b50e6
--- /dev/null
+++ b/apps/api/src/platform-public-agent/admission.ts
@@ -0,0 +1,198 @@
+import { createHash } from 'node:crypto';
+import {
+  exactRecord,
+  parseConfirmedTask,
+  parseOperationLookup,
+  PublicAgentError,
+  type ParsedPublicTask,
+  type PlatformTaskActor,
+} from './contract';
+import type { PlatformPublicAgentLedger } from './ledger';
+
+/** Structural subset of PlatformAccountService, verified against the pinned API source. */
+export interface PlatformSessionResolver {
+  resolveSession(
+    authorization: string | undefined,
+  ): Promise<Omit<PlatformTaskActor, 'sessionHash'>>;
+}
+type Ledger = Pick<PlatformPublicAgentLedger, 'confirm' | 'claim' | 'read'>;
+type Options = {
+  accounts: PlatformSessionResolver;
+  ledger: Ledger;
+  /** Server-owned, public-only reader. Client rows and fingerprints are not a source. */
+  readPublicSourceFingerprint: (
+    schoolId: string,
+    query: string,
+    signal: AbortSignal,
+  ) => Promise<string>;
+  timeoutMs?: number;
+};
+type Deadline = {
+  signal: AbortSignal;
+  persist<T>(work: () => Promise<T>): Promise<T>;
+  step<T>(work: () => Promise<T>): Promise<T>;
+};
+
+/** Admission only: a claim never means a model ran or an Agent task completed. */
+export class PlatformPublicAdmission {
+  private readonly timeoutMs: number;
+  constructor(private readonly options: Options) {
+    this.timeoutMs = options.timeoutMs ?? 10_000;
+    if (
+      !Number.isSafeInteger(this.timeoutMs) ||
+      this.timeoutMs < 1 ||
+      this.timeoutMs > 30_000 ||
+      typeof options.accounts?.resolveSession !== 'function' ||
+      typeof options.readPublicSourceFingerprint !== 'function' ||
+      ['confirm', 'claim', 'read'].some(
+        (method) => typeof options.ledger?.[method as keyof Ledger] !== 'function',
+      )
+    ) {
+      throw new PublicAgentError('PUBLIC_AGENT_NOT_CONFIGURED', 503);
+    }
+  }
+
+  async confirm(authorization: string | undefined, raw: unknown, signal?: AbortSignal) {
+    const input = exactRecord(raw, ['approved', 'request']);
+    if (input.approved !== true)
+      throw new PublicAgentError('PUBLIC_AGENT_CONFIRMATION_REQUIRED', 409);
+    const task = parseConfirmedTask(input.request);
+    return this.bounded(signal, async (deadline) => {
+      const actor = await deadline.step(() => this.actor(authorization));
+      await this.source(task, deadline);
+      // The ledger checks active account, credential and the actual session again under locks.
+      return deadline.persist(() => this.options.ledger.confirm(actor, task.binding));
+    });
+  }
+
+  async claim(authorization: string | undefined, raw: unknown, signal?: AbortSignal) {
+    const input = exactRecord(raw, ['confirmationId', 'request']);
+    if (
+      typeof input.confirmationId !== 'string' ||
+      !/^[A-Za-z0-9_-]{8,120}$/u.test(input.confirmationId)
+    )
+      throw new PublicAgentError('PUBLIC_AGENT_INVALID_INPUT');
+    const confirmationId = input.confirmationId;
+    const task = parseConfirmedTask(input.request);
+    return this.bounded(signal, async (deadline) => {
+      const actor = await deadline.step(() => this.actor(authorization));
+      await this.source(task, deadline);
+      return deadline.persist(() => this.options.ledger.claim(actor, task.binding, confirmationId));
+    });
+  }
+
+  async read(authorization: string | undefined, raw: unknown, signal?: AbortSignal) {
+    const input = parseOperationLookup(raw);
+    return this.bounded(signal, async (deadline) => {
+      const actor = await deadline.step(() => this.actor(authorization));
+      try {
+        return await deadline.step(() => this.options.ledger.read(actor, input));
+      } catch (error) {
+        if (error instanceof PublicAgentError) throw error;
+        throw new PublicAgentError('PUBLIC_AGENT_STATE_UNAVAILABLE', 503);
+      }
+    });
+  }
+
+  async actor(authorization: string | undefined): Promise<PlatformTaskActor> {
+    const [scheme, handle, extra] = authorization?.trim().split(/\s+/u) ?? [];
+    if (scheme !== 'Platform' || !handle || extra || !/^ps_[A-Za-z0-9_-]{43}$/u.test(handle))
+      throw new PublicAgentError('PUBLIC_AGENT_SESSION_INVALID', 401);
+    try {
+      const actor = await this.options.accounts.resolveSession(authorization);
+      return {
+        platformAccountId: actor.platformAccountId,
+        credentialId: actor.credentialId,
+        expiresAt: actor.expiresAt,
+        sessionHash: createHash('sha256').update(handle).digest('hex'),
+      };
+    } catch (error) {
+      const invalid =
+        error &&
+        typeof error === 'object' &&
+        'code' in error &&
+        error.code === 'PLATFORM_SESSION_INVALID';
+      throw new PublicAgentError(
+        invalid ? 'PUBLIC_AGENT_SESSION_INVALID' : 'PUBLIC_AGENT_SESSION_CHECK_UNAVAILABLE',
+        invalid ? 401 : 503,
+      );
+    }
+  }
+
+  private async source(task: ParsedPublicTask, deadline: Deadline) {
+    if (task.binding.task !== 'public-campus-navigation') return;
+    const consent = task.data.consent as Readonly<{ fingerprint: string }>;
+    let fingerprint: string;
+    try {
+      fingerprint = await deadline.step(() =>
+        this.options.readPublicSourceFingerprint(
+          task.binding.schoolId,
+          task.data.query as string,
+          deadline.signal,
+        ),
+      );
+    } catch (error) {
+      if (error instanceof PublicAgentError) throw error;
+      throw new PublicAgentError('PUBLIC_AGENT_SOURCE_UNAVAILABLE', 503);
+    }
+    if (!/^[a-f0-9]{64}$/u.test(fingerprint) || fingerprint !== consent.fingerprint)
+      throw new PublicAgentError('PUBLIC_AGENT_SOURCE_CHANGED', 409);
+  }
+
+  private async bounded<T>(
+    signal: AbortSignal | undefined,
+    run: (deadline: Deadline) => Promise<T>,
+  ): Promise<T> {
+    const controller = new AbortController();
+    let persisting = false;
+    let stopped: PublicAgentError | undefined;
+    let rejectStop!: (error: PublicAgentError) => void;
+    const stop = new Promise<never>((_, reject) => {
+      rejectStop = reject;
+    });
+    void stop.catch(() => {});
+    const halt = (code: string) => {
+      if (stopped) return;
+      stopped = new PublicAgentError(persisting ? 'PUBLIC_AGENT_OUTCOME_UNKNOWN' : code, 503);
+      controller.abort();
+      rejectStop(stopped);
+    };
+    const onAbort = () => halt('PUBLIC_AGENT_CANCELLED');
+    const step = async <R>(work: () => Promise<R>): Promise<R> => {
+      if (stopped) throw stopped;
+      const result = await Promise.race([
+        Promise.resolve().then(() => {
+          if (stopped) throw stopped;
+          return work();
+        }),
+        stop,
+      ]);
+      if (stopped) throw stopped;
+      return result;
+    };
+    signal?.addEventListener('abort', onAbort, { once: true });
+    if (signal?.aborted) onAbort();
+    const timer = setTimeout(() => halt('PUBLIC_AGENT_TIMEOUT'), this.timeoutMs);
+    try {
+      return await step(() =>
+        run({
+          signal: controller.signal,
+          step,
+          persist: async <R>(work: () => Promise<R>): Promise<R> => {
+            persisting = true;
+            try {
+              return await step(work);
+            } catch (error) {
+              if (error instanceof PublicAgentError) throw error;
+              // A missing commit acknowledgement is not permission to spend or claim again.
+              throw new PublicAgentError('PUBLIC_AGENT_OUTCOME_UNKNOWN', 503);
+            }
+          },
+        }),
+      );
+    } finally {
+      clearTimeout(timer);
+      signal?.removeEventListener('abort', onAbort);
+    }
+  }
+}
diff --git a/apps/api/src/platform-public-agent/contract.ts b/apps/api/src/platform-public-agent/contract.ts
new file mode 100644
index 0000000..cbd9dba
--- /dev/null
+++ b/apps/api/src/platform-public-agent/contract.ts
@@ -0,0 +1,224 @@
+import { createHash } from 'node:crypto';
+
+export const PUBLIC_TASKS = ['campus-service-entry', 'public-campus-navigation'] as const;
+export type PublicTaskName = (typeof PUBLIC_TASKS)[number];
+export const FREE_PROVIDER = 'groq' as const;
+export const FREE_MODEL = 'openai/gpt-oss-120b' as const;
+export const DETERMINISTIC_PROVIDER = 'deterministic' as const;
+export const DETERMINISTIC_MODEL = 'public-poi-exact-match-v1' as const;
+export function isExecutionPair(provider: unknown, model: unknown, task: unknown): boolean {
+  return (
+    (provider === FREE_PROVIDER && model === FREE_MODEL) ||
+    (task === 'public-campus-navigation' &&
+      provider === DETERMINISTIC_PROVIDER &&
+      model === DETERMINISTIC_MODEL)
+  );
+}
+
+export class PublicAgentError extends Error {
+  constructor(
+    public readonly code: string,
+    public readonly statusCode = 422,
+  ) {
+    super(code);
+  }
+}
+export interface PlatformTaskActor {
+  platformAccountId: string;
+  credentialId: string;
+  expiresAt: number;
+  /** Derived after resolveSession succeeds; never accepted in a request body. */
+  sessionHash: string;
+}
+export interface TaskBinding {
+  task: PublicTaskName;
+  requestId: string;
+  schoolId: string;
+  payloadHash: string;
+  provider: typeof FREE_PROVIDER | typeof DETERMINISTIC_PROVIDER;
+  model: typeof FREE_MODEL | typeof DETERMINISTIC_MODEL;
+}
+export interface ParsedPublicTask {
+  binding: Readonly<TaskBinding>;
+  data: Readonly<Record<string, unknown>>;
+}
+
+const fail = (): never => {
+  throw new PublicAgentError('PUBLIC_AGENT_INVALID_INPUT');
+};
+export function exactRecord(value: unknown, keys: readonly string[]): Record<string, unknown> {
+  if (!value || typeof value !== 'object' || Array.isArray(value)) return fail();
+  const prototype = Object.getPrototypeOf(value);
+  if (prototype !== Object.prototype && prototype !== null) return fail();
+  const result: Record<string, unknown> = Object.create(null);
+  for (const key of Reflect.ownKeys(value)) {
+    if (typeof key !== 'string' || !keys.includes(key)) return fail();
+    const descriptor = Object.getOwnPropertyDescriptor(value, key)!;
+    if (!('value' in descriptor)) return fail();
+    result[key] = descriptor.value;
+  }
+  if (keys.some((key) => !Object.hasOwn(result, key))) return fail();
+  return result;
+}
+function identifier(value: unknown, min: number, max: number): string {
+  if (
+    typeof value !== 'string' ||
+    value.length < min ||
+    value.length > max ||
+    !/^[A-Za-z0-9_-]+$/u.test(value)
+  )
+    return fail();
+  return value;
+}
+function inputText(value: unknown, max: number): string {
+  if (
+    typeof value !== 'string' ||
+    !value ||
+    value !== value.trim() ||
+    value.length > max ||
+    [...value].some((character) => character.charCodeAt(0) < 32 || character.charCodeAt(0) === 127)
+  )
+    return fail();
+  return value;
+}
+export function taskName(value: unknown): PublicTaskName {
+  if (value !== 'campus-service-entry' && value !== 'public-campus-navigation') return fail();
+  return value;
+}
+export function parseOperationLookup(value: unknown): {
+  task: PublicTaskName;
+  requestId: string;
+  schoolId: string;
+} {
+  const input = exactRecord(value, ['task', 'requestId', 'schoolId']);
+  return {
+    task: taskName(input.task),
+    requestId: identifier(input.requestId, 8, 100),
+    schoolId: identifier(input.schoolId, 2, 40),
+  };
+}
+
+/** Account-scoped recovery returns no former session payload or result. */
+export function parseRecoveryScope(value: unknown): { task: PublicTaskName; schoolId: string } {
+  const input = exactRecord(value, ['task', 'schoolId']);
+  return { task: taskName(input.task), schoolId: identifier(input.schoolId, 2, 40) };
+}
+export function parseRecoveryAcknowledgement(value: unknown) {
+  const input = exactRecord(value, ['task', 'schoolId', 'operationId', 'approved']);
+  if (
+    input.approved !== true ||
+    typeof input.operationId !== 'string' ||
+    !/^pago_[a-f0-9-]{36}$/u.test(input.operationId)
+  )
+    return fail();
+  return {
+    ...parseRecoveryScope({ task: input.task, schoolId: input.schoolId }),
+    operationId: input.operationId,
+    approved: true as const,
+  };
+}
+
+/** Two public, content-bound requests only. Suggestions never grant access to their destination. */
+export function parseConfirmedTask(value: unknown): ParsedPublicTask {
+  const envelope = exactRecord(value, ['task', 'data']);
+  const task = taskName(envelope.task);
+  const data = exactRecord(
+    envelope.data,
+    task === 'campus-service-entry'
+      ? ['schoolId', 'utterance', 'requestId', 'consent']
+      : ['task', 'phase', 'schoolId', 'query', 'requestId', 'consent'],
+  );
+  const schoolId = identifier(data.schoolId, 2, 40);
+  const requestId = identifier(data.requestId, 8, 100);
+  const rawConsent = data.consent;
+  const providerDescriptor =
+    rawConsent && typeof rawConsent === 'object' && !Array.isArray(rawConsent)
+      ? Object.getOwnPropertyDescriptor(rawConsent, 'provider')
+      : undefined;
+  const isGroqNavigation =
+    task === 'public-campus-navigation' &&
+    providerDescriptor &&
+    'value' in providerDescriptor &&
+    providerDescriptor.value === FREE_PROVIDER;
+  const consent = exactRecord(
+    rawConsent,
+    task === 'campus-service-entry'
+      ? ['model', 'provider', 'purpose', 'schoolId', 'utterance', 'version']
+      : isGroqNavigation
+        ? ['provider', 'model', 'version', 'schoolId', 'query', 'fingerprint']
+        : ['provider', 'version', 'schoolId', 'query', 'fingerprint'],
+  );
+  const provider =
+    consent.provider === DETERMINISTIC_PROVIDER && task === 'public-campus-navigation'
+      ? DETERMINISTIC_PROVIDER
+      : FREE_PROVIDER;
+  const model = provider === DETERMINISTIC_PROVIDER ? DETERMINISTIC_MODEL : FREE_MODEL;
+  if (
+    consent.provider !== provider ||
+    (provider === FREE_PROVIDER && consent.model !== FREE_MODEL) ||
+    consent.version !== 1 ||
+    consent.schoolId !== schoolId
+  )
+    return fail();
+  let text: string;
+  let fingerprint: string | null = null;
+  let clean: Record<string, unknown>;
+  if (task === 'campus-service-entry') {
+    text = inputText(data.utterance, 400);
+    if (consent.model !== FREE_MODEL || consent.purpose !== task || consent.utterance !== text)
+      return fail();
+    clean = {
+      schoolId,
+      utterance: text,
+      requestId,
+      consent: Object.freeze({
+        version: 1,
+        purpose: task,
+        provider,
+        model: FREE_MODEL,
+        schoolId,
+        utterance: text,
+      }),
+    };
+  } else {
+    text = inputText(data.query, 240);
+    if (
+      data.task !== task ||
+      data.phase !== 'execute' ||
+      consent.query !== text ||
+      typeof consent.fingerprint !== 'string' ||
+      !/^[a-f0-9]{64}$/u.test(consent.fingerprint)
+    )
+      return fail();
+    fingerprint = consent.fingerprint;
+    clean = {
+      task,
+      phase: 'execute',
+      schoolId,
+      query: text,
+      requestId,
+      consent: Object.freeze({
+        provider,
+        ...(provider === FREE_PROVIDER ? { model: FREE_MODEL } : {}),
+        version: 1,
+        schoolId,
+        query: text,
+        fingerprint,
+      }),
+    };
+  }
+  const payloadHash = createHash('sha256')
+    .update(JSON.stringify([task, schoolId, text, provider, model, 1, fingerprint]))
+    .digest('hex');
+  return Object.freeze({
+    binding: Object.freeze({
+      task,
+      requestId,
+      schoolId,
+      payloadHash,
+      provider,
+      model,
+    }),
+    data: Object.freeze(clean),
+  });
+}
diff --git a/apps/api/src/platform-public-agent/fastify-candidate.ts b/apps/api/src/platform-public-agent/fastify-candidate.ts
new file mode 100644
index 0000000..dd752d0
--- /dev/null
+++ b/apps/api/src/platform-public-agent/fastify-candidate.ts
@@ -0,0 +1,233 @@
+import { PublicAgentError, type PlatformTaskActor } from './contract';
+import {
+  PlatformPublicAgentLedger,
+  type PublicAgentDatabase,
+  type PublicAgentPolicy,
+} from './ledger';
+import { PlatformPublicTaskService } from './service';
+import type { PublicCatalogReader } from './navigation';
+import type { PlatformSessionResolver } from './admission';
+import type { FreeAssuranceAttempt } from './groq-server-transport';
+
+const prefix = '/v1/auth/platform/public-agent';
+const actions = [
+  'capability',
+  'preview',
+  'prepareGroq',
+  'confirm',
+  'execute',
+  'read',
+  'status',
+  'ack',
+  'route',
+  'reconcile',
+] as const;
+type Action = (typeof actions)[number];
+/** Minimal structural subset, modelled on the pinned API overlay. */
+type Request = {
+  url: string;
+  headers: {
+    authorization?: string | string[];
+    origin?: string | string[];
+    'sec-fetch-site'?: string | string[];
+    'content-type'?: string | string[];
+  };
+  body: unknown;
+  raw: {
+    aborted?: boolean;
+    once(name: 'aborted', listener: () => void): unknown;
+    removeListener(name: 'aborted', listener: () => void): unknown;
+  };
+};
+type Reply = {
+  header(name: string, value: string): unknown;
+  code(status: number): Reply;
+  send(body: unknown): unknown;
+  raw: {
+    writableEnded: boolean;
+    destroyed?: boolean;
+    once(name: 'close', listener: () => void): unknown;
+    removeListener(name: 'close', listener: () => void): unknown;
+  };
+};
+export type FastifyCandidate = {
+  post(
+    path: string,
+    options: { bodyLimit: number; config: { rateLimit: { max: number; timeWindow: string } } },
+    handler: (request: Request, reply: Reply) => Promise<unknown>,
+  ): unknown;
+};
+type Options = {
+  enabled?: boolean;
+  db: PublicAgentDatabase;
+  accounts: PlatformSessionResolver;
+  policy: PublicAgentPolicy;
+  /** Must be a trusted, server-owned public catalog capability; never pass browser input as rows. */
+  readPublicCatalog: PublicCatalogReader;
+  timeoutMs?: number;
+  /** Host must separately verify the selected organization is on its free tier. */
+  freeTierVerified?: boolean;
+  groqPlan?: (
+    input: { schoolId: string; query: string; fingerprint: string },
+    signal: AbortSignal,
+    beforeSend: (signal: AbortSignal) => Promise<void>,
+    attempt: FreeAssuranceAttempt,
+  ) => Promise<unknown>;
+};
+const validAction = (action: string): action is Action => actions.some((value) => value === action);
+/** For host authorization review only. This predicate is NOT wired into the API guard. */
+export function isPlatformPublicTaskRoute(method: string, path: string, enabled = false): boolean {
+  return (
+    enabled === true &&
+    method === 'POST' &&
+    path.startsWith(`${prefix}/`) &&
+    validAction(path.slice(prefix.length + 1))
+  );
+}
+/**
+ * Unregistered candidate: no env flag, DB migration, grant, cookie, provider or source is configured here.
+ * The host must separately bind the authenticated BFF, vetted reader and PG schema before considering activation.
+ */
+export function registerPlatformPublicTaskRoutes(app: FastifyCandidate, options: Options): void {
+  if (options.enabled !== true) return;
+  if (
+    typeof app?.post !== 'function' ||
+    typeof options.accounts?.resolveSession !== 'function' ||
+    typeof options.db?.transaction !== 'function' ||
+    typeof options.readPublicCatalog !== 'function'
+  )
+    throw new PublicAgentError('PUBLIC_AGENT_NOT_CONFIGURED', 503);
+  const ledger = new PlatformPublicAgentLedger(options.db, options.policy);
+  const service = new PlatformPublicTaskService({
+    accounts: options.accounts,
+    ledger,
+    readPublicCatalog: options.readPublicCatalog,
+    ...(options.timeoutMs === undefined ? {} : { timeoutMs: options.timeoutMs }),
+    ...(options.freeTierVerified === true && options.groqPlan
+      ? { groqPlan: options.groqPlan }
+      : {}),
+  });
+  const routeOptions = {
+    bodyLimit: 8192,
+    config: { rateLimit: { max: 30, timeWindow: '1 minute' } },
+  };
+  for (const action of actions) {
+    app.post(`${prefix}/${action}`, routeOptions, async (request, reply) => {
+      reply.header('Cache-Control', 'no-store');
+      reply.header('X-Content-Type-Options', 'nosniff');
+      const abort = new AbortController();
+      let rejectStop!: (error: PublicAgentError) => void;
+      const stopped = new Promise<never>((_, reject) => {
+        rejectStop = reject;
+      });
+      void stopped.catch(() => {});
+      const onAbort = () => {
+        abort.abort();
+        rejectStop(new PublicAgentError('PUBLIC_AGENT_TIMEOUT', 503));
+      };
+      const onClose = () => {
+        if (!reply.raw.writableEnded) onAbort();
+      };
+      const timer = setTimeout(onAbort, options.timeoutMs ?? 10_000);
+      request.raw.once('aborted', onAbort);
+      reply.raw.once('close', onClose);
+      if (request.raw.aborted || reply.raw.destroyed || reply.raw.writableEnded) onAbort();
+      let started = false;
+      try {
+        if (abort.signal.aborted) throw new PublicAgentError('PUBLIC_AGENT_CANCELLED', 503);
+        // The browser uses the same-origin BFF. A Platform bearer is server-owned and never in JSON or cookies here.
+        if (
+          request.url.includes('?') ||
+          request.headers.origin !== undefined ||
+          request.headers['sec-fetch-site'] !== undefined
+        )
+          throw new PublicAgentError('PUBLIC_AGENT_ORIGIN_DENIED', 403);
+        if (
+          request.headers['content-type']?.toString().split(';')[0]?.trim() !== 'application/json'
+        )
+          throw new PublicAgentError('PUBLIC_AGENT_INVALID_INPUT', 415);
+        const authorization = request.headers.authorization;
+        if (typeof authorization !== 'string')
+          throw new PublicAgentError('PUBLIC_AGENT_SESSION_INVALID', 401);
+        const value = await Promise.race([
+          (async () => {
+            const actor = verifiedActor(await options.accounts.resolveSession(authorization));
+            if (abort.signal.aborted) throw new PublicAgentError('PUBLIC_AGENT_TIMEOUT', 503);
+            started = true;
+            const result = await (action === 'reconcile'
+              ? service.reconcileNoDispatch(authorization, request.body, abort.signal)
+              : service[action](authorization, request.body, abort.signal));
+            if (abort.signal.aborted) throw new PublicAgentError('PUBLIC_AGENT_TIMEOUT', 503);
+            const current = verifiedActor(await options.accounts.resolveSession(authorization));
+            if (abort.signal.aborted) throw new PublicAgentError('PUBLIC_AGENT_TIMEOUT', 503);
+            if (!sameActor(actor, current))
+              throw new PublicAgentError('PUBLIC_AGENT_SESSION_INVALID', 401);
+            return result;
+          })(),
+          stopped,
+        ]);
+        return reply.send(value);
+      } catch (error) {
+        const known = error instanceof PublicAgentError ? error : null;
+        if (
+          started &&
+          (action === 'execute' ||
+            action === 'ack' ||
+            action === 'confirm' ||
+            action === 'reconcile') &&
+          (!known ||
+            [
+              'PUBLIC_AGENT_SESSION_INVALID',
+              'PUBLIC_AGENT_SESSION_CHECK_UNAVAILABLE',
+              'PUBLIC_AGENT_TIMEOUT',
+              'PUBLIC_AGENT_CANCELLED',
+            ].includes(known.code))
+        )
+          return reply.code(503).send({ code: 'PUBLIC_AGENT_OUTCOME_UNKNOWN' });
+        if (known) return reply.code(known.statusCode).send({ code: known.code });
+        const invalid =
+          error &&
+          typeof error === 'object' &&
+          'code' in error &&
+          error.code === 'PLATFORM_SESSION_INVALID';
+        return reply.code(invalid ? 401 : 503).send({
+          code: invalid ? 'PUBLIC_AGENT_SESSION_INVALID' : 'PUBLIC_AGENT_STATE_UNAVAILABLE',
+        });
+      } finally {
+        clearTimeout(timer);
+        request.raw.removeListener('aborted', onAbort);
+        reply.raw.removeListener('close', onClose);
+      }
+    });
+  }
+}
+function sameActor(
+  a: Omit<PlatformTaskActor, 'sessionHash'>,
+  b: Omit<PlatformTaskActor, 'sessionHash'>,
+): boolean {
+  return (
+    a.platformAccountId === b.platformAccountId &&
+    a.credentialId === b.credentialId &&
+    a.expiresAt === b.expiresAt
+  );
+}
+
+function verifiedActor(
+  value: Omit<PlatformTaskActor, 'sessionHash'>,
+): Omit<PlatformTaskActor, 'sessionHash'> {
+  if (
+    !value ||
+    typeof value.platformAccountId !== 'string' ||
+    !/^pa_[a-f0-9-]{36}$/u.test(value.platformAccountId) ||
+    typeof value.credentialId !== 'string' ||
+    !/^[A-Za-z0-9_-]{1,100}$/u.test(value.credentialId) ||
+    !Number.isSafeInteger(value.expiresAt) ||
+    value.expiresAt <= Date.now()
+  )
+    throw new PublicAgentError('PUBLIC_AGENT_SESSION_CHECK_UNAVAILABLE', 503);
+  return {
+    platformAccountId: value.platformAccountId,
+    credentialId: value.credentialId,
+    expiresAt: value.expiresAt,
+  };
+}
