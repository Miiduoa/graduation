# OS
.DS_Store

# LibreOffice（開啟 .xlsx 時產生的鎖檔，勿提交）
.~lock.*

# 編輯器 / 臨時 backup（避免 .bak / _tmp_* 進 repo）
*.bak
*.bak2
*.bak.*
_tmp_*

# Local agent / IDE tooling (do not commit)
.claude/
.cursor/
.playwright-cli/

