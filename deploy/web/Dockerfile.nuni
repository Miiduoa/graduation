FROM registry.fly.io/nuni-web@sha256:2be2cd9152f6214987eecd6e14c25cb4ea5897e2737517879c5134b39057650a AS legacy
FROM node:24.22.1-alpine@sha256:06d7adf3e0ef61a13f1d28682726366f97a15aa1888c934d3ecec86c33918b53 AS legacy_runtime
FROM node:22.23.4-alpine@sha256:fe4f6d74e20370acb04ad889077d14d0f64a9c8ea6a42bc60cddf1e844699914 AS base
RUN apk add --no-cache --upgrade 'ca-certificates>=20261020-r0' 'ca-certificates-bundle>=20261020-r0'
ENV NEXT_TELEMETRY_DISABLED=1

FROM base AS build
WORKDIR /build
RUN npm install --global pnpm@10.28.2 --ignore-scripts --no-audit --no-fund
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY patches ./patches
COPY apps/web/package.json ./apps/web/package.json
COPY packages/shared/package.json ./packages/shared/package.json
COPY vendor/xlsx-0.20.3.tgz ./vendor/xlsx-0.20.3.tgz
RUN pnpm install --frozen-lockfile --filter web... --ignore-scripts
COPY tsconfig.json ./
COPY apps/web/ ./apps/web/
COPY packages/shared/ ./packages/shared/
COPY scripts/import-ai/ ./scripts/import-ai/
COPY backend/functions/puScraper.js backend/functions/tronClassScraper.js ./backend/functions/
COPY backend/functions/lib/puGradeDocument.js backend/functions/lib/puCreditSummary.js backend/functions/lib/puCourseTime.js backend/functions/lib/taipeiDay.js backend/functions/lib/puSessionStore.js backend/functions/lib/puCampusTransport.js backend/functions/lib/ecampusFetchPause.js ./backend/functions/lib/
ARG NEXT_PUBLIC_FIREBASE_API_KEY
ARG NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN
ARG NEXT_PUBLIC_FIREBASE_PROJECT_ID
ARG NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET
ARG NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID
ARG NEXT_PUBLIC_FIREBASE_APP_ID
ARG NEXT_PUBLIC_SITE_URL=https://nuni.tw
ARG NEXT_PUBLIC_FUNCTIONS_BASE_URL
ENV NEXT_PUBLIC_FUNCTIONS_BASE_URL=$NEXT_PUBLIC_FUNCTIONS_BASE_URL
ENV NEXT_PUBLIC_CLOUD_FUNCTION_REGION=asia-east1
ENV NEXT_PUBLIC_DEFAULT_SCHOOL_ID=pu
ENV NEXT_PUBLIC_ALLOW_LOCAL_MOCK_AUTH=false
ENV NEXT_PUBLIC_ENABLE_UNIVERSAL_DEV_ACCOUNTS=false
ENV NEXT_PUBLIC_APP_ENV=production
ENV CAMPUS_LEGACY_ENABLED=true
ARG ASSIGNMENT_FILE_SUBMIT_ENABLED=false
ENV ASSIGNMENT_FILE_SUBMIT_ENABLED=$ASSIGNMENT_FILE_SUBMIT_ENABLED
RUN node -e "for(const name of ['API_KEY','AUTH_DOMAIN','PROJECT_ID','STORAGE_BUCKET','MESSAGING_SENDER_ID','APP_ID'])if(!process.env['NEXT_PUBLIC_FIREBASE_'+name])throw new Error('Missing public Firebase build setting: '+name)"
RUN pnpm --filter web build

FROM base AS runtime
ENV NODE_ENV=production
ENV PORT=3000
ENV HOSTNAME=0.0.0.0
ENV CAMPUS_LEGACY_ENABLED=true
ENV LEGACY_WEB_ROOT=/legacy/app/apps/web
ENV LEGACY_WEB_PORT=3001
ENV LEGACY_NODE_EXECUTABLE=/opt/legacy-node/bin/node
ARG CAMPUS_RELEASE_SHA
ENV CAMPUS_RELEASE_SHA=$CAMPUS_RELEASE_SHA
WORKDIR /app
COPY --from=legacy --chown=node:node /app/ /legacy/app/
COPY --from=legacy_runtime /usr/local/bin/node /opt/legacy-node/bin/node
COPY --from=build --chown=node:node /build/apps/web/.next/standalone/ ./
COPY --from=build --chown=node:node /build/apps/web/.next/static/ ./apps/web/.next/static/
COPY --from=build --chown=node:node /build/apps/web/public/ ./apps/web/public/
COPY --chown=node:node deploy/web/start.cjs ./deploy/web/start.cjs
RUN node -e "require('node:module').createRequire('/app/apps/web/server.js')('sharp')" && /opt/legacy-node/bin/node --version
USER node
EXPOSE 3000
HEALTHCHECK --interval=15s --timeout=5s --start-period=30s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:'+process.env.PORT+'/health/ready').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["node", "/app/deploy/web/start.cjs"]
