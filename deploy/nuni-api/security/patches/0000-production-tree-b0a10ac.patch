+    const logged = await service.login({ email: " FORMAL-ADMIN@EXAMPLE.TEST ", password });
+    expect(logged).toMatchObject({ platformAccountId: result.accountId, isPlatformOperator: true, created: false, expiresInSeconds: 3600 });
+    expect(logged.sessionHandle).toMatch(/^ps_[A-Za-z0-9_-]{43}$/u);
