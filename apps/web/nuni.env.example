# Server runtime configuration. Keep secrets in the existing host secret store.
# Adds the Nuni classroom without replacing Campus One pages or school login.
NUNI_CLASSROOM_ENABLED=true
NUNI_API_BASE_URL=https://api.nuni.tw
WEB_PUBLIC_ORIGIN=https://nuni.tw
BFF_SESSION_SECRET=
PLATFORM_GOOGLE_LOGIN_ENABLED=true
PLATFORM_GOOGLE_CLIENT_SECRET=
# 作業拍照／檔案繳交。未設或不是字面 true 就是關；正式環境不要開，除非本人說「上」。
# ASSIGNMENT_FILE_SUBMIT_ENABLED=true
# ASSIGNMENT_FILE_STORE_DIR=
# ASSIGNMENT_FILE_SIGNING_SECRET=
# 私人檔案：伺服器簽發私有 Supabase Storage URL。未完整設定時回 503。
# FILE_STORAGE_BACKEND=supabase
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_STORAGE_BUCKET=private-files
