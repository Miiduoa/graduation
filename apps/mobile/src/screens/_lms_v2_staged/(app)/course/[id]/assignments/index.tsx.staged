import { Link, useLocalSearchParams } from 'expo-router';
import { useCallback, useEffect, useState } from 'react';
import {
  Alert,
  FlatList,
  Pressable,
  RefreshControl,
  StyleSheet,
  Text,
  TextInput,
  View,
} from 'react-native';

import { useAuth } from '@/contexts/AuthContext';
import { useCourseRole } from '@/hooks/useCourseRole';
import { supabase } from '@/lib/supabase';

type Assignment = {
  id: string;
  title: string;
  due_at: string | null;
  max_points: number;
};

export default function AssignmentsListScreen() {
  const { id: courseId } = useLocalSearchParams<{ id: string }>();
  const { session } = useAuth();
  const role = useCourseRole(courseId, session?.user.id);
  const teacher = role === 'teacher';

  const [items, setItems] = useState<Assignment[]>([]);
  const [refreshing, setRefreshing] = useState(false);
  const [title, setTitle] = useState('');
  const [dueAt, setDueAt] = useState('');

  const load = useCallback(async () => {
    if (!courseId) return;
    const { data, error } = await supabase
      .from('assignments')
      .select('id, title, due_at, max_points')
      .eq('course_id', courseId)
      .order('created_at', { ascending: false });
    if (error) {
      console.warn(error.message);
      setItems([]);
      return;
    }
    setItems((data ?? []) as Assignment[]);
  }, [courseId]);

  useEffect(() => {
    load();
  }, [load]);

  async function onRefresh() {
    setRefreshing(true);
    await load();
    setRefreshing(false);
  }

  async function createAssignment() {
    const uid = session?.user.id;
    if (!courseId || !uid) return;
    const trimmed = title.trim();
    if (!trimmed) {
      Alert.alert('請輸入標題');
      return;
    }

    const payload: Record<string, unknown> = {
      course_id: courseId,
      title: trimmed,
      description: '',
      created_by: uid,
      max_points: 100,
    };

    const iso = dueAt.trim();
    if (iso) payload.due_at = new Date(iso).toISOString();

    const { error } = await supabase.from('assignments').insert(payload);
    if (error) {
      Alert.alert('建立失敗', error.message);
      return;
    }

    setTitle('');
    setDueAt('');
    await load();
  }

  return (
    <View style={styles.screen}>
      {teacher ? (
        <View style={styles.card}>
          <Text style={styles.cardTitle}>新增作業</Text>
          <TextInput placeholder="作業標題" style={styles.input} value={title} onChangeText={setTitle} />
          <TextInput
            placeholder="截止時間（ISO，選填），例如 2026-06-01T23:59:00+08:00"
            style={styles.input}
            value={dueAt}
            onChangeText={setDueAt}
          />
          <Pressable style={styles.primaryBtn} onPress={createAssignment}>
            <Text style={styles.primaryBtnText}>建立</Text>
          </Pressable>
        </View>
      ) : null}

      <FlatList
        data={items}
        keyExtractor={(item) => item.id}
        refreshControl={<RefreshControl refreshing={refreshing} onRefresh={onRefresh} />}
        ListEmptyComponent={<Text style={styles.empty}>尚無作業。</Text>}
        renderItem={({ item }) => (
          <Link href={`./assignments/${item.id}`} style={styles.row}>
            <Text style={styles.rowTitle}>{item.title}</Text>
            <Text style={styles.rowMeta}>
              配分：{item.max_points}
              {item.due_at ? `｜截止：${new Date(item.due_at).toLocaleString()}` : ''}
            </Text>
          </Link>
        )}
      />
    </View>
  );
}

const styles = StyleSheet.create({
  screen: { flex: 1, padding: 16 },
  card: {
    borderWidth: StyleSheet.hairlineWidth,
    borderColor: '#ddd',
    borderRadius: 12,
    padding: 14,
    gap: 10,
    marginBottom: 12,
  },
  cardTitle: { fontWeight: '700' },
  input: {
    borderWidth: StyleSheet.hairlineWidth,
    borderColor: '#ccc',
    borderRadius: 10,
    paddingHorizontal: 12,
    paddingVertical: 10,
  },
  primaryBtn: {
    alignSelf: 'flex-start',
    backgroundColor: '#2563eb',
    paddingHorizontal: 14,
    paddingVertical: 10,
    borderRadius: 10,
  },
  primaryBtnText: { color: '#fff', fontWeight: '700' },
  empty: { color: '#6b7280', marginTop: 18 },
  row: {
    paddingVertical: 14,
    borderBottomWidth: StyleSheet.hairlineWidth,
    borderBottomColor: '#eee',
    gap: 6,
  },
  rowTitle: { fontSize: 17, fontWeight: '700' },
  rowMeta: { color: '#6b7280', fontSize: 12 },
});
