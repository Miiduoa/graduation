{
  "name": "functions",
  "private": true,
  "main": "index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "serve": "node -e \"console.log('[functions] 已停用本機 firebase emulators:start --only functions。請改: firebase deploy --only functions（Blaze 專案）。說明: docs/firebase-blaze-production.md');\"",
    "shell": "firebase functions:shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "lint": "eslint .",
    "backfill:canonical": "node backfillCanonicalData.js",
    "build:shared": "node ../../scripts/build-functions-shared.cjs",
    "test": "pnpm run build:shared && jest"
  },
  "dependencies": {
    "firebase-admin": "13.10.0",
    "firebase-functions": "^6.0.0",
    "jose": "^6.2.3",
    "node-fetch": "^3.3.2",
    "saml2-js": "^4.0.2",
    "xml2js": "^0.6.2",
    "zod": "^3.25.76",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "eslint": "^9.39.2",
    "firebase-functions-test": "^3.2.0",
    "globals": "^17.4.0",
    "jest": "^29.7.0"
  },
  "overrides": {
    "proxy-addr": "2.0.8",
    "websocket-driver": "0.7.5",
    "@fastify/busboy": "3.2.2",
    "@grpc/grpc-js": "1.14.5",
    "@xmldom/xmldom": "0.8.15",
    "fast-xml-builder": "1.1.9",
    "form-data": "2.5.6",
    "protobufjs": "7.6.6",
    "xmlbuilder2": {
      "js-yaml": "3.15.2"
    }
  }
}
