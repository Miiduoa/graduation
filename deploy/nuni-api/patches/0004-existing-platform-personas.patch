+          [tenantId, createdPersonId, `P${suffix.slice(0, 20)}`, row.display_name, row.tenant_name],
+        );
+        // An unrelated pre-existing person must never be adopted or renamed.
+        if (!inserted.rows[0]) throw invalidPublicRealm();
+        await tx.query(
+          `INSERT INTO platform_tenant_personas (platform_account_id,tenant_id,person_id)
+           VALUES ($1,$2,$3) ON CONFLICT (platform_account_id,tenant_id) DO NOTHING`,
