{
  "name": "functions",
  "private": true,
  "main": "index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "serve": "node -e \"console.log('[functions] 已停用本機 firebase emulators:start --only functions。Spark 請改跑 Fly HTTP：node ../../deploy/functions-server/server.js（見 docs/deploy/functions-on-fly.md）。');\"",
    "serve:fly": "node ../../deploy/functions-server/server.js",
    "shell": "firebase functions:shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "lint": "eslint .",
    "sync:announcements": "node campusAnnouncements/cli.js",
    "sync:announcements:probe": "node campusAnnouncements/probe.js",
    "backfill:canonical": "node backfillCanonicalData.js",
    "build:shared": "node ../../scripts/build-functions-shared.cjs",
    "test": "pnpm run build:shared && ONLINE_ORDERING_ENABLED=true jest"
  },
  "dependencies": {
    "firebase-admin": "13.10.0",
    "firebase-functions": "^6.0.0",
    "jose": "^6.2.13",
    "node-fetch": "^3.3.2",
    "saml2-js": "^4.0.2",
    "xml2js": "^0.6.2",
    "zod": "^3.25.76",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "eslint": "^9.39.2",
    "firebase-functions-test": "^3.5.0",
    "globals": "^17.13.0",
    "jest": "^29.7.0"
  },
  "overrides": {
    "proxy-addr": "2.0.8",
    "websocket-driver": "0.7.5",
    "@fastify/busboy": "3.2.2",
    "@grpc/grpc-js": "1.14.5",
    "@xmldom/xmldom": "0.8.15",
    "fast-xml-builder": "1.1.9",
    "form-data": "2.5.6",
    "protobufjs": "7.6.6",
    "qs": "6.16.1",
    "flatted": "3.4.4",
    "body-parser": "1.20.9",
    "@tootallnate/once": "2.0.1",
    "js-yaml": "4.3.2",
    "brace-expansion": "1.1.21",
    "browserslist": "4.28.7",
    "xmlbuilder2": {
      "js-yaml": "3.15.2"
    }
  }
}
