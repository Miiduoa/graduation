+  /** Existing-order routes must survive a merchant pausing public discovery.
+   * Only reuse an active persisted persona; never create one here. FoodService
+   * still checks the tenant/person owner and each order's allowed transition.
+   */
+  async resolveExistingFoodOrderActor(actor: PlatformActor, tenantIdInput: string): Promise<AuthActor> {
+    const tenantId = tenantIdInput.trim();
+    if (!/^[a-z0-9][a-z0-9-]*[a-z0-9]$/u.test(tenantId)) throw invalidPublicRealm();
+    const personId = await this.db.transaction(async (tx) => {
+      const account = await tx.query<{ id: string }>(
+        `SELECT account.id FROM platform_accounts account
+         CROSS JOIN tenants tenant
+         WHERE account.id=$1 AND account.state='active'
+           AND tenant.id=$2 AND tenant.state IN ('provisioned','open')
+         FOR UPDATE OF account FOR SHARE OF tenant`,
+        [actor.platformAccountId, tenantId],
+      );
+      if (!account.rows[0]) throw invalidPublicRealm();
+      const persona = (await tx.query<{ person_id: string }>(
+        `SELECT persona.person_id FROM platform_tenant_personas persona
+         JOIN people person ON person.tenant_id=persona.tenant_id AND person.id=persona.person_id
+         WHERE persona.platform_account_id=$1 AND persona.tenant_id=$2
+           AND person.credential_status='active' FOR UPDATE OF persona,person`,
+        [actor.platformAccountId, tenantId],
+      )).rows[0];
+      if (!persona) throw invalidPublicRealm();
+      return persona.person_id;
+    });
+    return { tenantId, personId, roles: ["platform-user"], sessionKind: "platform-account", credentialId: actor.credentialId };
+  }
