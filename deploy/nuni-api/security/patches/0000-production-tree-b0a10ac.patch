diff --git a/apps/api/src/accounts/platform-password-provisioning.ts b/apps/api/src/accounts/platform-password-provisioning.ts
new file mode 100644
index 0000000..a454f4c
--- /dev/null
+++ b/apps/api/src/accounts/platform-password-provisioning.ts
@@ -0,0 +1,141 @@
+import { randomUUID } from "node:crypto";
+import type { CampusDatabase, SqlExecutor } from "../database";
+import { DomainError } from "../domain-error";
+import {
+  hashPlatformPassword,
+  lockPasswordLogin,
+  normalizePlatformPasswordEmail,
+  PLATFORM_PASSWORD_ISSUER,
+} from "./platform-password-service";
+
+export type PlatformPasswordProvisionInput = {
+  email: unknown;
+  password?: unknown;
+  displayName?: unknown;
+  reason: unknown;
+  performedBy: unknown;
+  expectedAccountId?: unknown;
+};
+
+type ProvisionAction = "create-account" | "add-credential" | "rotate-password";
+type OperatorGrant = "grant" | "restore" | "unchanged";
+export type PlatformPasswordProvisionResult = {
+  accountId: string | null;
+  status: "planned" | "applied";
+  action: ProvisionAction;
+  maskedEmail: string;
+  operatorGrant: OperatorGrant;
+};
+
+function refuse(code: string, message: string): never {
+  throw new DomainError(code, message, 409);
+}
+
+function boundedText(value: unknown, min: number, max: number): string | null {
+  if (typeof value !== "string") return null;
+  const text = value.trim();
+  return text.length >= min && text.length <= max && !/[\u0000-\u001f\u007f]/u.test(text) ? text : null;
+}
+
+function maskedEmail(email: string): string {
+  const at = email.indexOf("@");
+  return `${email.slice(0, 1)}***${email.slice(at)}`;
+}
+
+async function plan(tx: SqlExecutor, email: string, expectedAccountId?: unknown) {
+  const password = (await tx.query<{
+    credential_id: string; platform_account_id: string; state: string;
+  }>(`SELECT password.credential_id,password.platform_account_id,credential.state
+      FROM platform_password_credentials password
+      JOIN platform_account_credentials credential ON credential.id=password.credential_id
+      WHERE password.email=$1`, [email])).rows[0];
+  // Email is a lookup hint, never sufficient authority to merge credentials.
+  // Include unverified and inactive matches so neither creates a shadow account.
+  const matches = (await tx.query<{ id: string; state: string; verified: boolean }>(
+    `SELECT account.id,account.state,EXISTS (
+        SELECT 1 FROM platform_account_credentials credential
+        WHERE credential.platform_account_id=account.id AND credential.state='active'
+          AND credential.method IN ('google','apple') AND credential.email_verified
+          AND lower(btrim(credential.email_at_registration))=$1
+      ) AS verified
+      FROM platform_accounts account
+      WHERE lower(btrim(account.primary_email))=$1
+        OR EXISTS (SELECT 1 FROM platform_account_credentials credential
+          WHERE credential.platform_account_id=account.id
+            AND lower(btrim(credential.email_at_registration))=$1)
+        OR account.id=$2`, [email, password?.platform_account_id ?? null],
+  )).rows;
+  if (matches.length > 1) refuse("PLATFORM_PASSWORD_IDENTITY_AMBIGUOUS", "帳號的登入身分無法唯一確認，請先核對帳號。");
+  const existing = matches[0];
+  if (existing && existing.state !== "active") refuse("PLATFORM_PASSWORD_ACCOUNT_UNAVAILABLE", "這個帳號目前不能新增登入方式。");
+  if (existing && !password && !existing.verified) refuse("PLATFORM_PASSWORD_IDENTITY_UNVERIFIED", "既有帳號沒有可核對的已驗證信箱，未變更帳號。");
+  if (password?.state !== undefined && password.state !== "active") refuse("PLATFORM_PASSWORD_CREDENTIAL_UNAVAILABLE", "這個登入方式已撤銷，未變更帳號。");
+  if (expectedAccountId !== undefined && expectedAccountId !== existing?.id) refuse("PLATFORM_PASSWORD_TARGET_CHANGED", "帳號與檢查結果不同，請重新檢查。");
+  if (existing && !password) {
+    const otherPassword = (await tx.query(`SELECT 1 FROM platform_password_credentials WHERE platform_account_id=$1`, [existing.id])).rows;
+    if (otherPassword.length) refuse("PLATFORM_PASSWORD_IDENTITY_AMBIGUOUS", "帳號的登入身分無法唯一確認，請先核對帳號。");
+  }
+  const operator = existing ? (await tx.query<{ state: string }>(
+    `SELECT state FROM platform_operator_assignments WHERE platform_account_id=$1 AND role_key='platform-operator'`, [existing.id],
+  )).rows[0] : undefined;
+  return {
+    accountId: existing?.id ?? null,
+    credentialId: password?.credential_id ?? null,
+    action: (password ? "rotate-password" : existing ? "add-credential" : "create-account") as ProvisionAction,
+    operatorGrant: (operator?.state === "active" ? "unchanged" : operator ? "restore" : "grant") as OperatorGrant,
+  };
+}
+
+export async function provisionPlatformPasswordAdmin(
+  db: CampusDatabase,
+  input: PlatformPasswordProvisionInput,
+  options: { apply: boolean; rotatePassword?: boolean },
+): Promise<PlatformPasswordProvisionResult> {
+  const email = normalizePlatformPasswordEmail(input.email);
+  const reason = boundedText(input.reason, 5, 1000);
+  const performedBy = boundedText(input.performedBy, 3, 100);
+  const displayName = input.displayName === undefined ? "平台管理員" : boundedText(input.displayName, 1, 100);
+  if (!email || !reason || !performedBy || !displayName) {
+    throw new DomainError("PLATFORM_PASSWORD_PROVISION_INPUT_INVALID", "請提供有效信箱、顯示名稱、操作者與變更原因。", 400);
+  }
+  // Hash before entering the transaction. No password or hash enters audit/output.
+  const passwordHash = options.apply ? await hashPlatformPassword(input.password as string) : null;
+  return db.transaction(async (tx) => {
+    const key = options.apply ? await lockPasswordLogin(tx, email) : null;
+    let planned = await plan(tx, email, input.expectedAccountId);
+    if (!options.apply) return { accountId: planned.accountId, status: "planned", action: planned.action, maskedEmail: maskedEmail(email), operatorGrant: planned.operatorGrant };
+    if (planned.action === "rotate-password" && options.rotatePassword !== true) {
+      refuse("PLATFORM_PASSWORD_ROTATION_REQUIRED", "這個帳號已有密碼，請明確選擇更新密碼後再執行。");
+    }
+    if (planned.accountId) {
+      // Recheck identity after acquiring the same account lock used by closure.
+      await tx.query(`SELECT id FROM platform_accounts WHERE id=$1 FOR UPDATE`, [planned.accountId]);
+      planned = await plan(tx, email, planned.accountId);
+    }
+    const accountId = planned.accountId ?? `pa_${randomUUID()}`;
+    const credentialId = planned.credentialId ?? `pac_${randomUUID()}`;
+    if (!planned.accountId) {
+      await tx.query(`INSERT INTO platform_accounts (id,display_name,primary_email) VALUES ($1,$2,$3)`, [accountId, displayName, email]);
+    }
+    if (!planned.credentialId) {
+      await tx.query(`INSERT INTO platform_account_credentials
+          (id,platform_account_id,method,provider_issuer,provider_subject,email_at_registration,email_verified,verified_at,last_authenticated_at)
+        VALUES ($1,$2,'password',$3,$4,$4,false,clock_timestamp(),clock_timestamp())`,
+      [credentialId, accountId, PLATFORM_PASSWORD_ISSUER, email]);
+      await tx.query(`INSERT INTO platform_password_credentials (credential_id,platform_account_id,email,password_hash)
+        VALUES ($1,$2,$3,$4)`, [credentialId, accountId, email, passwordHash]);
+    } else {
+      await tx.query(`UPDATE platform_password_credentials SET password_hash=$2,updated_at=clock_timestamp() WHERE credential_id=$1`, [credentialId, passwordHash]);
+      await tx.query(`DELETE FROM platform_account_sessions WHERE credential_id=$1`, [credentialId]);
+    }
+    await tx.query(`INSERT INTO platform_operator_assignments (platform_account_id,role_key,state)
+      VALUES ($1,'platform-operator','active') ON CONFLICT (platform_account_id) DO UPDATE
+      SET state='active',revoked_at=NULL,updated_at=clock_timestamp()`, [accountId]);
+    await tx.query(`UPDATE platform_password_login_throttles SET failure_count=0,locked_until=NULL,
+      window_started_at=clock_timestamp(),updated_at=clock_timestamp() WHERE login_key=$1`, [key]);
+    await tx.query(`INSERT INTO platform_password_admin_audit
+      (id,platform_account_id,credential_id,action,operator_grant,performed_by,reason)
+      VALUES ($1,$2,$3,$4,$5,$6,$7)`, [`ppa_${randomUUID()}`, accountId, credentialId, planned.action, planned.operatorGrant, performedBy, reason]);
+    return { accountId, status: "applied", action: planned.action, maskedEmail: maskedEmail(email), operatorGrant: planned.operatorGrant };
+  });
+}
