# Generated CJS for Cloud Functions (built by `pnpm --filter @campus/shared run build:cjs`, see firebase.json predeploy)
packages/shared/dist-cjs/

# Python
__pycache__/
*.pyc
*.pyo
# Pillow-only campus game asset script (scripts/generate-campus-game-flux.py)
/.venv-game-assets/

