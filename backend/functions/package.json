    "jose": "^6.2.3",
    "node-fetch": "^3.3.2",
    "saml2-js": "^4.0.2",
    "xml2js": "^0.6.2",
    "zod": "^3.25.76",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "eslint": "^9.39.2",
    "firebase-functions-test": "^3.2.0",
    "globals": "^17.4.0",
    "jest": "^29.7.0"
  }
}
