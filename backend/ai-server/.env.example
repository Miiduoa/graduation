# ─── LLM Provider ─────────────────────────────────────────────
# 預設與 config.py 一致：groq（需 GROQ_API_KEY）。純本機無 Groq 時改 ollama。
# App Store builds must not depend on a user's local Ollama for production inference.
LLM_PROVIDER=groq

# ─── Ollama (local development) ──────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b

# ─── Together.ai (optional hosted provider) ─────────────────
# TOGETHER_API_KEY=your_together_api_key
# OPENAI_COMPAT_MODEL=Qwen/Qwen3-8B

# ─── Groq (recommended free-first hosted provider) ──────────
# GROQ_API_KEY=your_groq_api_key
# OPENAI_COMPAT_MODEL=qwen/qwen3-32b

# ─── Firebase Functions AI agent (server-side only) ───────
# Set these on Cloud Functions / Render, never in the mobile app.
ASSISTANT_MODEL_PROVIDERS=groq,gemini
# GROQ_API_KEY=your_groq_api_key
# GEMINI_API_KEY=your_gemini_api_key

# ─── Server ──────────────────────────────────────────────────
PORT=8100
# Local `python server.py` defaults to 127.0.0.1. Do not set 0.0.0.0 unless
# REQUIRE_FIREBASE_AUTH=true (Docker/Render already bind publicly under that contract).
# Explicit empty/whitespace --host= / UVICORN_HOST whitespace is unsupported (startup
# rejects); omit the flag/env for loopback. Truly empty UVICORN_HOST= is ignored like Click.
# AI_SERVER_HOST=127.0.0.1
ENABLE_RAG=true
ENABLE_WEB_SEARCH=true
# Research/local mode only. Keep false in preview/production.
ENABLE_SELF_TRAIN_LOOP=false

# Reflexion：僅非串流 /api/chat/sync 生效；首輪回答過短或忙碌话术時反思並重問 LLM 一次
ENABLE_REFLEXION=false

# ─── API security ───────────────────────────────────────
# Hosted preview/production should require Firebase ID tokens on user-facing APIs.
# Local Ollama may set false, but only with loopback bind — public bind is refused.
REQUIRE_FIREBASE_AUTH=true
AI_ALLOWED_ORIGINS=https://your-app.web.app,https://your-app.firebaseapp.com
AI_ADMIN_TOKEN=
