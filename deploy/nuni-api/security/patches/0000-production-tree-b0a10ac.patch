+    await db.query(`INSERT INTO platform_accounts (id,display_name,primary_email) VALUES ($1,'External account',$2)`, [accountId, email]);
+    await db.query(`INSERT INTO platform_account_credentials
+      (id,platform_account_id,method,provider_issuer,provider_subject,email_at_registration,email_verified,verified_at,last_authenticated_at)
+      VALUES ($1,$2,'google','https://accounts.google.com',$3,$4,$5,now(),now())`, [credentialId, accountId, randomUUID(), email, verified]);
+    return { accountId, credentialId };
+  }
+
+  async function failure(email: string, supplied = password) {
+    return service.login({ email, password: supplied }).then(() => null, (error: { code: string; statusCode: number; message: string }) => ({ code: error.code, status: error.statusCode, message: error.message }));
+  }
+  const invalid = { code: "PLATFORM_PASSWORD_LOGIN_INVALID", status: 401, message: "帳號或密碼不正確，請稍後再試。" };
