index 0000000..5a17513
--- /dev/null
+++ b/apps/api/src/platform-password-admin-cli.ts
@@ -0,0 +1,61 @@
+import { resolve } from "node:path";
+import { fileURLToPath } from "node:url";
+import { createDatabase } from "./database";
+import { readDatabaseRuntimeConfig } from "./database-runtime-config";
+import { DomainError } from "./domain-error";
+import { provisionPlatformPasswordAdmin, type PlatformPasswordProvisionInput } from "./accounts/platform-password-provisioning";
+
+export async function readProvisionInput(stream: AsyncIterable<Uint8Array | string>): Promise<PlatformPasswordProvisionInput> {
+  const chunks: Buffer[] = [];
+  let length = 0;
+  for await (const chunk of stream) {
+    const buffer = Buffer.from(chunk);
+    length += buffer.length;
+    if (length > 8192) throw new Error("INPUT_TOO_LARGE");
+    chunks.push(buffer);
+  }
+  const buffer = Buffer.concat(chunks);
+  try {
+    const value: unknown = JSON.parse(buffer.toString("utf8"));
+    if (!value || typeof value !== "object" || Array.isArray(value)) throw new Error("INVALID_INPUT");
+    const allowed = new Set(["email", "password", "displayName", "reason", "performedBy", "expectedAccountId"]);
+    if (Object.keys(value).some((key) => !allowed.has(key))) throw new Error("INVALID_INPUT");
+    return value as PlatformPasswordProvisionInput;
+  } finally {
+    buffer.fill(0);
+    for (const chunk of chunks) chunk.fill(0);
+  }
+}
+
+export async function main(args = process.argv.slice(2)): Promise<void> {
+  if (args.some((arg) => arg !== "--apply" && arg !== "--rotate-password")
+    || (args.includes("--rotate-password") && !args.includes("--apply")) || process.stdin.isTTY) {
+    throw new Error("Use stdin JSON; flags: --apply [--rotate-password]. No credentials in arguments.");
+  }
+  const input = await readProvisionInput(process.stdin);
+  const isProduction = process.env.NODE_ENV === "production";
+  const runtimeConfig = readDatabaseRuntimeConfig(process.env, { isProduction, component: "migrate", allowEmbedded: !isProduction });
+  const db = await createDatabase({
+    runtimeConfig,
+    schemaMode: "verify",
+    seedDemo: false,
+    attendanceCodeSecret: "password-provision-does-not-use-attendance",
+  });
+  try {
+    const result = await provisionPlatformPasswordAdmin(db, input, { apply: args.includes("--apply"), rotatePassword: args.includes("--rotate-password") });
+    process.stdout.write(`${JSON.stringify(result)}\n`);
+  } finally {
+    delete input.password;
+    await db.close();
+  }
+}
+
+if (process.argv[1] && resolve(process.argv[1]) === fileURLToPath(import.meta.url)) {
+  try {
+    await main();
+  } catch (error) {
+    // Driver/JSON error messages can contain supplied values; never print them.
+    process.stderr.write(`${error instanceof DomainError ? error.code : "PLATFORM_PASSWORD_PROVISION_FAILED"}\n`);
+    process.exitCode = 1;
+  }
+}
diff --git a/apps/api/src/public-cafeterias/cafeteriaCatalog.ts b/apps/api/src/public-cafeterias/cafeteriaCatalog.ts
new file mode 100644
