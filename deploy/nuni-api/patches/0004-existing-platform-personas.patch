+           AND person.credential_status='active' FOR UPDATE OF persona,person`,
+        [actor.platformAccountId, tenantId],
+      )).rows[0];
+      if (!stored) throw invalidPublicRealm();
+      if (createdPersonId && createdPersonId !== stored.person_id) {
+        await tx.query(`DELETE FROM people WHERE tenant_id=$1 AND id=$2`, [tenantId, createdPersonId]);
+      }
