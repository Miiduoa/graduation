# ─── LLM Provider ─────────────────────────────────────────────
# Local training/evaluation uses "ollama".
# App Store builds must not depend on a user's local Ollama. Production inference
# must run on backend infrastructure (Cloud Functions proxy or another server-side
# endpoint) with server-side keys only.
# Free-first production provider order lives in backend/functions/.env.example.
LLM_PROVIDER=ollama

# ─── Ollama (local development) ──────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b

# ─── Together.ai (optional hosted provider) ─────────────────
# TOGETHER_API_KEY=your_together_api_key
# OPENAI_COMPAT_MODEL=Qwen/Qwen3-8B

# ─── Groq (recommended free-first hosted provider) ──────────
# GROQ_API_KEY=your_groq_api_key
# OPENAI_COMPAT_MODEL=qwen/qwen3-32b

# ─── Firebase Functions AI agent (server-side only) ───────
# Set these on Cloud Functions / Render, never in the mobile app.
ASSISTANT_MODEL_PROVIDERS=groq,gemini
# GROQ_API_KEY=your_groq_api_key
# GEMINI_API_KEY=your_gemini_api_key

# ─── Server ──────────────────────────────────────────────────
PORT=8100
ENABLE_RAG=true
ENABLE_WEB_SEARCH=true
# Research/local mode only. Keep false in preview/production.
ENABLE_SELF_TRAIN_LOOP=false
